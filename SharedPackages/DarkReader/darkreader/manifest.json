{
    "manifest_version": 3,
    "name": "Dark Reader",
    "version": "4.9.121",
    "author": "Alexander Shutau",
    "description": "Dark mode for every website.",
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "darkreader-api.js",
                "content-script.js"
            ],
            "run_at": "document_end",
            "all_frames": true,
            "match_about_blank": true
        }
    ],
    "permissions": [
        "scripting"
    ],
    "host_permissions": [
        "*://*/*"
    ]
}

{
    "web_extension_cpm_network_process_recovery_applied": {
        "description": "Fires after restarting the embedded CPM background because its Network process PID changed. Measures application of the mitigation, not confirmed messaging recovery. Daily counts affected installations; count counts applications. No URL, process ID or extension identifier is sent.",
        "owners": ["mallexxx"],
        "triggers": ["feature_lifecycle"],
        "expires": "2027-01-15",
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },

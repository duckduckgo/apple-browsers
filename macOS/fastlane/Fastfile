  # Publishes the App Store entries of release_metadata.json from the live version's phased release state.
  #
  # @option [Boolean] is_critical (default: keep the existing value) Whether the release is critical
  # @option [Boolean] dry_run (default: false) Print the resulting file instead of uploading it
  #
  desc 'Publishes the App Store release metadata from the live version\'s phased release state'
  lane :upload_appstore_version_metadata do |options|
    dry_run = options[:dry_run] == true || options[:dry_run].to_s == 'true'
    is_critical = case options[:is_critical].to_s
                  when 'true' then true
                  when 'false' then false
                  when '', 'unchanged' then nil
                  else UI.user_error!("is_critical must be true, false or unchanged, not #{options[:is_critical]}")
                  end

    release = fetch_live_appstore_release(options)
    UI.message("App Store version: #{release[:version]} (#{release[:build_number]})")
    UI.message("Version state: #{release[:version_state]}")
    UI.message("Phased release: #{release[:phase_state] || 'none'}, started #{release[:phase_start_date] || 'n/a'}")
    UI.message("Is critical: #{is_critical.nil? ? 'unchanged' : is_critical}")

    # Apple can take up to a day to make a released version downloadable, so prompting for it now could
    # point users at an update the App Store doesn't serve yet.
    if release[:version_state] == Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::PROCESSING_FOR_DISTRIBUTION
      unless is_critical.nil?
        UI.user_error!("#{release[:version]} is still processing for distribution, so is_critical can't be set yet. " \
                       "Run this workflow again once App Store Connect shows it as Ready for Distribution.")
      end
      UI.important("#{release[:version]} is still processing for distribution: not updating release_metadata.json")
      next
    end

    s3_bucket = ENV['RELEASE_BUCKET_NAME']
    s3_prefix = ENV['RELEASE_BUCKET_PREFIX']
    unless s3_bucket && s3_prefix
      UI.user_error!("Missing required S3 configuration: RELEASE_BUCKET_NAME and RELEASE_BUCKET_PREFIX")
    end
    UI.user_error!("Missing required CDN configuration: CDN_PATH") unless ENV['CDN_PATH']
    s3_url = "s3://#{s3_bucket}/#{s3_prefix}/release_metadata.json"
    cdn_url = "#{ENV['CDN_PATH']}release_metadata.json"

    existing_content = read_release_metadata(s3_url)
    existing_metadata = existing_content ? JSON.parse(existing_content) : {}

    updated_metadata = begin
      AppStoreReleaseMetadata.update(
        existing_metadata,
        version: release[:version],
        build_number: release[:build_number],
        phase_state: release[:phase_state],
        phase_start_date: release[:phase_start_date],
        is_critical: is_critical,
        now: Time.now
      )
    rescue AppStoreReleaseMetadata::Error => e
      UI.user_error!(e.message)
    end

    updated_content = JSON.pretty_generate(updated_metadata)
    UI.message("Generated metadata:")
    UI.message(updated_content)

    if dry_run
      UI.important("Dry run: not uploading release_metadata.json")
    elsif updated_metadata == existing_metadata
      UI.success("✅ release_metadata.json is already up to date")
    else
      File.write('release_metadata.json', updated_content)
      sh("aws s3 cp release_metadata.json '#{s3_url}' --acl public-read")
      UI.success("✅ Successfully updated macOS release metadata")
      UI.message("📍 Available at: #{cdn_url}")
    end
  end


{
    "privacy-stats_database_load_failed": {
        "description": "Fired when the Privacy Stats store fails to load at launch. stage=initial is the first load attempt; stage=retry is the second attempt, after the store was recreated",
        "owners": ["hassaanelgarem"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            "errorCode",
            "errorDomain",
            "underlyingErrorCode",
            "underlyingErrorDomain",
            {
                "key": "stage",
                "description": "Which load attempt failed",
                "enum": ["initial", "retry"]
            }
        ]
    }
}

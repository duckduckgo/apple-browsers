// Privacy Pro AuthV2 diagnostic pixels
{
    "m_privacy-pro_auth_account_automatically_signed_out": {
        "description": "Fired after Privacy Pro automatically signs a user out because the backend reported an unknown account or an invalid refresh token that could not be recovered. Low-cardinality local state captured before deletion helps distinguish expected backend invalidation from client token races or inconsistent account state.",
        "owners": ["samsymons"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor", "daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "subscriptionAuthSource",
            "subscriptionAuthTokenCachePolicy",
            "errorDomain",
            "errorCode",
            "underlyingErrorDomain",
            "underlyingErrorCode",
            {
                "key": "recovery_outcome",
                "type": "string",
                "description": "Whether the App Store restore was not attempted or failed; not_applicable when recovery is not part of the sign-out path. The backup token restore is reported in backup_outcome",
                "enum": ["not_attempted", "failed", "not_applicable"]
            },
            {
                "key": "backup_outcome",
                "type": "string",
                "description": "Outcome of the backup token restore during the recovery: not_attempted when no backup restore ran; rejected when the backup can never restore the session; failed for a temporary or unknown failure; succeeded when the restore ran but left no usable token; not_applicable when recovery is not part of the sign-out path",
                "enum": ["not_attempted", "rejected", "failed", "succeeded", "not_applicable"]
            },
            {
                "key": "had_subscription_entitlements_before",
                "type": "string",
                "description": "Whether the locally stored access token contained subscription entitlements immediately before the token attempt",
                "enum": ["present", "absent", "unknown"]
            },
            {
                "key": "access_token_time_remaining_bucket_before",
                "type": "string",
                "description": "Bucketed time until the locally stored access token expired, captured immediately before the token attempt",
                "enum": ["expired", "less_than_1_hour", "1_hour_to_1_day", "1_to_3_days", "more_than_3_days", "unknown"]
            },
            {
                "key": "refresh_token_time_remaining_bucket_before",
                "type": "string",
                "description": "Bucketed time until the locally stored refresh token expired, captured immediately before the token attempt",
                "enum": ["expired", "less_than_1_hour", "1_hour_to_1_day", "1_to_3_days", "more_than_3_days", "unknown"]
            },
            {
                "key": "refresh_token_age_bucket_before",
                "type": "string",
                "description": "Bucketed age of the locally stored refresh token immediately before the token attempt; issued_in_future can indicate clock skew",
                "enum": ["issued_in_future", "less_than_1_hour", "1_hour_to_1_day", "1_to_3_days", "more_than_3_days", "unknown"]
            },
            {
                "key": "cached_subscription_status_before",
                "type": "string",
                "description": "Status of the subscription cached in the reporting process before sign-out; absence does not mean the backend subscription was inactive",
                "enum": ["auto_renewable", "not_auto_renewable", "grace_period", "inactive", "expired", "unknown", "unavailable"]
            },
            {
                "key": "cached_subscription_trial_status_before",
                "type": "string",
                "description": "Whether the subscription cached in the reporting process had an active free-trial offer before sign-out",
                "enum": ["active", "not_active", "unavailable"]
            },
            {
                "key": "cached_subscription_purchase_platform_before",
                "type": "string",
                "description": "Purchase platform of the subscription cached in the reporting process before sign-out",
                "enum": ["app_store", "play_store", "stripe", "unknown", "unavailable"]
            },
            {
                "key": "cached_subscription_time_remaining_bucket_before",
                "type": "string",
                "description": "Bucketed time until the cached subscription expiry or renewal date before sign-out; absence is reported per process",
                "enum": ["expired", "less_than_1_hour", "1_hour_to_1_day", "1_to_3_days", "more_than_3_days", "unknown", "unavailable"]
            },
            {
                "key": "stored_refresh_token_state_during_attempt",
                "type": "string",
                "description": "Whether the locally stored refresh token changed or disappeared between the pre-request snapshot and the failed request",
                "enum": ["unchanged", "changed", "missing", "read_error", "unavailable_before_attempt"]
            },
            {
                "key": "local_token_state_after_sign_out",
                "type": "string",
                "description": "Whether local authentication tokens were actually removed after the automatic sign-out completed",
                "enum": ["present", "missing", "read_error"]
            }
        ]
    },
    // Already shipped without a definition; recovery_method is new
    "m_privacy-pro_auth_invalid_refresh_token_recovered": {
        "description": "Fired when the main app recovers the session after the auth server rejected the refresh token, so the user stays signed in",
        "owners": ["federicocappelli"],
        "triggers": ["other"],
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "recovery_method",
                "type": "string",
                "description": "How the session was recovered: from the backup token or by the App Store restore",
                "enum": ["backup", "app_store"]
            }
        ]
    },
    // Backup token
    "subscription_auth-backup_restored": {
        "description": "Fired when the main app restores the subscription session from the backup token, so the user stays signed in",
        "owners": ["federicocappelli"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "trigger",
                "type": "string",
                "description": "What started the token recovery: invalid_token when the auth server rejected the current refresh token, missing_token when no current token is stored, account_creation when no current token is stored and an account is about to be created",
                "enum": ["invalid_token", "missing_token", "account_creation"]
            }
        ]
    },
    "subscription_auth-backup_restore_failed": {
        "description": "Fired when the main app tries to restore the subscription session from the backup token and the restore fails or is discarded. Not fired when no backup is stored or a restore is skipped after a recent failure",
        "owners": ["federicocappelli"],
        "triggers": ["exception"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "trigger",
                "type": "string",
                "description": "What started the token recovery: invalid_token when the auth server rejected the current refresh token, missing_token when no current token is stored, account_creation when no current token is stored and an account is about to be created",
                "enum": ["invalid_token", "missing_token", "account_creation"]
            },
            {
                "key": "reason",
                "type": "string",
                "description": "Why the restore didn't restore the session: the backup belongs to another account, was issued before the last sign-out, or has expired; the auth server rejected it; a temporary failure such as no connection, a server error or a backup that can't be read; the user signed out, signed in or switched account during the restore; or any other failure",
                "enum": ["account_mismatch", "predates_sign_out", "expired", "server_rejected", "temporary", "session_changed", "unknown"]
            },
            "errorDomain",
            "errorCode",
            "underlyingErrorDomain",
            "underlyingErrorCode"
        ]
    },
    "subscription_auth-backup_renewed": {
        "description": "Fired when the main app stores a new backup token after a token refresh, which happens when there is no usable backup or it is older than 14 days",
        "owners": ["federicocappelli"],
        "triggers": ["feature_lifecycle"],
        "parameters": ["appVersion", "pixelSource"],
        "suffixes": ["platform", "form_factor"]
    },
    "subscription_auth-backup_renewal_failed": {
        "description": "Fired when the main app fails to mint or store a new backup token after a token refresh",
        "owners": ["federicocappelli"],
        "triggers": ["exception"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": ["appVersion", "pixelSource", "errorDomain", "errorCode", "underlyingErrorDomain", "underlyingErrorCode"]
    },
    "subscription_auth-backup_keychain_error": {
        "description": "Fired when the main app can't read or write the backup token keychain item, or an expected backup token is missing",
        "owners": ["federicocappelli"],
        "triggers": ["exception"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "access_type",
                "type": "string",
                "description": "Whether reading or writing the backup token keychain item failed",
                "enum": ["getAuthToken", "storeAuthToken"]
            },
            "errorDomain",
            "errorCode",
            "underlyingErrorDomain",
            "underlyingErrorCode"
        ]
    }
}

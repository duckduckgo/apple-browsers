{
    m_debug_user_agent_os_version_inconsistency: {
        description: 'Fires when WebKit User Agent contains OS version value that was not expected.',
        owners: ['bwaresiak'],
        triggers: ['other'],
        suffixes: ['platform', 'form_factor', 'first_daily_count'],
        parameters: [
            'appVersion',
            {
                key: 'osVersion',
                description: 'Device OS version on which this issue has occured',
                type: 'string',
            },
            {
                key: 'webkitOsVersion',
                description: 'Webkit reported OS version',
                type: 'string',
            },
        ],
    },
}

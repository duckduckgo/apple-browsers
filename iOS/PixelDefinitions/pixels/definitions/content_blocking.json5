{
    "content-blocking_rules-compilation-timeout": {
        "description": "Fires when a main-frame navigation has waited 10 seconds in the foreground for the content blocking assets that rules compilation produces. Measures how often a compilation stall could block page loads indefinitely. With site permissions enabled, this includes SERP and content-blocking-off loads, which wait for the geolocation script shipped in the same assets. Background time does not count: the 10 seconds restart when the app returns to the foreground. At most once per navigation; not sent for subframes or for navigations stopped, replaced, closed or cleared before the 10 seconds pass. The navigation keeps waiting, or shows the timeout error page when site permissions is enabled.",
        "owners": ["bkunat"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    }
}

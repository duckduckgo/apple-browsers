{
    "m_aichat_report_metric_decode_error": {
        "description": "Fired when the Duck.ai frontend sends a reportMetric payload that native code cannot decode",
        "owners": ["aataraxiaa", "Bunn", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            "errorDomain",
            "errorCode",
            "underlyingErrorDomain",
            "underlyingErrorCode",
            {
                "key": "failureReason",
                "description": "The native decode failure category",
                "type": "string",
                "enum": ["key_not_found", "type_mismatch", "value_not_found", "data_corrupted", "unknown_decoding_error"]
            }
        ]
    },
    "aichat_report_metric_unknown": {
        "description": "Fired instead of m_aichat_report_metric_decode_error when the Duck.ai frontend sends a reportMetric payload whose metricName native code does not recognize",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "metricName",
                "description": "The unrecognized metric name the frontend sent",
                "type": "string",
                "enum": [
                    "userDidOpenHistory",
                    "userDidSubmitFirstPrompt",
                    "userDidSubmitPrompt",
                    "userDidCreateNewChat",
                    "userDidSelectFirstHistoryItem",
                    "userDidTapKeyboardReturnKey",
                    "userDidAcceptTermsAndConditions",
                    "userDidViewSuggestions",
                    "userDidSelectSuggestion",
                    "userDidViewAiSidebarUpgradeButton",
                    "userDidClickAiSidebarUpgradeButton",
                    "userDidViewActivateSubscriptionBanner",
                    "userDidClickActivateSubscriptionButton",
                    "userDidViewFreePlanBadge",
                    "userDidClickFreePlanUpgradeButton",
                    "userDidViewFreeLimitMessage",
                    "userDidClickFreeLimitSubscribeLink",
                    "userDidViewImageGenerationLimitMessage",
                    "userDidClickImageGenerationLimitSubscribeButton",
                    "userDidViewPlusLimitMessage",
                    "userDidClickPlusLimitUpgradeLink",
                    "userDidViewPromotionCard",
                    "userDidClickPromotionCardButton",
                    "userDidViewSettingsSubscribeButton",
                    "userDidClickSettingsSubscribeButton",
                    "userDidViewVoiceChatDurationLimitModal",
                    "userDidClickVoiceChatDurationLimitModalSubscribeButton",
                    "userDidViewVoiceChatLimitModal",
                    "userDidClickVoiceChatLimitModalSubscribeButton",
                    "userDidViewProUpgradeDisclaimerBanner",
                    "userDidClickProUpgradeDisclaimerBannerButton",
                    "userDidViewModelPickerUpgrade",
                    "userDidClickModelPickerUpgrade",
                    "userDidViewReasoningDropdownUpgrade",
                    "userDidClickReasoningDropdownUpgrade",
                    "userDidViewSwitchModelUpgrade",
                    "userDidClickSwitchModelUpgrade",
                    "userDidViewSettingsResubscribeButton",
                    "userDidClickSettingsResubscribeButton",
                    "userDidOpenSubscribeModal",
                    "userDidClickSubscribeOnSubscribeModal",
                    "userDidClickActivateOnSubscribeModal",
                    "userDidOpenUpgradeToProModal",
                    "userDidClickUpgradeOnUpgradeToProModal"
                ]
            }
        ]
    },
    "m_aichat_response_state_decode_error": {
        "description": "Fired when the Duck.ai frontend sends a response state payload that native code cannot decode",
        "owners": ["aataraxiaa", "Bunn", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            "errorDomain",
            "errorCode",
            "underlyingErrorDomain",
            "underlyingErrorCode",
            {
                "key": "failureReason",
                "description": "The native decode failure category",
                "type": "string",
                "enum": ["key_not_found", "type_mismatch", "value_not_found", "data_corrupted", "unknown_decoding_error"]
            }
        ]
    }
}

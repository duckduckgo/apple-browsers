// Onboarding step completion pixels for measuring progress through the initial onboarding flow.
{
    "m_mac_onboarding_step-complete-welcome": {
        "description": "Fired when the user completes the Welcome step of the onboarding flow",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_step-complete-get-started": {
        "description": "Fired when the user completes the Get Started step of the onboarding flow",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_step-complete-private-by-default": {
        "description": "Fired when the user completes the Private by Default (Make Default Browser) step of the onboarding flow",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_step-complete-cleaner-browsing": {
        "description": "Fired when the user completes the Cleaner Browsing (DuckPlayer) step of the onboarding flow",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_step-complete-system-settings": {
        "description": "Fired when the user completes the System Settings (Dock/Import) step of the onboarding flow",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_step-complete-customize": {
        "description": "Fired when the user completes the Customize step of the onboarding flow",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_final-step-complete": {
        "description": "Fired when the user completes the entire onboarding flow and clicks Start Browsing or Go to Settings",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_search_custom_u": {
        "description": "Fired when the user types into the address bar when the search suggestions dialog is shown during the contextual onboarding",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_visit_site_custom_u": {
        "description": "Fired when the user types into the address bar when the site suggestions dialog  is shown during the contextual onboarding",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_fire_button_try_it_pressed_u": {
        "description": "Fired when the “skip” button is clicked on the Fire Button dialog during the contextual onboarding",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_finished_u": {
        "description": "Fired when the final onboarding dialog is displayed during the contextual onboarding",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_fire_button_pressed_u": {
        "description": "Fired when the Fire button is clicked from the Fire Button dialog during the contextual onboarding",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_privacy_dashboard_opened_u": {
        "description": "Fired when the privacy dashboard is opened from the Trackers dialog during the contextual onboarding",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_second_site_visit_u": {
        "description": "Fired on didFinishLoading on Tab only if it's not a search; the OnboardingPixelProvider sends it only the second time",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_try_search_dialog_dismiss_button_tapped_u": {
        "description": "Fired when the try search dialog in the contextual onboarding is dismissed",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_search-result-dialog_dismiss-button-tapped_u": {
        "description": "Fired when the search result dialog in the contextual onboarding is dismissed",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_try_visit_site_dialog_dismiss_button_tapped_u": {
        "description": "Fired when the try visit site dialog in the contextual onboarding is dismissed",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_trackers_dialog_dismiss_button_tapped_u": {
        "description": "Fired when the trackers blocked dialog in the contextual onboarding is dismissed",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_fire_dialog_dismiss_button_tapped_u": {
        "description": "Fired when the try fire button dialog in the contextual onboarding is dismissed",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_onboarding_end_dialog_dismiss_button_tapped_u": {
        "description": "Fired when the final dialog in the contextual onboarding is dismissed",
        "owners": ["SabrinaTardio", "rachelmcr"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_debug_onboarding_chrome-extension-install_detection-failed": {
        "description": "Fired when onboarding Chrome extension eligibility detection fails to read Application Support.",
        "owners": ["rachelmcr"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "channel", "errorDomain", "errorCode", "underlyingErrorCode", "underlyingErrorDomain"]
    },
    "m_mac_debug_onboarding_chrome-extension-install_install-failed": {
        "description": "Fired when onboarding Chrome extension install fails to write Application Support.",
        "owners": ["rachelmcr"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "channel", "errorDomain", "errorCode", "underlyingErrorCode", "underlyingErrorDomain"]
    },
    "onboarding_thats-duckai_trigger_macos": {
        "description": "Fired on the contextual onboarding Duck.ai path when the wait for Duck.ai's first answer ends and the \"That's Duck.ai!\" dialog can show: either the answer arrived or it didn't arrive in time.",
        "owners": ["SabrinaTardio"],
        "triggers": ["feature_lifecycle", "scheduled"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "trigger",
                "type": "string",
                "description": "What ended the wait: Duck.ai's first answer, or the timeout",
                "enum": ["answer", "timeout"]
            }
        ]
    },
    "onboarding_duckai-chat_reopened_macos": {
        "description": "Fired when a window opens while the contextual onboarding Duck.ai path waits for Fire (for example after a relaunch), and the app reopens the onboarding chat with the user's prompt.",
        "owners": ["SabrinaTardio"],
        "triggers": ["feature_lifecycle"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "onboarding_duckai-path_search-fallback_macos": {
        "description": "Fired when a window opens while the contextual onboarding Duck.ai path waits for Fire, but Duck.ai is off or the prompt is gone, so onboarding continues on the search path instead.",
        "owners": ["SabrinaTardio"],
        "triggers": ["feature_lifecycle"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    }
}

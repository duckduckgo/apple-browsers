{
    "pir_assisted_opt_out_started_macos": {
        "description": "User begins an assisted opt-out from the introduction.",
        "owners": ["quanganhdo"],
        "triggers": ["user_interaction"],
        "parameters": ["appVersion", "channel"]
    },
    "pir_assisted_opt_out_user_turn_macos": {
        "description": "An assisted opt-out first hands control to the user.",
        "owners": ["quanganhdo"],
        "triggers": ["feature_lifecycle"],
        "parameters": [
            "appVersion",
            "channel",
            {
                "key": "duration_bucket",
                "type": "string",
                "enum": ["under_1s", "1_5s", "5_15s", "15_30s", "30_60s", "1_2m", "2_5m", "5_10m", "10m_or_more"],
                "description": "Time from beginning the attempt to the first user turn, bucketed."
            }
        ]
    },
    "pir_assisted_opt_out_ended_macos": {
        "description": "An assisted opt-out ends after runner teardown.",
        "owners": ["quanganhdo"],
        "triggers": ["feature_lifecycle"],
        "parameters": [
            "appVersion",
            "channel",
            {
                "key": "outcome",
                "type": "string",
                "enum": ["submitted", "cancelled", "timedOut", "failed"],
                "description": "The terminal outcome of the attempt."
            },
            {
                "key": "total_duration_bucket",
                "type": "string",
                "enum": ["under_1s", "1_5s", "5_15s", "15_30s", "30_60s", "1_2m", "2_5m", "5_10m", "10m_or_more"],
                "description": "Total attempt duration, bucketed."
            },
            {
                "key": "user_turn_duration_bucket",
                "type": "string",
                "enum": ["under_1s", "1_5s", "5_15s", "15_30s", "30_60s", "1_2m", "2_5m", "5_10m", "10m_or_more"],
                "description": "Cumulative duration spent in user turns, bucketed."
            }
        ]
    }
}

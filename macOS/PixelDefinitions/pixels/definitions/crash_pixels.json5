{
    "m_mac_crash": {
        "description": "Fired when a crash is detected in the main app bundle",
        "owners": ["ayoy", "mallexxx", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "first",
                "type": "boolean",
                "description": "Set to true if it's the first ever crash recorded for a given user"
            },
            {
                "key": "failedToReadCrashVersion",
                "description": "Set to true when the crash version could not be read from the crash report",
                "type": "boolean"
            },
            {
                "key": "code",
                "type": "string",
                "description": "MXDiagnostic exception code (App Store builds only); '-1' when unavailable"
            },
            {
                "key": "signal",
                "type": "string",
                "description": "MXDiagnostic POSIX signal number (App Store builds only); '-1' when unavailable"
            },
            {
                "key": "type",
                "type": "string",
                "description": "MXDiagnostic Mach exception type (App Store builds only); '-1' when unavailable"
            },
            {
                "key": "terminationReason",
                "type": "string",
                "description": "MXCrashDiagnostic termination reason reduced to '<namespace>_<code>', e.g. 'springboard_0x8badf00d', or to 'domain<domain>_<code>' for the RunningBoard format, e.g. 'domain10_0x8badf00d' (App Store builds only); '-1' when the crash has none, 'unknown' when it can't be parsed"
            },
            {
                "key": "watchdogEvent",
                "type": "string",
                "pattern": "^(-1|[a-z-]{1,32})$",
                "description": "The WatchdogEvent from a RunningBoard termination reason, e.g. 'scene-create' (App Store builds only); '-1' when the termination reason has none, 'unknown' when it isn't 1-32 lowercase letters and hyphens"
            },
            {
                "key": "watchdogLimit",
                "type": "string",
                "enum": ["wall", "cpu", "-1", "unknown"],
                "description": "Which watchdog allowance the app exhausted: 'wall' for real (wall clock) time, 'cpu' for CPU time (App Store builds only); '-1' when the termination reason has no allowance, 'unknown' for any other allowance"
            },
            {
                "key": "processVisibility",
                "type": "string",
                "pattern": "^(-1|[a-z]{1,32})$",
                "description": "The ProcessVisibility from a RunningBoard termination reason, e.g. 'background' (App Store builds only); '-1' when the termination reason has none, 'unknown' when it can't be parsed"
            },
            {
                "key": "watchdogVisibility",
                "type": "string",
                "pattern": "^(-1|[a-z]{1,32})$",
                "description": "The WatchdogVisibility from a RunningBoard termination reason, e.g. 'background' (App Store builds only); '-1' when the termination reason has none, 'unknown' when it can't be parsed"
            }
        ]
    },
    "m_mac_crash_dbp": {
        "description": "Fired when a crash is detected in the DBP background agent",
        "owners": ["ayoy", "mallexxx", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "failedToReadCrashVersion",
                "description": "Set to true when the crash version could not be read from the crash report",
                "type": "boolean"
            }
        ]
    },
    "m_mac_crash_vpnagent": {
        "description": "Fired when a crash is detected in the VPN agent",
        "owners": ["ayoy", "mallexxx", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "failedToReadCrashVersion",
                "description": "Set to true when the crash version could not be read from the crash report",
                "type": "boolean"
            }
        ]
    },
    "m_mac_crash_vpnextension": {
        "description": "Fired when a crash is detected in the VPN extension",
        "owners": ["ayoy", "mallexxx", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "failedToReadCrashVersion",
                "description": "Set to true when the crash version could not be read from the crash report",
                "type": "boolean"
            }
        ]
    },
    "m_mac_crash_unknown": {
        "description": "Fired when a crash is detected but the source bundle could not be identified",
        "owners": ["ayoy", "mallexxx", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "failedToReadCrashVersion",
                "description": "Set to true when the crash version could not be read from the crash report",
                "type": "boolean"
            }
        ]
    },
    "m_mac_crash_on_handlers_setup": {
        "description": "Fired when a crash is detected when setting up crash handlers",
        "owners": ["ayoy", "mallexxx"],
        "triggers": ["other"],
        "parameters": ["appVersion", "pixelSource"]
    },
    "m_mac_crashreporting_failed_to_read_crash_contents": {
        "description": "Fired when the crash reporter fails to read the contents of a crash report",
        "owners": ["ayoy", "mallexxx", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "pixelSource"]
    },
    "m_mac_crash-report_sent": {
        "description": "Fired when a crash report is successfully submitted (HTTP 200) to the crash reporting service. Counterpart to m_windows_crash-report_sent for cross-platform parity.",
        "owners": ["ayoy", "mallexxx", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    }
}

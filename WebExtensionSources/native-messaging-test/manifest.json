{
  "manifest_version": 3,
  "name": "Native Messaging Test",
  "description": "Debug extension that requests the nativeMessaging permission at runtime.",
  "version": "1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Native Messaging Test",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "optional_permissions": ["nativeMessaging", "tabs"]
}

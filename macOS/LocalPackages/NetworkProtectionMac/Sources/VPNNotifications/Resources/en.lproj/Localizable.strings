/* The body of the notification shown when the VPN stops reconnecting automatically because the subscription sign-in is missing */
"vpn.signed.out.notification.body" = "Open DuckDuckGo to restore VPN connection.";

/* The title of the notification shown when the VPN stops reconnecting automatically because the subscription sign-in is missing */
"vpn.signed.out.notification.title" = "DuckDuckGo VPN disconnected";

/* The subtitle of the notification reminding the user to turn the VPN Strict routing setting back on */
"vpn.strict.routing.reminder.notification.subtitle" = "Some traffic may bypass the VPN while off. Strict Routing is recommended for public networks.";

/* The title of the notification reminding the user to turn the VPN Strict routing setting back on */
"vpn.strict.routing.reminder.notification.title" = "Strict Routing is OFF";

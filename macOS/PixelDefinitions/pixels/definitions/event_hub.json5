    "webTelemetry_adwall_macos": {
        "description": "Fired once per detection of an adwall on a page. Fired immediately by the eventHub feature, without aggregation.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "parameters": ["appVersion"]
    },
    "webTelemetry_admiralAdwall_macos": {
        "description": "Fired once per detection of an Admiral-served adwall on a page. Fired immediately by the eventHub feature, without aggregation.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "parameters": ["appVersion"]
    },
    "webTelemetry_pageLoadTime_day_macos": {
        "description": "Daily bucketed counts of page loads detected as a slow page load, one parameter per load time bucket, for all loads and for reloads. The webDetection remote config sets the detection conditions. Fired by the eventHub feature at the end of each 1-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "parameters": [
            "appVersion",
            {
                "keyPattern": "^load[A-Za-z0-9_-]+$",
                "type": "string",
                "description": "Count of detected page loads in the period, per load time bucket. The key is `load` followed by the bucket name. The webDetection remote config sets the buckets in the key, and the eventHub remote config sets the count buckets in the value",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "keyPattern": "^slowReload[A-Za-z0-9_-]+$",
                "type": "string",
                "description": "Count of detected page loads in the period, per reload load time bucket. The key is `slowReload` followed by the bucket name. The webDetection remote config sets the buckets in the key, and the eventHub remote config sets the count buckets in the value",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            "eventHubAttributionPeriod"
        ]
    },
    "webTelemetry_errorPhraseCount_day_macos": {
        "description": "Daily bucketed counts of page loads detected as a page showing error text, one parameter per occurrence count bucket. The webDetection remote config sets the detection conditions. Fired by the eventHub feature at the end of each 1-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "parameters": [
            "appVersion",
            {
                "keyPattern": "^count[A-Za-z0-9_-]+$",
                "type": "string",
                "description": "Count of detected page loads in the period, per occurrence count bucket. The key is `count` followed by the bucket name. The webDetection remote config sets the buckets in the key, and the eventHub remote config sets the count buckets in the value",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            "eventHubAttributionPeriod"
        ]
    },
    "webTelemetry_soft404Features_day_macos": {
        "description": "Daily bucketed counts of page loads detected as an error page served as a successful response, one parameter per error term count bucket. The webDetection remote config sets the detection conditions. Fired by the eventHub feature at the end of each 1-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "parameters": [
            "appVersion",
            {
                "keyPattern": "^keywords[A-Za-z0-9_-]+$",
                "type": "string",
                "description": "Count of detected page loads in the period, per error term count bucket. The key is `keywords` followed by the bucket name. The webDetection remote config sets the buckets in the key, and the eventHub remote config sets the count buckets in the value",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            "eventHubAttributionPeriod"

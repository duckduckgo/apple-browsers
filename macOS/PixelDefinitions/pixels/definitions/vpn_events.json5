{
    "m_mac_netp_ev_adapter_end_temporary_shutdown_state_attempt_failure": {
        "description": "Fired when the VPN adapter fails to end its temporary shutdown state on the first attempt",
        "owners": ["samsymons"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count"],
        "parameters": ["appVersion", "pixelSource", "errorCode", "errorDomain", "underlyingErrorCode", "underlyingErrorDomain"]
    },
    "m_mac_netp_ev_adapter_end_temporary_shutdown_state_recovery_success": {
        "description": "Fired when the VPN adapter successfully recovers and ends its temporary shutdown state after an initial failure",
        "owners": ["samsymons"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count"],
        "parameters": ["appVersion", "pixelSource", "errorCode", "errorDomain", "underlyingErrorCode", "underlyingErrorDomain"]
    },
    "m_mac_netp_ev_adapter_end_temporary_shutdown_state_recovery_failure": {
        "description": "Fired when the VPN adapter fails to recover and end its temporary shutdown state after an initial failure",
        "owners": ["samsymons"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count"],
        "parameters": ["appVersion", "pixelSource", "errorCode", "errorDomain", "underlyingErrorCode", "underlyingErrorDomain"]
    },
    "m_mac_netp_ev_enable_attempt": {
        "description": "Fired at the start of a VPN connection attempt",
        "owners": ["diegoreymendez", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["legacy_daily_count"],
        "parameters": ["appVersion", "pixelSource", "connectionAttemptSource", "channel"]
    },
    "m_mac_netp_ev_enable_attempt_success": {
        "description": "Fired when a VPN connection attempt succeeds",
        "owners": ["diegoreymendez", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["legacy_daily_count"],
        "parameters": ["appVersion", "pixelSource", "connectionAttemptSource", "channel"]
    },
    "m_mac_netp_ev_enable_attempt_failure": {
        "description": "Fired when a VPN connection attempt fails",
        "owners": ["diegoreymendez", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["legacy_daily_count"],
        "parameters": ["appVersion", "pixelSource", "connectionAttemptSource", "channel"]
    },
    "m_mac_netp_tunnel_start_attempt_on_demand_without_access_token": {
        "description": "Fired when an on-demand VPN start attempt fails before reaching the actual tunnel start, due to a prerequisite failure such as a missing or unfetchable subscription token, missing settings, or other startup errors. Error parameters identify the underlying cause.",
        "owners": ["diegoreymendez", "samsymons"],
        "triggers": ["other"],
        "suffixes": ["legacy_daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel", "errorCode", "errorDomain", "underlyingErrorCode", "underlyingErrorDomain"]
    },
    // Defined in https://app.asana.com/1/137249556945/project/72649045549333/task/1211597559231997
    "m_mac_wide_vpn_connection": {
        "description": "Wide pixel sent at the end of a vpn connection flow",
        "owners": ["hanyutang-sandra"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": [
            "appVersion",
            "wideEventAppName",
            "wideEventAppVersion",
            "wideEventPlatform",
            "wideEventType",
            "wideEventSampleRate",
            "wideEventIsFirstDailyOccurrence",
            "wideEventFeatureStatus",
            "wideEventErrorDomain",
            "wideEventErrorCode",
            "wideEventUnderlyingErrorDomain",
            "wideEventUnderlyingErrorCode",
            "wideEventMetaVersion",
            {
                "key": "feature.data.ext.error.error_description",
                "type": "string",
                "description": "Description of the failure when the VPN connection flow ends in error. Mix of stable case-name tokens and human-readable messages, depending on which error type surfaced.",
                "examples": [
                    "noAuthToken",
                    "cancelled",
                    "connectionStatusInvalid",
                    "simulateControllerFailureError",
                    "startTunnelFailure",
                    "failedToFetchAuthToken",
                    "notAuthorizedToEnableLoginItem",
                    "enableLoginItemError",
                    "ipcControlError",
                    "VPN settings are missing or invalid",
                    "VPN disconnected due to expired subscription",
                    "Abnormal situation caused the token to be reset"
                ]
            },
            {
                "key": "meta.type",
                "type": "string",
                "description": "Wide event type identifier",
                "enum": ["macos-vpn-connection"]
            },
            {
                "key": "feature.name",
                "type": "string",
                "description": "Feature identifier for this wide pixel",
                "enum": ["vpn-connection"]
            },
            {
                "key": "feature.data.ext.status_reason",
                "type": "string",
                "description": "Reason string for the current status",
                "enum": ["partial_data", "timeout", "retried"]
            },
            {
                "key": "feature.data.ext.extension_type",
                "type": "string",
                "description": "VPN extension type used",
                "enum": ["app", "system", "unknown"]
            },
            {
                "key": "feature.data.ext.startup_method",
                "type": "string",
                "description": "How the VPN setup or connection was initiated",
                "enum": ["automatic_on_demand", "manual_by_main_app", "manual_by_the_system"]
            },
            // As of MacOS 1.168.0, `is_setup` uses the normalized values "yes", "no", and "unknown".
            // Previous versions may still report legacy values ("true", "false").
            {
                "key": "feature.data.ext.is_setup",
                "type": "string",
                "description": "Is the current flow setup or reconnection",
                "enum": ["yes", "no", "unknown"]
            },
            {
                "key": "feature.data.ext.vpn_screen_source",
                "type": "string",
                "description": "The app surface that opened the VPN screen before the connection attempt. Not populated on macOS (captured on iOS only).",
                "enum": [
                    "subscription_settings",
                    "subscription_email",
                    "subscription_flow",
                    "browser_menu",
                    "toolbar",
                    "address_bar",
                    "widget",
                    "shortcut",
                    "notification"
                ]
            },
            {
                "key": "feature.data.ext.vpn_screen_entry_token_state",
                "type": "string",
                "description": "Whether a local Privacy Pro token container was present at connect time. Not populated on macOS (captured on iOS only).",
                "enum": ["present", "missing", "read_error"]
            },
            {
                "key": "feature.data.ext.onboarding_status",
                "type": "string",
                "description": "The current onboarding status, if applicable",
                "enum": ["needs_to_allow_extension", "needs_to_allow_vpn_configuration", "unknown", "completed"]
            },
            // Overall latency
            {
                "key": "feature.data.ext.latency_ms",
                "type": "integer",
                "description": "Overall VPN connection latency (in ms)"
            },
            // Per-step latencies
            {
                "keyPattern": "^feature\\.data\\.ext\\.(browser_start|controller_start|oauth|tunnel_start)_latency_ms$",
                "type": "integer",
                "description": "Latency for VPN connection steps (in ms)"
            },
            // Per-step error domains
            {
                "keyPattern": "^feature\\.data\\.ext\\.(browser_start|controller_start|oauth|tunnel_start)_error\\.domain$",
                "type": "string",
                "description": "Error domain for VPN connection step failures"
            },
            // Per-step error codes
            {
                "keyPattern": "^feature\\.data\\.ext\\.(browser_start|controller_start|oauth|tunnel_start)_error\\.code$",
                "type": "integer",
                "description": "Error code for VPN connection step failures"
            },
            // Per-step error descriptions
            {
                "keyPattern": "^feature\\.data\\.ext\\.(browser_start|controller_start|oauth|tunnel_start)_error\\.description$",
                "type": "string",
                "description": "Human-readable error description for VPN connection step failures",
                "examples": ["simulateControllerFailureError", "loadFromPreferencesFailed"]
            },
            // Per-step underlying error domains
            {
                "keyPattern": "^feature\\.data\\.ext\\.(browser_start|controller_start|oauth|tunnel_start)_error\\.underlying_domain[0-9]?$",
                "type": "string",
                "description": "Underlying error domain for VPN connection step failures"
            },
            // Per-step underlying error codes
            {
                "keyPattern": "^feature\\.data\\.ext\\.(browser_start|controller_start|oauth|tunnel_start)_error\\.underlying_code[0-9]?$",
                "type": "integer",
                "description": "Underlying error code for VPN connection step failures"
            },
            {
                "key": "context.name",
                "type": "string",
                "description": "Context name for the flow",
                "enum": ["funnel_appsettings_macos", "funnel_agent_macos", "funnel_systemsettings_multiple", "funnel_others_multiple"]
            },
            "channel"
        ]
    },
    "m_mac_wide_vpn_ip_leak_check": {
        "description": "Wide pixel sent at the end of each VPN IP leak check cycle (HTTP/HTTPS/STUN probes over IPv4 and IPv6 against the leak check endpoint, classified against the current tunnel egress IP)",
        "owners": ["samsymons"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": [
            "appVersion",
            "wideEventAppName",
            "wideEventAppVersion",
            "wideEventPlatform",
            "wideEventType",
            "wideEventSampleRate",
            "wideEventIsFirstDailyOccurrence",
            "wideEventFeatureStatus",
            "wideEventErrorDomain",
            "wideEventErrorCode",
            "wideEventUnderlyingErrorDomain",
            "wideEventUnderlyingErrorCode",
            "wideEventMetaVersion",
            {
                "key": "meta.type",
                "type": "string",
                "description": "Wide event type identifier",
                "enum": ["macos-vpn-ip-leak-check"]
            },
            {
                "key": "feature.name",
                "type": "string",
                "description": "Feature identifier for this wide pixel",
                "enum": ["vpn-ip-leak-check"]
            },
            {
                "key": "feature.data.ext.trigger",
                "type": "string",
                "description": "What caused the leak check cycle to run",
                "enum": ["tunnel_start", "reassert", "periodic", "rekey"]
            },
            {
                "key": "feature.data.ext.status_reason",
                "type": "string",
                "description": "Reason attached to an UNKNOWN status: one or more probes errored without a leak; the cycle did not complete; or the tunnel interface resolved to a non-tunnel interface and the check was skipped",
                "enum": ["checks_errored", "check_interrupted", "unexpected_tunnel_interface"]
            },
            {
                "key": "feature.data.ext.latency_ms_bucketed",
                "type": "integer",
                "description": "Total cycle duration, rounded up to the nearest 500 ms and capped at 5000",
                "enum": [500, 1000, 1500, 2000, 2500, 3000, 3500, 4000, 4500, 5000]
            },
            {
                "key": "feature.data.ext.egress_server_name",
                "type": "string",
                "description": "Name of the VPN egress server the cycle ran against",
                "examples": ["yvr2-netp-prod-egress2"]
            },
            {
                "key": "feature.data.ext.os_version",
                "type": "string",
                "description": "Operating system major/minor version at the time of the leak check, for example 13.7 or 26.4"
            },
            {
                "keyPattern": "^feature\\.data\\.ext\\.ipv(4|6)\\.leak_ip_type$",
                "type": "string",
                "description": "Classification of the leaked IP, present when any probe of that IP family reported a leak",
                "enum": ["public", "private", "unknown"]
            },
            {
                "keyPattern": "^feature\\.data\\.ext\\.ipv(4|6)\\.(http|https|stun)\\.status$",
                "type": "string",
                "description": "Per-probe outcome for the IP family × probe combination",
                "enum": ["success", "leak", "error"]
            },
            {
                "keyPattern": "^feature\\.data\\.ext\\.ipv(4|6)\\.(http|https|stun)\\.(error_domain|underlying_domain)$",
                "type": "string",
                "description": "Error domain associated with a per-probe error (outer or underlying)",
                "examples": ["NWErrorDomain", "NSURLErrorDomain", "LeakCheckHTTPResponseParser.ParseError"]
            },
            {
                "keyPattern": "^feature\\.data\\.ext\\.ipv(4|6)\\.(http|https|stun)\\.(error_code|underlying_code)$",
                "type": "integer",
                "description": "Error code associated with a per-probe error (outer or underlying)"
            },
            {
                "keyPattern": "^feature\\.data\\.ext\\.ipv4\\.(http|https|stun)\\.leak_octet[1-4]_matched$",
                "type": "boolean",
                "description": "Whether the corresponding octet of the observed IPv4 address matched the egress IP, present only when a probe reported a leak"
            }
        ]
    },
    "m_mac_vpn_proxy_orphaned": {
        "description": "Fired once per episode when the transparent proxy detects it is orphaned: it has been running past the age threshold while the tunnel's heartbeat is missing or stale, indicating the tunnel is gone",
        "owners": ["diegoreymendez"],
        "triggers": ["other"],
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "heartbeat_age",
                "type": "string",
                "description": "Bucketed age of the tunnel's last heartbeat at detection time, or 'missing' if no heartbeat was ever recorded",
                "enum": ["missing", "under_5m", "under_30m", "over_30m"]
            },
            {
                "key": "proxy_age",
                "type": "string",
                "description": "Bucketed time the proxy had been running at detection time",
                "enum": ["under_5m", "under_30m", "under_2h", "over_2h"]
            }
        ]
    },
    "m_mac_wide_vpn_session_health": {
        "description": "Wide pixel sent once per VPN runtime segment, measuring whether an already-running VPN stayed healthy, including tunnels that stayed connected but stopped routing traffic",
        "owners": ["jleandroperez"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": [
            "appVersion",
            "wideEventAppName",
            "wideEventAppVersion",
            "wideEventPlatform",
            "wideEventType",
            "wideEventSampleRate",
            "wideEventIsFirstDailyOccurrence",
            "wideEventFeatureStatus",
            "wideEventMetaVersion",
            {
                "key": "meta.type",
                "type": "string",
                "description": "Wide event type identifier",
                "enum": ["macos-vpn-session-health"]
            },
            {
                "key": "feature.name",
                "type": "string",
                "description": "Feature identifier for this wide pixel",
                "enum": ["vpn-session-health"]
            },
            {
                "key": "feature.data.ext.segment_start_reason",
                "type": "string",
                "description": "Why the segment began. One connection can produce several segments, because a segment is closed and reopened every 24 eligible hours.",
                "enum": ["physical_tunnel_manual_start", "physical_tunnel_on_demand_start", "rollover_after_24h"]
            },
            {
                "key": "feature.data.ext.segment_end_reason",
                "type": "string",
                "description": "Why the segment ended. Exactly one applies. `stopped_by_user` covers every VPN-off surface; `stopped_administratively` covers app and OS housekeeping; `process_died` is recovered on the next launch.",
                "enum": [
                    "stopped_by_user",
                    "stopped_by_failure",
                    "stopped_administratively",
                    "stopped_without_network",
                    "cancelled_with_error",
                    "rolled_over",
                    "process_died"
                ]
            },
            {
                "key": "feature.data.ext.failure_reason",
                "type": "string",
                "description": "The reason a segment FAILED. Absent on SUCCESS and UNKNOWN, which use status_reason. `routing_outage` = the tester crossed its extended failure threshold (8 consecutive failures); `stale_handshake` = no WireGuard handshake for over 5 minutes.",
                "enum": [
                    "routing_outage",
                    "routing_outage_at_user_disable",
                    "stale_handshake",
                    "failure_recovery_failed",
                    "stopped_with_failure",
                    "cancelled_with_error"
                ]
            },
            {
                "key": "feature.data.ext.status_reason",
                "type": "string",
                "description": "The activity that failed to produce a judgement, for a segment that ended UNKNOWN. `monitors_never_started` = the monitors this measurement needs never came up; `connection_tester_never_reported` = they came up but the segment ended before the first result.",
                "enum": [
                    "monitors_never_started",
                    "connection_tester_never_reported",
                    "extension_process_died",
                    "os_stopped_without_network"
                ]
            },
            {
                "key": "feature.data.ext.monitoring_coverage",
                "type": "string",
                "description": "How much of the segment was observed. Publish beside the SLI: rising `partial` or `none` means a degrading denominator, not better reliability.",
                "enum": ["full", "partial", "none"]
            },
            {
                "key": "feature.data.ext.segment_duration_seconds_bucketed",
                "type": "string",
                "description": "Wall-clock length of the segment, bucketed (lower end of bucket, in seconds). Includes paused periods.",
                "enum": ["0", "60", "300", "1800", "7200", "28800", "86400"]
            },
            {
                "key": "feature.data.ext.eligible_duration_seconds_bucketed",
                "type": "string",
                "description": "Wall clock minus sleep, snooze and other intentional unavailability, bucketed (lower end of bucket, in seconds). What the 24 hour rollover measures.",
                "enum": ["0", "60", "300", "1800", "7200", "28800", "86400"]
            },
            {
                "key": "feature.data.ext.time_to_first_error_seconds_bucketed",
                "type": "string",
                "description": "Time from segment start to the first error of any kind, bucketed (lower end of bucket, in seconds). Absent when there were none.",
                "enum": ["0", "60", "300", "1800", "7200", "28800", "86400"]
            },
            {
                "key": "feature.data.ext.connection_tester_outage_count_bucketed",
                "type": "string",
                "description": "How many distinct connection-tester outages occurred, bucketed (lower end of bucket).",
                "enum": ["0", "1", "2", "4", "9"]
            },
            {
                "key": "feature.data.ext.connection_tester_outage_total_seconds_bucketed",
                "type": "string",
                "description": "Summed duration of all connection-tester outages, bucketed (lower end of bucket, in seconds). The `0` bucket also covers a total under one second.",
                "enum": ["0", "1", "15", "60", "300", "1800"]
            },
            {
                "key": "feature.data.ext.connection_tester_outage_max_seconds_bucketed",
                "type": "string",
                "description": "Longest single connection-tester outage, bucketed (lower end of bucket, in seconds). The `0` bucket also covers an outage under one second.",
                "enum": ["0", "1", "15", "60", "300", "1800"]
            },
            {
                "key": "feature.data.ext.extension_type",
                "type": "string",
                "description": "Which network extension served the segment.",
                "enum": ["app", "system", "unknown"]
            },
            {
                "key": "feature.data.ext.connection_tester_failure_seen",
                "type": "boolean",
                "description": "Whether any connection-tester failure occurred, including one that recovered."
            },
            {
                "key": "feature.data.ext.connection_tester_extended_failure_seen",
                "type": "boolean",
                "description": "Whether a tester outage crossed the extended failure threshold. The primary routing_outage input."
            },
            {
                "key": "feature.data.ext.connection_tester_failure_active_at_end",
                "type": "boolean",
                "description": "Whether a tester failure was still active when the segment ended."
            },
            {
                "key": "feature.data.ext.stale_handshake_seen",
                "type": "boolean",
                "description": "Whether the stale-handshake monitor reported a failure."
            },
            {
                "key": "feature.data.ext.stale_handshake_recovered",
                "type": "boolean",
                "description": "Whether a reported stale handshake later recovered. Present only when stale_handshake_seen."
            },
            {
                "key": "feature.data.ext.failure_recovery_attempted",
                "type": "boolean",
                "description": "Whether server failure recovery was attempted."
            },
            {
                "key": "feature.data.ext.failure_recovery_succeeded",
                "type": "boolean",
                "description": "Whether that recovery succeeded. Present only when a recovery finished."
            },
            {
                "key": "feature.data.ext.human_stop_with_active_failure",
                "type": "boolean",
                "description": "Whether a deliberate user disable coincided with an active routing failure. The headline diagnostic for silently broken tunnels."
            },
            {
                "key": "feature.data.ext.ip_leak_detected",
                "type": "boolean",
                "description": "Whether an IP leak was confirmed during the segment. Diagnostic only."
            }
        ]
    }
}

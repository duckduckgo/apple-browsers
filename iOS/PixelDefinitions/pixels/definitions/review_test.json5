{
    "m_review_test_pixel": {
        "description": "Fires when a review test action is performed, tracking the source of the action",
        "owners": ["samsymons"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "source",
                "type": "string",
                "description": "The source of the review test action",
                "enum": ["menu", "shortcut", "automatic"]
            }
        ],
        "expires": "2026-06-30"
    }
}

{
    "ios-new-tab-page-session": {
        "description": "Sent at the end of a New Tab Page visit, capturing which actions the user took while the New Tab Page was on screen and how the visit ended.",
        "owners": ["dus7"],
        "meta": {
            "type": "ios-new-tab-page-session",
            "version": "1.0"
        },
        "feature": {
            "name": "new-tab-page-session",
            "status": ["SUCCESS", "FAILURE", "CANCELLED", "UNKNOWN"],
            "data": {
                "ext": {
                    "status_reason": {
                        "type": "string",
                        "description": "Terminal reason accompanying UNKNOWN outcomes. Present only when a visit left in flight by app termination is recovered and reported later. Every other outcome describes itself through `terminal_action`.",
                        "enum": ["app_terminated"]
                    },
                    "trigger": {
                        "type": "string",
                        "description": "What opened the New Tab Page. `app_open` = the New Tab Page was the surface the app opened into, whether from a cold launch or a return from the background; `new_tab_opened` = the user opened a new tab within an already running app; `new_tab_opened_after_fire` = the New Tab Page the app lands on once the Fire button has cleared everything, which is a different intent from deliberately opening a blank tab.",
                        "enum": ["app_open", "new_tab_opened", "new_tab_opened_after_fire"]
                    },
                    "launch_keyboard_mode": {
                        "type": "string",
                        "description": "Whether the New Tab Page was launched with the keyboard up (`up` = the input was focused, so the visit started in search mode) or with the keyboard down (`down` = the visit started on the start page). This is the mode the app decided on at launch, not the live keyboard state at any later point in the visit, and not the state of a connected hardware keyboard.",
                        "enum": ["up", "down"]
                    },
                    "toggle_enabled": {
                        "type": "boolean",
                        "description": "True if the user has the Search / Duck.ai input toggle enabled in settings ('Toggle between Search and Duck.ai' rather than 'Search only')"
                    },
                    "terminal_action": {
                        "type": "string",
                        "description": "The single action that ended the visit, meaning the user left the New Tab Page. The first twelve values (`load_serp` through `menu_item_selected`) map to SUCCESS. `custom_button` is the customizable toolbar button set to something other than Fire, reachable on the New Tab Page only while icon customization is enabled. `menu_item_selected` covers picking a top level browsing menu entry that has no terminal of its own, such as New Tab or Settings, which replaces the New Tab Page for good. `no_action_timeout` (the user took no action for 30 seconds) and `max_duration_exceeded` (the visit reached the 2 minute overall limit without ending) map to FAILURE. `app_backgrounded` maps to CANCELLED. `app_terminated` maps to UNKNOWN and is used for a visit recovered after the app was killed. Steps that leave the user on the New Tab Page, or that lead to a screen the user comes back from, such as copying a private email address or opening Bookmarks from the menu, are recorded under `actions` instead and let the visit continue.",
                        "enum": [
                            "load_serp",
                            "load_search_suggestion",
                            "load_website",
                            "load_duckai",
                            "load_duckai_response",
                            "load_previous_chat",
                            "last_tab_loaded",
                            "select_other_tab",
                            "swipe_to_other_tab",
                            "delete_data",
                            "custom_button",
                            "menu_item_selected",
                            "no_action_timeout",
                            "max_duration_exceeded",
                            "app_backgrounded",
                            "app_terminated"
                        ]
                    },
                    "action_count_bucketed": {
                        "type": "string",
                        "description": "Total number of actions the user took during the visit, bucketed (lower end of bucket). Answers how many steps the user took between arriving on the New Tab Page and leaving it.",
                        "enum": ["0", "1", "2", "3", "5", "10", "20"]
                    },
                    "time_to_first_interaction_ms_bucketed": {
                        "type": "string",
                        "description": "Time from the start of the visit to the user's first interaction with the New Tab Page, bucketed (lower end of bucket, in ms). Absent if the visit ended with no interaction at all.",
                        "enum": ["0", "1000", "5000", "10000", "30000", "60000", "300000", "600000"]
                    },
                    "session_duration_ms_bucketed": {
                        "type": "string",
                        "description": "Total time the New Tab Page was visible, from the start of the visit until the terminal action, bucketed (lower end of bucket, in ms). Absent when the visit was recovered as app_terminated.",
                        "enum": ["0", "1000", "5000", "10000", "30000", "60000", "300000", "600000"]
                    },
                    "actions": {
                        "type": "object",
                        "description": "Flags for each action the user could take during the visit. Unlike terminal_action, several of these can be true for a single visit.",
                        "properties": {
                            "tap_input_bar": {
                                "type": "boolean",
                                "description": "True if the user tapped the input bar during the visit"
                            },
                            "type_in_input": {
                                "type": "boolean",
                                "description": "True if the user typed into the input during the visit"
                            },
                            "switch_toggle_to_search": {
                                "type": "boolean",
                                "description": "True if the user switched the input toggle to Search during the visit"
                            },
                            "switch_toggle_to_ai_chat": {
                                "type": "boolean",
                                "description": "True if the user switched the input toggle to Duck.ai during the visit"
                            },
                            "tap_duckai_button": {
                                "type": "boolean",
                                "description": "True if the user tapped the Duck.ai button during the visit"
                            },
                            "hit_submit": {
                                "type": "boolean",
                                "description": "True if the user submitted the input during the visit"
                            },
                            "choose_suggestion": {
                                "type": "boolean",
                                "description": "True if the user chose an autocomplete suggestion during the visit"
                            },
                            "tap_favorite": {
                                "type": "boolean",
                                "description": "True if the user tapped a favorite during the visit"
                            },
                            "tap_fire_button": {
                                "type": "boolean",
                                "description": "True if the user tapped the Fire button during the visit"
                            },
                            "tap_return_to_last": {
                                "type": "boolean",
                                "description": "True if the user tapped the return to last tab action during the visit"
                            },
                            "tap_tab_viewer_escape_hatch": {
                                "type": "boolean",
                                "description": "True if the user opened the tab viewer from the escape hatch during the visit"
                            },
                            "tap_tab_viewer_toolbar": {
                                "type": "boolean",
                                "description": "True if the user opened the tab viewer from the toolbar during the visit"
                            },
                            "tap_bookmarks_toolbar_item": {
                                "type": "boolean",
                                "description": "True if the user tapped the bookmarks toolbar item during the visit"
                            },
                            "tap_passwords_toolbar_item": {
                                "type": "boolean",
                                "description": "True if the user tapped the passwords toolbar item during the visit"
                            },
                            "open_menu": {
                                "type": "boolean",
                                "description": "True if the user opened the browser menu during the visit"
                            },
                            "menu_bookmarks": {
                                "type": "boolean",
                                "description": "True if the user selected Bookmarks from the menu during the visit"
                            },
                            "menu_passwords": {
                                "type": "boolean",
                                "description": "True if the user selected Passwords from the menu during the visit"
                            },
                            "menu_chats": {
                                "type": "boolean",
                                "description": "True if the user selected Chats from the menu during the visit"
                            },
                            "menu_downloads": {
                                "type": "boolean",
                                "description": "True if the user selected Downloads from the menu during the visit"
                            },
                            "menu_vpn": {
                                "type": "boolean",
                                "description": "True if the user selected the VPN entry from the menu during the visit"
                            },
                            "click_message_cta": {
                                "type": "boolean",
                                "description": "True if the user tapped the call to action on a New Tab Page message during the visit"
                            },
                            "click_message_dismiss": {
                                "type": "boolean",
                                "description": "True if the user dismissed a New Tab Page message during the visit"
                            },
                            "dismiss_keyboard": {
                                "type": "boolean",
                                "description": "True if the user dismissed the keyboard during the visit"
                            },
                            "scroll_view": {
                                "type": "boolean",
                                "description": "True if the user scrolled the New Tab Page during the visit"
                            },
                            "uti_back_arrow": {
                                "type": "boolean",
                                "description": "True if the user tapped the back arrow in the Unified Toggle Input during the visit"
                            },
                            "select_bookmark": {
                                "type": "boolean",
                                "description": "True if the user opened a bookmark from the Bookmarks screen during the visit"
                            },
                            "select_password": {
                                "type": "boolean",
                                "description": "True if the user opened a saved login from the Passwords screen during the visit"
                            },
                            "select_download": {
                                "type": "boolean",
                                "description": "True if the user opened a download from the Downloads screen during the visit"
                            },
                            "email_copied": {
                                "type": "boolean",
                                "description": "True if a new private email address was copied to the clipboard during the visit"
                            },
                            "vpn_on": {
                                "type": "boolean",
                                "description": "True if the VPN went from off to on across a visit the user made to the VPN screen. Read by sampling the connection state when the user leaves for that screen and again when they return, so a tunnel that reconnects by itself while they are on the screen is attributed to them."
                            },
                            "vpn_off": {
                                "type": "boolean",
                                "description": "True if the VPN went from on to off across a visit the user made to the VPN screen. Sampled the same way as `vpn_on`."
                            }
                        }
                    }
                }
            }
        }
    }
}

{
    "web_extension_update_success_macos": {
        "description": "Fires when a verified extension update is committed at startup, including updates left disabled because additional permissions are required. Daily counts affected installations; count counts committed updates.",
        "owners": ["diegoreymendez"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "web_extension_update_failure_macos": {
        "description": "Fires when applying or recovering an extension update fails, excluding cancellation, eligibility deferrals and cleanup-only failures. Daily counts affected installations; count counts failures. No package URL, hash, version or error text is sent.",
        "owners": ["diegoreymendez"],
        "triggers": ["exception"],
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "web_extension",
            {
                "key": "outcome",
                "type": "string",
                "description": "The bounded installation failure reason",
                "enum": ["invalid_package", "storage_failure", "load_failure"]
            },
            "channel"
        ]
    },
    "web_extension_update_download_failed_macos": {
        "description": "Fires when downloading an extension update fails, excluding cancellation. Daily counts affected installations; count counts failures. No package URL, hash or version is sent.",
        "owners": ["diegoreymendez"],
        "triggers": ["exception"],
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "web_extension",
            {
                "key": "outcome",
                "type": "string",
                "description": "The bounded failure reason",
                "enum": [
                    "invalid_request",
                    "invalid_response",
                    "http_status",
                    "network_failure",
                    "size_mismatch",
                    "package_too_large",
                    "hash_mismatch"
                ]
            },
            "channel"
        ]
    },
    "web_extension_update_verification_failed_macos": {
        "description": "Fires when an extension update fails verification or cannot be retained for installation, excluding cancellation. Daily counts affected installations; count counts failures. No package URL, hash or version is sent.",
        "owners": ["diegoreymendez"],
        "triggers": ["exception"],
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "web_extension",
            {
                "key": "outcome",
                "type": "string",
                "description": "The bounded failure reason",
                "enum": ["invalid_package", "invalid_signature", "invalid_version", "version_mismatch", "not_newer", "storage_failure"]
            },
            "channel"
        ]
    },
    "web_extension_update_verified_macos": {
        "description": "Fires when a downloaded extension update passes verification and is retained for installation. Daily counts affected installations; count counts verified updates. No package URL, hash or version is sent.",
        "owners": ["diegoreymendez"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "web_extension_update_found_macos": {
        "description": "Fires when a Chrome Web Store update check finds a newer version. Daily counts affected installations; count counts discoveries. No package URL, hash or version is sent.",
        "owners": ["diegoreymendez"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "web_extension_update_check_failed_macos": {
        "description": "Fires when a Chrome Web Store update check fails, excluding cancellation. Daily counts affected installations; count counts failures. Only a bounded failure category is sent, without server messages or HTTP status codes.",
        "owners": ["diegoreymendez"],
        "triggers": ["exception"],
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "web_extension",
            {
                "key": "outcome",
                "type": "string",
                "description": "The bounded result of the extension update check",
                "enum": ["invalid_request", "invalid_response", "invalid_manifest", "response_too_large", "network_failure", "http_status"]
            },
            "channel"
        ]
    },
    "web_extension_update_skipped_macos": {
        "description": "Fires when Google flags an extension update as malware, unwanted software or a policy violation. The update is skipped without disabling the extension. Daily counts affected installations; count counts skips.",
        "owners": ["diegoreymendez"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "m_mac_web_extension_installed": {
        "description": "Fires when a web extension is successfully installed. Updates of an installed extension don't fire it.",
        "owners": ["tomasstrba"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "pixelSource", "channel", "web_extension"]
    },
    "m_mac_web_extension_install_error": {
        "description": "Fires when a web extension installation fails.",
        "owners": ["tomasstrba"],
        "triggers": ["exception"],
        "suffixes": ["daily_standard"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "errorCode",
            "errorDomain",
            "underlyingErrorCode",
            "underlyingErrorDomain",
            "channel",
            "web_extension"
        ]
    },
    "m_mac_web_extension_uninstalled": {
        "description": "Fires when a web extension is successfully uninstalled.",
        "owners": ["tomasstrba"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "pixelSource", "channel", "web_extension"]
    },
    "m_mac_web_extension_uninstall_error": {
        "description": "Fires when a web extension uninstallation fails.",
        "owners": ["tomasstrba"],
        "triggers": ["exception"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "pixelSource", "errorCode", "errorDomain", "underlyingErrorCode", "underlyingErrorDomain"]
    },
    "m_mac_web_extension_uninstalled_all": {
        "description": "Fires when all web extensions are successfully uninstalled.",
        "owners": ["tomasstrba"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_web_extension_uninstall_all_error": {
        "description": "Fires when uninstalling all web extensions fails (at least one extension failed to uninstall).",
        "owners": ["tomasstrba"],
        "triggers": ["exception"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "pixelSource", "errorCode", "errorDomain", "underlyingErrorCode", "underlyingErrorDomain"]
    },
    "m_mac_web_extension_loaded": {
        "description": "Fires during app startup when installed web extensions are successfully loaded.",
        "owners": ["tomasstrba"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_web_extension_load_error": {
        "description": "Fires during app startup when loading installed web extensions fails (at least one extension failed to load).",
        "owners": ["tomasstrba"],
        "triggers": ["exception"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "pixelSource", "channel", "errorCode", "errorDomain", "underlyingErrorCode", "underlyingErrorDomain"]
    },
    "m_mac_web_extension_embedded_installed": {
        "description": "Fires when the embedded (bundled) web extension is successfully installed for the first time.",
        "owners": ["tomasstrba", "miasma13"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_web_extension_embedded_upgraded": {
        "description": "Fires when the embedded (bundled) web extension is upgraded to a newer version.",
        "owners": ["tomasstrba", "miasma13"],
        "triggers": ["other"],
        "suffixes": ["daily_standard"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "from_version",
                "type": "string",
                "description": "The previous version of the embedded extension before upgrade"
            },
            {
                "key": "to_version",
                "type": "string",
                "description": "The new version of the embedded extension after upgrade"
            },
            "channel"
        ]
    },
    "m_mac_web_extension_embedded_install_error": {
        "description": "Fires when installing or upgrading the embedded (bundled) web extension fails.",
        "owners": ["tomasstrba", "miasma13"],
        "triggers": ["exception"],
        "suffixes": ["daily_standard"],
        "parameters": ["appVersion", "pixelSource", "errorCode", "errorDomain", "underlyingErrorCode", "underlyingErrorDomain"]
    },
    "m_mac_web_extension_dark_reader_installed": {

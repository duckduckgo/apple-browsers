{
    "dataimport_history_source-file-missing_macos": {
        "description": "Fired when history import finds no history file where it looks for one: a Chromium browser profile's folder can be read but has no 'History' database, or a Safari export archive can be read but has no history JSON file. Tells us when a browser renames or moves its history file.",
        "owners": ["andremartingo"],
        "triggers": ["user_interaction"],
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "source",
                "description": "The browser the user is importing data from",
                "type": "string",
                "enum": ["brave", "chrome", "edge", "opera", "other", "safari"]
            },
            {
                "key": "source_browser_version",
                "description": "Major version of the browser the user is importing from, when known",
                "type": "string"
            }
        ]
    }
}

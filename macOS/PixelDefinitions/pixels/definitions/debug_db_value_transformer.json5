{
    "m_mac_debug_db_value_transformer_registration_error": {
        "description": "Fired when the app fails to register Core Data value transformers during database initialization, because the data encryption key could not be read from the Keychain",
        "owners": ["samsymons"],
        "triggers": ["other"],
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "errorCode",
            "errorDomain",
            "underlyingErrorCode",
            "underlyingErrorDomain",
            "keychainErrorCode",
            "keychainKeyOutcome"
        ]
    }
}

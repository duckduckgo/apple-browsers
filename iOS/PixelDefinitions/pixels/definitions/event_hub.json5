    // Entries below come from the shared base `event-hub` feature config rather than the Apple override,
    // so they arrive on every platform once the feature is enabled.
    "eventHub_baseline_day": {
        "description": "Daily bucketed count of periods in which EventHub ran at all. Serves as the denominator for the other eventHub telemetry — it counts nothing beyond the period itself. Fired by the eventHub feature at the end of each 1-day period.",
        "owners": ["miasma13"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion", "eventHubBaseline", "eventHubAttributionPeriod"]
    },
    "eventHub_baseline_week": {
        "description": "Weekly bucketed count of periods in which EventHub ran at all. Serves as the denominator for the other eventHub telemetry — it counts nothing beyond the period itself. Fired by the eventHub feature at the end of each 7-day period.",
        "owners": ["miasma13"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion", "eventHubBaseline", "eventHubAttributionPeriod"]
    },

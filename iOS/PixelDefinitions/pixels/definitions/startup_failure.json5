{
    "startup_failure": {
        "description": "A known startup failure prevents the app from becoming usable. Sent once per failure episode; further failures are suppressed until a successful startup.",
        "owners": ["diegoreymendez"],
        "triggers": ["exception"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion", "originalPixelTimestamp", "retriedPixel"]
    },
    "startup_failure_returned": {
        "description": "The app reaches the foreground for the first time after a recorded startup failure. Successful startup is recorded separately.",
        "owners": ["diegoreymendez"],
        "triggers": ["startup"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "days_count",
                "type": "string",
                "description": "Bucket for whole days from the first startup failure to the first return. Each bucket starts at the listed day and ends before the next bucket. 21+ covers 21 days or more. Omitted if elapsed time cannot be calculated.",
                "enum": ["0", "1+", "3+", "5+", "8+", "13+", "21+"]
            },
            "originalPixelTimestamp",
            "retriedPixel"
        ]
    },
    "startup_failure_recovered": {
        "description": "The app finishes startup after a recorded startup failure. Sent once, closing the episode and allowing a subsequent failure to start a new one.",
        "owners": ["diegoreymendez"],
        "triggers": ["startup"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "days_count",
                "type": "string",
                "description": "Bucket for whole days from the first startup failure to recovery. Each bucket starts at the listed day and ends before the next bucket. 21+ covers 21 days or more. Omitted if elapsed time cannot be calculated.",
                "enum": ["0", "1+", "3+", "5+", "8+", "13+", "21+"]
            },
            "originalPixelTimestamp",
            "retriedPixel"
        ]
    }
}

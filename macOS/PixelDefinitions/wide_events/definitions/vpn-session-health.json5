{
    "macos-vpn-session-health": {
        "description": "Sent once per VPN runtime event: from the WireGuard adapter coming up until the provider stops, cancels, or transitions unexpectedly. Measures whether an already-running VPN stayed healthy. Separate from macos-vpn-connection, which measures startup.",
        "owners": ["jleandroperez"],
        "meta": {
            "type": "macos-vpn-session-health",
            "version": "0.0"
        },
        "feature": {
            "name": "vpn-session-health",
            "status": ["SUCCESS", "FAILURE", "UNKNOWN"],
            "data": {
                "ext": {
                    "start_reason": {
                        "type": "string",
                        "description": "Why the event began.",
                        "enum": ["physical_tunnel_manual_start", "physical_tunnel_on_demand_start"]
                    },
                    "end_reason": {
                        "type": "string",
                        "description": "Why the event ended. Exactly one applies. `stopped_by_user` covers every VPN-off surface; `stopped_administratively` covers app and OS housekeeping; `process_died` is recovered on the next launch; `restarted_without_stop` means a start arrived while an event was still open.",
                        "enum": [
                            "stopped_by_user",
                            "stopped_by_failure",
                            "stopped_administratively",
                            "stopped_without_network",
                            "cancelled_with_error",
                            "restarted_without_stop",
                            "process_died"
                        ]
                    },
                    "failure_reason": {
                        "type": "string",
                        "description": "The reason an event FAILED. Absent on SUCCESS and UNKNOWN, which use status_reason. `routing_outage` = the tester crossed its extended failure threshold (8 consecutive failures); `routing_outage_at_user_stop` = the user switched the VPN off while a tester outage was still active; `stale_handshake` = no WireGuard handshake for over 5 minutes.",
                        "enum": [
                            "routing_outage",
                            "routing_outage_at_user_stop",
                            "stale_handshake",
                            "failure_recovery_failed",
                            "stopped_with_failure",
                            "cancelled_with_error"
                        ]
                    },
                    "status_reason": {
                        "type": "string",
                        "description": "The activity that failed to produce a judgement, for an event that ended UNKNOWN. `monitors_never_started` = the monitors this measurement needs never came up; `connection_tester_never_reported` = they came up but the event ended before the first result.",
                        "enum": [
                            "monitors_never_started",
                            "connection_tester_never_reported",
                            "extension_process_died",
                            "os_stopped_without_network"
                        ]
                    },
                    "monitoring_coverage": {
                        "type": "string",
                        "description": "How much of the event was observed. Publish beside the SLI: rising `partial` or `none` means a degrading denominator, not better reliability.",
                        "enum": ["full", "partial", "none"]
                    },
                    "event_duration_seconds_bucketed": {
                        "type": "string",
                        "description": "Wall-clock length of the event, bucketed (lower end of bucket, in seconds). Includes paused periods.",
                        "enum": ["0", "60", "300", "1800", "7200", "28800", "86400"]
                    },
                    "time_to_first_error_seconds_bucketed": {
                        "type": "string",
                        "description": "Time from event start to the first error of any kind, bucketed (lower end of bucket, in seconds). Absent when there were none.",
                        "enum": ["0", "60", "300", "1800", "7200", "28800", "86400"]
                    },
                    "connection_tester_outage_count_bucketed": {
                        "type": "string",
                        "description": "How many distinct connection-tester outages occurred, bucketed (lower end of bucket).",
                        "enum": ["0", "1", "2", "4", "9"]
                    },
                    "outage_duration_seconds_bucketed": {
                        "type": "string",
                        "description": "Summed monitored duration of all connection-tester outages during the event, bucketed (lower end of bucket, in seconds). The `0` bucket also covers a total under one second.",
                        "enum": ["0", "1", "15", "60", "300", "900", "1800", "3600"]
                    },
                    "extension_type": {
                        "type": "string",
                        "description": "Which network extension served the event.",
                        "enum": ["app", "system", "unknown"]
                    },
                    "connection_tester_failure_seen": {
                        "type": "boolean",
                        "description": "Whether any connection-tester failure occurred, including one that recovered."
                    },
                    "connection_tester_extended_failure_seen": {
                        "type": "boolean",
                        "description": "Whether a tester outage crossed the extended failure threshold. The primary routing_outage input."
                    },
                    "connection_tester_failure_active_at_end": {
                        "type": "boolean",
                        "description": "Whether a tester failure was still active when the event ended."
                    },
                    "stale_handshake_seen": {
                        "type": "boolean",
                        "description": "Whether the stale-handshake monitor reported a failure."
                    },
                    "stale_handshake_recovered": {
                        "type": "boolean",
                        "description": "Whether a reported stale handshake later recovered. Present only when stale_handshake_seen."
                    },
                    "failure_recovery_attempted": {
                        "type": "boolean",
                        "description": "Whether server failure recovery was attempted."
                    },
                    "failure_recovery_succeeded": {
                        "type": "boolean",
                        "description": "Whether that recovery succeeded. Present only when a recovery finished."
                    },
                    "stopped_by_user_with_active_failure": {
                        "type": "boolean",
                        "description": "Whether a deliberate user disable coincided with an active routing failure. The headline diagnostic for silently broken tunnels."
                    },
                    "ip_leak_detected": {
                        "type": "boolean",
                        "description": "Whether an IP leak was confirmed during the event. Diagnostic only."
                    }
                }
            }
        }
    }
}

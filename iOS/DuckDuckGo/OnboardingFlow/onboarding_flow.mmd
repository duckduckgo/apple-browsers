flowchart TD
    Start([App launch])

    Start -->|"hasSeenOnboarding == false<br/>FF onboardingRebranding = ON"| P1

    P1["<b>① Landing</b><br/>Welcome to DuckDuckGo<br/>splash (waits for tap)"]
    P1 -->|"user taps anywhere<br/>(isSkipped = true)"| IntroPicker

    IntroPicker{Pick intro variant}
    IntroPicker -->|"appDefaults.onboardingUserType == .newUser<br/>OR variant != VariantIOS.returningUser"| P2a
    IntroPicker -->|"onboardingUserType == .returningUser<br/>AND restorePromptHandler.isEligibleForRestorePrompt() == true"| P2b
    IntroPicker -->|"onboardingUserType == .returningUser<br/>AND NOT eligible for restore"| P2c

    P2a["<b>②a Intro (.default)</b><br/>Hi! I'm Dax. Ready to take<br/>your privacy to the next level?<br/>[Let's do it!] [Skip]"]
    P2b["<b>②b Intro (.restoreData)</b><br/>Welcome back! Restore your data?<br/>[Restore] [Skip]"]
    P2c["<b>②c Intro (.skipTutorial)</b><br/>Welcome back! Skip tutorial?<br/>[Continue] [Skip]"]

    P2a -->|"tap Skip"| P3
    P2b -->|"tap Skip"| P3
    P2c -->|"tap Skip"| P3
    P2b -->|"tap Restore<br/>→ restoreSyncAccountAction"| Browser

    P3["<b>③ Skip confirmation</b><br/>Are you sure you want to skip?<br/>[Yes, skip] [Resume]"]
    P3 -->|"Resume → back to intro"| IntroPicker
    P3 -->|"Yes, skip<br/>hasSkippedOnboarding = true<br/>contextual dialogs disabled"| Browser

    P2a -->|"Let's do it!"| P4
    P2c -->|"Continue"| P4

    P4["<b>④ Browsers Comparison</b><br/>How DuckDuckGo compares<br/>vs Chrome / Safari etc.<br/>[Next]"]
    P4 -->|"idiom == .phone (iPhoneFlow)"| P5
    P4 -->|"idiom == .pad (iPadFlow)"| P7

    P5["<b>⑤ Add to Dock — Promo</b><br/>(iPhone only)<br/>Add me to your Dock<br/>[Show me how] [Skip]"]
    P5 -->|"Show me how"| P5b
    P5 -->|"Skip"| P7

    P5b["<b>⑤b Add to Dock — Tutorial</b><br/>Animated tutorial<br/>[Got it]"]
    P5b -->|"Got it"| P7

    P7["<b>⑥ App Icon Picker</b><br/>Which color looks best on me?<br/>[Next]"]
    P7 -->|"idiom == .phone"| P8
    P7 -->|"idiom == .pad<br/>END OF iPad FLOW"| Browser

    P8["<b>⑦ Address Bar Position</b><br/>(iPhone only)<br/>Top vs Bottom<br/>[Next]"]
    P8 -->|"Next"| P9

    P9["<b>⑧ Search Experience</b><br/>(iPhone only)<br/>Easy access to private AI?<br/>[AI Chat] [Search only]"]
    P9 -->|"chose Search only<br/>OR FF onboardingDuckAIQueryExperiment == OFF<br/>OR cohort ∈ {control, nil}"| Browser
    P9 -->|"chose AI Chat<br/>AND FF onboardingDuckAIQueryExperiment == ON<br/>AND cohort ∈ {treatmentA, treatmentB}"| P10

    P10["<b>⑨ Duck.ai Query Experiment</b><br/>Try a query (search or AI)<br/>defaultMode = duckAI if cohort=A<br/>defaultMode = search if cohort=B<br/>[Submit]"]
    P10 -->|"Submit query"| Browser

    Browser([Browser opens<br/>hasSeenOnboarding = true])

    classDef screen fill:#e8f4fd,stroke:#0366d6,stroke-width:2px,color:#000
    classDef gate fill:#fff3cd,stroke:#856404,color:#000
    classDef terminal fill:#d1e7dd,stroke:#0f5132,color:#000
    class P1,P2a,P2b,P2c,P3,P4,P5,P5b,P7,P8,P9,P10 screen
    class IntroPicker gate
    class Browser,Start terminal

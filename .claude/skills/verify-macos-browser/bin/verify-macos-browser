#!/usr/bin/env python3
"""Write and run a proof for the macOS browser: one command builds, launches, runs it, captures evidence, judges the
verdict, writes report.md and manifest.json, and always cleans up. verify.sh stays the low-level layer.

usage: verify-macos-browser new-proof <name> [--evidence-dir <dir>]  a proof template in a fresh attempt folder
       verify-macos-browser check <proof>...                         compile + shape + FLAGS; no app, no build
       verify-macos-browser prove <proof> --target mac|vm|vm-1|vm-2 [--evidence-dir <dir>] [--no-video]
                            [--checkout <dir>]
--checkout: build and prove another checkout of this repo (e.g. a base revision) with this skill
--evidence-dir: a directory outside any git checkout; each run writes a fresh <stamp>-<name>-<id>/ attempt folder in
       it (default ~/.ddg-verify-macos)
--no-video: no recording.mp4 (by default the proof is recorded: a VM's screen, or only the app's window on this Mac)
exit:  0 pass · 1 a check failed · 2 inconclusive: setup, an action or read that failed, nothing checked, a proof
       rejected by check, an --evidence-dir refused, or a pass with cleanup/evidence problems · 130 cancelled
       (report still written)
"""
import json
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "scripts"))
import harness  # noqa: E402


def main(argv):
    evidence_dir, video = None, "--no-video" not in argv
    if not video:
        if argv[0:1] != ["prove"]:
            print(__doc__)
            return 64
        argv.remove("--no-video")
    options = {}
    for name, commands in (("--evidence-dir", ("new-proof", "prove")), ("--checkout", ("prove",))):
        if name in argv:
            i = argv.index(name)
            if i + 1 == len(argv) or argv[0] not in commands:
                print(__doc__)
                return 64
            options[name] = argv.pop(i + 1)
            argv.pop(i)
    evidence_dir = options.get("--evidence-dir")
    try:
        if len(argv) == 2 and argv[0] == "new-proof":
            print(harness.new_proof(argv[1], harness.evidence_root(evidence_dir)))
            return 0
        if len(argv) == 4 and argv[0] == "prove" and argv[2] == "--target":
            checkout = harness.checkout_of(options["--checkout"]) if "--checkout" in options else harness.ROOT
            code, out = harness.prove(argv[1], argv[3], evidence_dir, video, checkout)
            print(json.dumps(out, indent=1))
            return code
    except harness.Refused as e:
        print(f"REFUSED: {e}", file=sys.stderr)
        return 2
    if len(argv) >= 2 and argv[0] == "check":
        out = [dict(proof=p, problems=harness.load(p)[1]) for p in argv[1:]]
        print(json.dumps(out, indent=1))
        return 2 if any(o["problems"] for o in out) else 0
    print(__doc__)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

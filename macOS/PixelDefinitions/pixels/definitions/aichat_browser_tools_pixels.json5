{
    "aichat_tools_call_macos": {
        "description": "Fired when a Duck.ai browser tool call finishes, whatever its result. Not fired for requestAccess or in Fire windows.",
        "owners": ["jotaemepereira"],
        "triggers": ["feature_lifecycle"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "tool",
                "description": "The tool called",
                "enum": [
                    "list_open_tabs",
                    "read_tab_content",
                    "search_history",
                    "find_in_page",
                    "highlight_in_page",
                    "switch_to_tab",
                    "pin_tab",
                    "open_tab",
                    "bookmark_tab",
                    "close_tabs",
                    "search_downloads",
                    "search_bookmarks"
                ]
            },
            {
                "key": "result",
                "description": "The result Duck.ai received. A success over the 512 KB result limit is execution_failed",
                "enum": ["success", "denied", "cancelled", "unavailable", "not_found", "invalid_arguments", "execution_failed"]
            },
            {
                "key": "permission_path",
                "description": "What let the call run or stopped it: auto = the tool doesn't ask, always = stored Always allow, chat = allowed for this chat earlier, prompt = the user was asked for this call, never = stored Never allow, none = refused before permission was looked at",
                "enum": ["auto", "always", "chat", "prompt", "never", "none"]
            },
            {
                "key": "duration",
                "description": "How long the tool ran, without the wait for permission. Absent when it never ran",
                "enum": ["lt_100ms", "lt_500ms", "lt_2s", "lt_10s", "gte_10s"]
            },
            {
                "key": "result_count",
                "description": "How many items a successful list_open_tabs, search_history, search_downloads or search_bookmarks call returned. Absent for other tools and failed calls",
                "enum": ["0", "1-5", "6-20", "21_plus"]
            }
        ]
    },
    "aichat_tools_prompt_answered_macos": {
        "description": "Fired when a Duck.ai browser tool permission prompt for one tool closes, answered or not. requestAccess prompts are not included.",
        "owners": ["jotaemepereira"],
        "triggers": ["user_interaction"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "tool",
                "description": "The tool the prompt asked for",
                "enum": [
                    "list_open_tabs",
                    "read_tab_content",
                    "search_history",
                    "find_in_page",
                    "highlight_in_page",
                    "switch_to_tab",
                    "pin_tab",
                    "open_tab",
                    "bookmark_tab",
                    "close_tabs",
                    "search_downloads",
                    "search_bookmarks"
                ]
            },
            {
                "key": "answer",
                "description": "How the prompt closed: allow_once, allow_for_chat, always or never = that button, dismiss = closed without a choice, timeout = unanswered until the 120 s deadline, withdrawn = closed because the call was cancelled or its chat went away",
                "enum": ["allow_once", "allow_for_chat", "always", "never", "dismiss", "timeout", "withdrawn"]
            },
            {
                "key": "prompt_number_in_chat",
                "description": "Which single-tool prompt this was in its Duck.ai chat since launch or the last Fire. Sent only while batch access (requestAccess) is on",
                "enum": ["1", "2", "3", "4_plus"]
            },
            {
                "key": "time_to_answer",
                "description": "Time from showing the prompt to closing it",
                "enum": ["lt_2s", "lt_10s", "lt_60s", "gte_60s"]
            }
        ]
    },
    "aichat_tools_access_requested_macos": {
        "description": "Fired when a Duck.ai requestAccess call finishes: Duck.ai asked once for the browser tools a chat expects to use. Not fired in Fire windows.",
        "owners": ["jotaemepereira"],
        "triggers": ["user_interaction"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "requested",
                "description": "How many tools Duck.ai asked for. Absent when decision is invalid or unavailable",
                "type": "integer",
                "minimum": 1,
                "maximum": 12
            },
            {
                "key": "asked",
                "description": "How many of them the prompt showed: the rest were already allowed, set to Never or unavailable. Absent when decision is invalid or unavailable",
                "type": "integer",
                "minimum": 0,
                "maximum": 12
            },
            {
                "key": "removed",
                "description": "How many shown tools the user took out before allowing. Absent when decision is invalid or unavailable",
                "type": "integer",
                "minimum": 0,
                "maximum": 12
            },
            {
                "key": "decision",
                "description": "allow, dont_allow or dismiss = the user's answer, timeout = unanswered until the 120 s deadline, withdrawn = closed because the call was cancelled or its chat went away, no_prompt = nothing needed asking, invalid = the call could not be read, unavailable = batch access is off",
                "enum": ["allow", "dont_allow", "dismiss", "timeout", "withdrawn", "no_prompt", "invalid", "unavailable"]
            }
        ]
    },
    "aichat_tools_access_result_macos": {
        "description": "Fired once per requested tool when a Duck.ai requestAccess call finishes, after aichat_tools_access_requested_macos. Names this app doesn't know are not sent. Not fired in Fire windows.",
        "owners": ["jotaemepereira"],
        "triggers": ["user_interaction"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "tool",
                "description": "The tool requested",
                "enum": [
                    "list_open_tabs",
                    "read_tab_content",
                    "search_history",
                    "find_in_page",
                    "highlight_in_page",
                    "switch_to_tab",
                    "pin_tab",
                    "open_tab",
                    "bookmark_tab",
                    "close_tabs",
                    "search_downloads",
                    "search_bookmarks"
                ]
            },
            {
                "key": "access",
                "description": "granted = allowed for the chat in this prompt, removed = taken out by the user, denied = the prompt didn't allow it, already_allowed = allowed without asking, never = set to Never, unavailable = not offered or a tool that asks every time",
                "enum": ["granted", "removed", "denied", "already_allowed", "never", "unavailable"]
            }
        ]
    },
    "aichat_tools_enabled_macos": {
        "description": "Fired at most once a day, when Duck.ai is offered browser tools: its page reads the native config, or the offered tools change while it is open. Not fired in Fire windows.",
        "owners": ["jotaemepereira"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["daily"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "aichat_tools_protocol_error_macos": {
        "description": "Fired when Duck.ai sends a browser tool call native cannot read, or one for a capability this app version does not know. A known tool turned off remotely is not an error. Not fired in Fire windows.",
        "owners": ["jotaemepereira"],
        "triggers": ["exception"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "reason",
                "description": "invalid_request = the call could not be read, unknown_capability = the capability name or version is not one this app knows",
                "enum": ["invalid_request", "unknown_capability"]
            },
            {
                "key": "tool",
                "description": "The tool the call named, or unknown when it named none this app knows. The raw name is never sent",
                "enum": [
                    "list_open_tabs",
                    "read_tab_content",
                    "search_history",
                    "find_in_page",
                    "highlight_in_page",
                    "switch_to_tab",
                    "pin_tab",
                    "open_tab",
                    "bookmark_tab",
                    "close_tabs",
                    "search_downloads",
                    "search_bookmarks",
                    "unknown"
                ]
            }
        ]
    },
    "aichat_tools_used_macos": {
        "description": "Fired at most once a day, on the first successful Duck.ai browser tool call of any tool.",
        "owners": ["jotaemepereira"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["daily"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },

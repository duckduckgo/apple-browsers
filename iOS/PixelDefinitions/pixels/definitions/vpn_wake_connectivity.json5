{
    "vpn_wake_connectivity_failure": {
        "description": "Three connectivity checks started after device wake failed to establish a TCP connection through the VPN, before any successful check in that wake cycle. Reported at most once per eligible wake cycle, regardless of network or tunnel configuration changes. Observation ends on successful connectivity, sleep, snooze, or disconnection. The pixel does not identify the cause of the failure.",
        "owners": ["diegoreymendez"],
        "triggers": ["exception"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "originalPixelTimestamp",
                "type": "string",
                "description": "ISO 8601 timestamp of the original failed send. Present only when PixelKit replays a persisted pixel.",
                "examples": ["2026-10-31T13:00:00Z"]
            },
            {
                "key": "retriedPixel",
                "type": "string",
                "description": "Marks a replay from PixelKit's persistent retry queue. Absent on the original send.",
                "enum": ["1"]
            }
        ]
    }
}

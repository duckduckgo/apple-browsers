      export_options: "scripts/assets/AppStoreExportOptions.plist",
      xcargs: "-skipPackagePluginValidation -skipMacroValidation"
    )
    make_appstore_package_relocatable
  end

  # Builds the App Store review version of the app.
  #
  private_lane :build_alpha do |options|
    sync_signing(options)

    build_app(
      export_method: "app-store",
      scheme: "macOS Browser Alpha App Store",
      export_options: "scripts/assets/AppStoreExportOptions.plist",
      xcargs: "-skipPackagePluginValidation -skipMacroValidation"
    )
    make_appstore_package_relocatable
  end

  # Rebuilds the exported App Store package so that the installer updates the app where the user keeps it.
  #
  # pkgbuild on macOS 27 and later sets BundleIsRelocatable to false by default, and the export has no
  # option to change it. A non-relocatable update installs to /Applications/<app> even when the user moved
  # the App Store app, and replaces the DMG app if it is there.
  #
  # The rebuilt package keeps the exported (already signed) app, the original Distribution file and
  # the original installer signing identity. Only the main app bundle becomes relocatable.
  #
  def make_appstore_package_relocatable
    package_path = lane_context[SharedValues::PKG_OUTPUT_PATH]
    UI.user_error!("No exported App Store package found") unless package_path && File.exist?(package_path)

    signing_identity = installer_signing_identity(package_path)

    Dir.mktmpdir do |dir|
      expanded_path = File.join(dir, 'expanded')
      sh('pkgutil', '--expand-full', package_path, expanded_path)

      component_path = single_component_package(expanded_path)
      package_info = read_package_info(component_path)
      main_bundle = main_app_bundle(package_info)
      payload_path = File.join(component_path, 'Payload')
      relative_bundle_path = main_bundle.attributes['path'].delete_prefix('./')
      sh('codesign', '--verify', '--deep', '--strict', File.join(payload_path, relative_bundle_path))

      component_plist_path = File.join(dir, 'components.plist')
      File.write(component_plist_path, [{
        'RootRelativeBundlePath' => relative_bundle_path,
        'BundleIsRelocatable' => true,
        'BundleIsVersionChecked' => true,
        'BundleHasStrictIdentifier' => true,
        'BundleOverwriteAction' => 'upgrade'
      }].to_plist)

      components_path = File.join(dir, 'components')
      FileUtils.mkdir_p(components_path)
      sh('pkgbuild',
         '--root', payload_path,
         '--component-plist', component_plist_path,
         '--identifier', package_info.attributes['identifier'],
         '--version', package_info.attributes['version'],
         '--install-location', package_info.attributes['install-location'],
         '--preserve-xattr',
         File.join(components_path, File.basename(component_path)))

      relocatable_package_path = File.join(dir, File.basename(package_path))
      sh('productbuild',
         '--distribution', File.join(expanded_path, 'Distribution'),
         '--package-path', components_path,
         '--sign', signing_identity,
         relocatable_package_path)

      verify_appstore_package_relocatable(relocatable_package_path, expected_package_info: package_info)
      FileUtils.mv(relocatable_package_path, package_path, force: true)
    end

    UI.success("Made #{File.basename(package_path)} relocatable")
  end

  # Fails unless the main app bundle in the package is relocatable.
  #
  # With `expected_package_info`, also fails if anything else in PackageInfo differs from it,
  # except the payload size and the list of relocatable bundles.
  #
  def verify_appstore_package_relocatable(package_path, expected_package_info: nil)
    Dir.mktmpdir do |dir|
      expanded_path = File.join(dir, 'expanded')
      sh('pkgutil', '--expand', package_path, expanded_path)
      package_info = read_package_info(single_component_package(expanded_path))
      bundle_id = main_app_bundle(package_info).attributes['id']

      relocatable_ids = REXML::XPath.match(package_info, 'relocate/bundle').map { |bundle| bundle.attributes['id'] }
      unless relocatable_ids.include?(bundle_id)
        UI.user_error!("#{File.basename(package_path)} is not relocatable: #{bundle_id} is missing from <relocate> in PackageInfo")
      end

      if expected_package_info
        actual = package_info_without_relocation(package_info)
        expected = package_info_without_relocation(expected_package_info)
        UI.user_error!("PackageInfo of the rebuilt package differs from the exported one:\n#{actual}\nExpected:\n#{expected}") unless actual == expected
      end
    end
  end

  def installer_signing_identity(package_path)
    signature = sh('pkgutil', '--check-signature', package_path, log: false)
    identity = signature[/^\s*1\. (.+)$/, 1]
    UI.user_error!("Couldn't read the installer signing identity of #{package_path}:\n#{signature}") unless identity
    identity
  end

  def single_component_package(expanded_path)
    components = Dir.glob(File.join(expanded_path, '*.pkg'))
    UI.user_error!("Expected 1 component package in #{expanded_path}, found #{components.count}") unless components.count == 1
    components.first
  end

  def read_package_info(component_path)
    REXML::Document.new(File.read(File.join(component_path, 'PackageInfo'))).root
  end

  # The main app is the only bundle at the root of the payload, for example `./DuckDuckGo.app`.
  def main_app_bundle(package_info)
    bundles = REXML::XPath.match(package_info, 'bundle').select { |bundle| bundle.attributes['path'].count('/') == 1 }
    UI.user_error!("Expected 1 bundle at the root of the package, found #{bundles.count}") unless bundles.count == 1
    bundles.first
  end

  def package_info_without_relocation(package_info)
    copy = REXML::Document.new(package_info.to_s).root
    %w[payload relocate].each { |name| copy.delete_element(name) }
    copy.to_s.gsub(/>\s+</, '><')
  end

  private_lane :fetch_testflight_build_number do |options|
    build_number = latest_testflight_build_number(
      api_key: get_api_key,
      username: get_username(options),
      platform: 'osx'
    )
    build_number
  end

  # Gets the live App Store version, build number and phased release state for macOS
  #
  # @option [String] username (default: nil) Your DDG Apple ID
  #
  private_lane :fetch_live_appstore_release do |options|
    app_store_build_number(
      api_key: get_api_key,
      username: get_username(options),
      platform: 'osx',
      live: true
    )
    version = lane_context[SharedValues::LATEST_VERSION]
    build_number = lane_context[SharedValues::LATEST_BUILD_NUMBER]

    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    live_version = app.get_live_app_store_version(
      platform: Spaceship::ConnectAPI::Platform::MAC_OS,
      includes: "appStoreVersionPhasedRelease"
    )
    unless live_version&.version_string == version
      UI.user_error!("The live version changed from #{version} while fetching its phased release, please try again")
    end
    # Included rather than fetched, because fetching raises for a version released without a phased release.
    phased_release = live_version.app_store_version_phased_release

    {
      version: version,
      build_number: build_number,
      version_state: live_version.app_version_state,
      phase_state: phased_release&.phased_release_state,
      phase_start_date: phased_release&.start_date
    }
  end

  # Returns nil if the file doesn't exist, and fails on any other error so that a failed read can't drop
  # the file's other entries.
  def read_release_metadata(s3_url)
    UI.message("Reading existing metadata from #{s3_url}")
    content, error, status = Open3.capture3('aws', 's3', 'cp', s3_url, '-')
    return content if status.success?
    return nil if error.include?('(404)')

    UI.user_error!("Couldn't read #{s3_url}: #{error.strip}")
  end

  # Updates version and build number in respective config files
  #
  # @option [String] version Marketing version string
  # @option [String] build_number Build number
  #
  private_lane :macos_update_version_and_build_number_config do |options|
    version = options[:version]
    build_number = options[:build_number]
    File.write(VERSION_CONFIG_PATH, "#{VERSION_CONFIG_DEFINITION} = #{version}\n")
    File.write(BUILD_NUMBER_CONFIG_PATH, "#{BUILD_NUMBER_CONFIG_DEFINITION} = #{build_number}\n")
    git_commit(
      path: [
        VERSION_CONFIG_PATH,
        BUILD_NUMBER_CONFIG_PATH
      ],
      message: "Bump version to #{version} (#{build_number})"
    )
  end

  def common_deliver_arguments(options)
    args = {
      api_key: get_api_key,
      submit_for_review: false,
      automatic_release: false,
      phased_release: true,
      force: true,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
         add_id_info_uses_idfa: false
      }
    }.merge(options)

    unless args.has_key? :username
      args[:username] = get_username(options)
    end
    args
  end
end

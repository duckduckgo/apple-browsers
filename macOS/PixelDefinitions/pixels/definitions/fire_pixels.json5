// Fire Button / Data Clearing Flow Pixels
{
    "m_mac_fire_completion": {
        "description": "Measures total data clearing operation duration from fire button trigger to when all clearing operations finish. Tracks clearing scope (tab/window/all), included data types, execution path, and auto-clear status.",
        "owners": ["hanyutang-sandra"],
        "triggers": ["fire_button", "auto_clear"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "clearing_option",
                "type": "string",
                "enum": ["currentTab", "currentWindow", "allData"],
                "description": "Scope of data clearing operation"
            },
            {
                "key": "domains",
                "type": "string",
                "description": "Comma-separated list of data domains cleared (History,TabsAndWindows,CookiesAndSiteData,ChatHistory)"
            },
            {
                "key": "path",
                "type": "string",
                "enum": ["burnEntity", "burnAll", "burnVisits", "burnAIChats"],
                "description": "Code path taken through Fire.swift"
            },
            {
                "key": "autoClear",
                "type": "string",
                "enum": ["true", "false"],
                "description": "Whether clearing was triggered by auto-clear (quit/launch) vs manual fire button"
            },
            {
                "key": "duration",
                "type": "integer",
                "description": "Total duration in milliseconds for the entire fire operation"
            }
        ]
    },
    
    "m_mac_fire_retrigger_in_20s": {
        "description": "Fired when fire button is triggered within 20 seconds of a previous clearing operation. Helps identify clearing effectiveness issues or user confusion.",
        "owners": ["hanyutang-sandra"],
        "triggers": ["fire_button"],
        "parameters": [
            "appVersion",
            "pixelSource"
        ]
    },
    
    // ------------------ burnWebCache ------------------
    
    "m_mac_fire_burn_web_cache_error": {
        "description": "Fired when burnWebCache() encounters an error",
        "owners": ["hanyutang-sandra"],
        "triggers": ["fire_button", "auto_clear"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "errorCode",
            "errorDomain",
            "underlyingErrorCode",
            "underlyingErrorDomain"
        ]
    },
    
    "m_mac_fire_burn_web_cache_duration": {
        "description": "Records burnWebCache() execution duration (fired on both success and error)",
        "owners": ["hanyutang-sandra"],
        "triggers": ["fire_button", "auto_clear"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "duration",
                "type": "integer",
                "description": "Duration in milliseconds"
            }
        ]
    },
    
    "m_mac_fire_burn_web_cache_has_residue": {
        "description": "Fired when burnWebCache() leaves residual data (incomplete clearing)",
        "owners": ["hanyutang-sandra"],
        "triggers": ["fire_button", "auto_clear"],
        "parameters": ["appVersion", "pixelSource"]
    },
    

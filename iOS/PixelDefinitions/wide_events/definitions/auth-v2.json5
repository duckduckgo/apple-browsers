{
    "ios-authv2-token-refresh": {
        "description": "Sent when AuthV2 has completed a token refresh",
        "owners": ["samsymons"],
        "meta": {
            "type": "ios-authv2-token-refresh",
            "version": "4.0"
        },
        "feature": {
            "name": "authv2-token-refresh",
            "status": ["SUCCESS", "FAILURE", "UNKNOWN"],
            "data": {
                "ext": {
                    "status_reason": {
                        "type": "string",
                        "description": "The reason provided when the status is UNKNOWN",
                        "enum": ["partial_data"]
                    },
                    "application_state": "foregroundBackgroundState",
                    "refresh_trigger": {
                        "type": "string",
                        "description": "The reason for the refresh.",
                        "enum": ["backend", "client", "create_if_needed", "token_adoption"]
                    },
                    "failing_step": {
                        "type": "string",
                        "description": "The step that the event failed on, if relevant.",
                        "enum": [
                            "token_read",
                            "refresh_access_token",
                            "fetch_jwks",
                            "verify_access_token",
                            "verify_refresh_token",
                            "token_write",
                            "recover_invalid_token"
                        ]
                    },
                    "refresh_token_latency_ms_bucketed": {
                        "type": "integer",
                        "description": "The latency value of the token refresh call.",
                        "enum": [1000, 5000, 10000, 30000, 60000, 300000, 600000]
                    },
                    "fetch_jwks_latency_ms_bucketed": {
                        "type": "integer",
                        "description": "The latency value of the JWKS call.",
                        "enum": [1000, 5000, 10000, 30000, 60000, 300000, 600000]
                    },
                    "recovery_latency_ms_bucketed": {
                        "type": "integer",
                        "description": "Bucketed latency from invalid-token detection to recovery outcome (ms).",
                        "enum": [1000, 5000, 10000, 30000, 60000, 300000, 600000]
                    },
                    "recovery_outcome": {
                        "type": "string",
                        "description": "Outcome of invalid-token recovery for this refresh, with its meaning from before the backup token: succeeded when any recovery yielded a valid token (see recovery_method), failed when the App Store restore ran and didn't, not_attempted when it didn't run and nothing recovered the token. The backup restore is reported in backup_outcome.",
                        "enum": ["not_attempted", "succeeded", "failed"]
                    },
                    "recovery_method": {
                        "type": "string",
                        "description": "How the token was recovered when recovery_outcome is succeeded: from the backup token or by the App Store restore. Absent when another process had already stored a new token or the user changed the session.",
                        "enum": ["backup", "app_store"]
                    },
                    "backup_outcome": {
                        "type": "string",
                        "description": "Outcome of the backup token restore when the recovery path was reached: succeeded, not_attempted when no backup restore ran, rejected when the backup can never restore the session, failed for a temporary or unknown failure, or session_changed when the user signed out, signed in or switched account during the restore.",
                        "enum": ["succeeded", "not_attempted", "rejected", "failed", "session_changed"]
                    },
                    "signed_out": {
                        "type": "boolean",
                        "description": "Whether this refresh ended with the user being signed out. Always emitted; true when invalid-token recovery failed or was not attempted, or when the backend reported an unknown account."
                    },
                    "subscription_status": {
                        "type": "string",
                        "description": "Status of the cached subscription when the refresh started. unavailable means no subscription was cached; unknown is a status returned by the backend.",
                        "enum": ["auto_renewable", "not_auto_renewable", "grace_period", "inactive", "expired", "unknown", "unavailable"]
                    },
                    "netp_is_running": {
                        "type": "boolean",
                        "description": "Whether the VPN tunnel was connected when the refresh started. Only emitted from the packet tunnel extension; false while the tunnel is still starting up."
                    },
                    "error": "errorParameters"
                }
            }
        }
    },
    "ios-authv2-token-adoption": {
        "description": "Sent when AuthV2 has completed a token adoption event",
        "owners": ["samsymons"],
        "meta": {
            "type": "ios-authv2-token-adoption",
            "version": "2.0"
        },
        "feature": {
            "name": "authv2-token-adoption",
            "status": ["SUCCESS", "FAILURE", "UNKNOWN"],
            "data": {
                "ext": {
                    "status_reason": {
                        "type": "string",
                        "description": "The reason provided when the status is UNKNOWN",
                        "enum": ["partial_data"]
                    },
                    "failing_step": {
                        "type": "string",
                        "description": "The step that the event failed on, if relevant.",
                        "enum": ["token_adoption", "token_refresh"]
                    },
                    "adoption_source": {
                        "type": "string",
                        "description": "What caused the token to be adopted, when known.",
                        "enum": ["web_restore", "vpn"]
                    },
                    "error": "errorParameters"
                }
            }
        }
    }
}

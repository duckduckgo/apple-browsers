{
    "ios-subscription-cancellation": {
        "description": "Sent at the end of a subscription cancellation journey, from the moment an auto-renewing subscriber taps Cancel Subscription, Manage Subscription, Manage Payment or Cancel, or Change Plan in Subscription Settings, until a subscription change shows auto-renew turned off, the plan changed, no subscription, or unusable data, an error stops the user from cancelling (FAILURE), or 24 hours pass without a cancellation (UNKNOWN). Tapping an entry again after a FAILURE starts a new journey.",
        "owners": ["hanyutang-sandra"],
        "meta": {
            "type": "ios-subscription-cancellation",
            "version": "1.0"
        },
        "feature": {
            "name": "subscription-cancellation",
            "status": ["SUCCESS", "FAILURE", "CANCELLED", "UNKNOWN"],
            "data": {
                "ext": {
                    "status_reason": {
                        "type": "string",
                        "description": "Why the journey ended: `not_auto_renewable` on SUCCESS; `plan_changed` on CANCELLED; `timeout`, `no_subscription`, `expired`, `grace_period` or `partial_data` on UNKNOWN. Not sent on FAILURE.",
                        "enum": [
                            "not_auto_renewable",
                            "timeout",
                            "plan_changed",
                            "no_subscription",
                            "expired",
                            "grace_period",
                            "partial_data"
                        ]
                    },
                    "entry_point": {
                        "type": "string",
                        "description": "The Subscription Settings button that started the journey.",
                        "enum": ["cancel_subscription", "manage_subscription", "manage_payment_or_cancel", "change_plan"]
                    },
                    "purchase_platform": {
                        "type": "string",
                        "description": "Platform the subscription was purchased on.",
                        "enum": ["app_store", "stripe"]
                    },
                    "is_trial": {
                        "type": "boolean",
                        "description": "Whether the subscription had an active free trial offer at the entry tap."
                    },
                    "subscription_identifier": {
                        "type": "string",
                        "description": "Product identifier of the subscription at the entry tap, e.g. ddg.privacy.pro.monthly.renews.us."
                    },
                    "days_since_purchase_bucketed": {
                        "type": "string",
                        "description": "Days between the subscription start and the entry tap, bucketed.",
                        "enum": ["d1", "d2_7", "d8_30", "d31_plus"]
                    },
                    "days_until_renewal_bucketed": {
                        "type": "string",
                        "description": "Days between the entry tap and the subscription's next renewal or expiry date, bucketed.",
                        "enum": ["d1", "d2_7", "d8_30", "d31_plus"]
                    },
                    "error": "errorParameters"
                }
            }
        }
    }
}

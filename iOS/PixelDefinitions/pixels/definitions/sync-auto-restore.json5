{
    "sync-auto-restore_onboarding_prompt_shown_unique": {
        "description": "Fired when the onboarding sync auto-restore prompt is shown.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_onboarding_restore_tapped_unique": {
        "description": "Fired when the user taps Restore My Data on the onboarding sync auto-restore prompt.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_onboarding_skip_tapped_unique": {
        "description": "Fired when the user taps Skip Restore on the onboarding sync auto-restore prompt.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_toggle_shown": {
        "description": "Fired when the Save Recovery Key screen shows the auto-restore toggle.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_toggle_opted_out": {
        "description": "Fired when the user completes Save Recovery Key with auto-restore turned off.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_toggle_learn_more": {
        "description": "Fired when the user taps Learn More in the Save Recovery Key auto-restore section.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_settings_ready_shown": {
        "description": "Fired when the Auto Restore Ready view is shown from Sync settings.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_settings_restore_tapped": {
        "description": "Fired when the user taps Restore My Data in Auto Restore Ready view.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_settings_scan_code_tapped": {
        "description": "Fired when the user taps Scan Recovery Code in Auto Restore Ready view.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_settings_cancelled": {
        "description": "Fired when the user cancels the Auto Restore Ready view.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_settings_manual_recovery_shown": {
        "description": "Fired when the manual Recover Synced Data view is shown from settings.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_settings_page_shown": {
        "description": "Fired when the dedicated Auto Restore settings page is shown.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_settings_page_toggle_enabled": {
        "description": "Fired when the user enables auto-restore on the dedicated settings page.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_settings_page_toggle_disabled": {
        "description": "Fired when the user disables auto-restore on the dedicated settings page.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "sync-auto-restore_success": {
        "description": "Fired when auto-restore succeeds while enabling sync from a preserved account.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "source",
                "description": "Flow source for auto-restore outcome.",
                "type": "string",
                "enum": ["onboarding", "settings"]
            }
        ]
    },
    "sync-auto-restore_failure": {
        "description": "Fired when auto-restore fails while enabling sync from a preserved account.",
        "owners": ["amddg44"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "source",
                "description": "Flow source for auto-restore outcome.",
                "type": "string",
                "enum": ["onboarding", "settings"]
            },
            "errorCode",
            "errorDomain",
            "underlyingErrorCode",
            "underlyingErrorDomain"
        ]
    }
}

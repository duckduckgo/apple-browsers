// Passkey request cancellation pixels (see WebKitPasskeyRequestCanceller.swift)
{
    "passkey_request_cancellation_install_failed_macos": {
        "description": "At launch, the WebKit passkey request canceller couldn't install because WebKit's passkey delegate class or an ASAuthorizationController method it replaces is missing, so pending passkey requests aren't cancelled.",
        "owners": ["diegoreymendez"],
        "triggers": ["exception"],
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            {
                "key": "reason",
                "description": "What was missing.",
                "enum": ["webkit_delegate_class", "perform_requests", "perform_autofill_assisted_requests", "cancel"]
            }
        ]
    }
}

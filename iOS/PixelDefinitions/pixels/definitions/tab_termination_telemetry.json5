{
    "m_d_tab-interaction-state_failed-to-restore": {
        "description": "Fires when WebKit interaction state is applied but does not restore a URL.",
        "owners": ["brindy"],
        "triggers": ["exception"],
        "suffixes": ["daily_standard", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "debug_webkit_termination_foreground": {
        "description": "Fires when a WebKit web content process terminates while the app is in the foreground.",
        "owners": ["brindy"],
        "triggers": ["exception"],
        "suffixes": ["platform", "form_factor", "daily_count"],
        "parameters": ["appVersion"]
    },
    "debug_webkit_termination_background": {
        "description": "Fires when a WebKit web content process terminates while the app is in the background.",
        "owners": ["brindy"],
        "triggers": ["exception"],
        "suffixes": ["platform", "form_factor", "daily_count"],
        "parameters": ["appVersion"]
    },
    "debug_webkit_termination_occurrence_": {
        "description": "Fires once daily for each bucket reached by the number of WebKit web content process terminations on the device that day.",
        "owners": ["brindy"],
        "triggers": ["exception"],
        "suffixes": [
            {
                "description": "WebKit termination occurrence bucket for the current day",
                "enum": ["1", "2", "3", "4", "5-plus"]
            },
            "platform",
            "form_factor",
            "daily"
        ],
        "parameters": ["appVersion"]
    },
    "debug_webkit_termination_memory_": {
        "description": "Fires with the app physical memory footprint bucket when a WebKit web content process terminates.",
        "owners": ["brindy"],
        "triggers": ["exception"],
        "suffixes": [
            {
                "description": "App physical memory footprint bucket in megabytes",
                "enum": ["less-512", "512-1023", "1024-2047", "2048-4095", "4096-8191", "8192-16383", "16384-plus"]
            },
            "platform",
            "form_factor",
            "daily_count"
        ],
        "parameters": ["appVersion"]
    },
    "debug_webkit_termination_active-tabs_": {
        "description": "Fires with the number of in-memory tab view controllers when a WebKit web content process terminates.",
        "owners": ["brindy"],
        "triggers": ["exception"],
        "suffixes": [
            {
                "description": "In-memory tab view controller count bucket",
                "enum": ["1", "2-5", "6-10", "11-20", "21-40", "41-60", "61-80", "81-plus"]
            },
            "platform",
            "form_factor",
            "daily_count"
        ],
        "parameters": ["appVersion"]
    },
    "debug_webkit_termination_time-since-memory-warning_": {
        "description": "Fires with the elapsed-time bucket since the last in-process memory warning when a WebKit web content process terminates.",
        "owners": ["brindy"],
        "triggers": ["exception"],
        "suffixes": ["time_bucket", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "debug_memory_warning_active-tabs_": {
        "description": "Fires with the number of in-memory tab view controllers when a memory warning is received.",
        "owners": ["brindy"],
        "triggers": ["exception"],
        "suffixes": [
            {
                "description": "In-memory tab view controller count bucket",
                "enum": ["1", "2-5", "6-10", "11-20", "21-40", "41-60", "61-80", "81-plus"]
            },
            "platform",
            "form_factor",
            "daily_count"
        ],
        "parameters": ["appVersion"]
    },
    "debug_memory_warning_occurrence-in-window_": {
        "description": "Fires for each memory warning with the number received in the configured rolling window.",
        "owners": ["brindy"],
        "triggers": ["exception"],
        "suffixes": [
            {
                "description": "Memory warning occurrence bucket in the rolling window",
                "enum": ["1", "2", "3", "4", "5-plus"]
            },
            "platform",
            "form_factor"
        ],
        "parameters": ["appVersion"]
    },
    "web-content_termination-reload-result": {
        "description": "Fires at most once per reload of the current tab after its web content process terminated (m_d_wktct): on the next navigation in that tab that finishes or fails (cancellations ignored), or on another termination before either. Navigations are not matched to the reload, so if the reload never starts, hangs or is cancelled, the next navigation the user makes in that tab is reported as its result. m_d_wktct minus this pixel therefore only counts reloads with no later navigation or termination in the tab, and is a lower bound on reloads that never completed. Use recovery to check that tabs killed in the background are still reloaded when the app becomes active.",
        "owners": ["hassaanelgarem"],
        "triggers": ["exception"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "outcome",
                "description": "How the reload ended",
                "enum": ["finished", "failed", "terminated"]
            },
            {
                "key": "recovery",
                "description": "immediate: reloaded when the termination was reported. deferred: the termination was reported in the background and the reload ran when the app became active",
                "enum": ["immediate", "deferred"]
            }
        ]
    },
    "web-content_unresponsive-2": {
        "description": "Fires when WebKit reports that a tab's web content process stopped responding. WebKit runs this check after a reload, navigation or preview snapshot, so this counts freezes the user tried to get out of. The parameters describe the page at that moment. Gated by the tabTerminationTelemetry subfeature.",
        "owners": ["hassaanelgarem"],
        "triggers": ["exception"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "app_state",
                "description": "App state when WebKit reported the hang",
                "enum": ["foreground", "background"]
            },
            {
                "key": "surface",
                "description": "search: DuckDuckGo search results. duckai: Duck.ai. other: any other page",
                "enum": ["search", "duckai", "other"]
            },
            {
                "key": "loading",
                "description": "Whether the page was still loading",
                "type": "boolean"
            },
            {
                "key": "desktop_mode",
                "description": "Whether the tab requested the desktop site",
                "type": "boolean"
            },
            {
                "key": "protections",
                "description": "Whether privacy protections were enabled for the site",
                "type": "boolean"
            },
            {
                "key": "web_extension",
                "description": "Whether a web extension was loaded (iOS 18.4 and later)",
                "type": "boolean"
            }
        ]
    },
    "web-content_unresponsive-result": {
        "description": "Fires once per web-content_unresponsive-2 when the freeze ends. Duration is measured from the reload or navigation the user made just before WebKit reported the hang, or from the report when there was none; for app-ended it runs until the app went to the background, or is unknown if it never did. Attempts counts reloads and navigations the user tried while frozen. The page parameters are those recorded when the hang was reported.",
        "owners": ["hassaanelgarem"],
        "triggers": ["exception"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "outcome",
                "description": "How the freeze ended: the page answered again, the tab was closed or evicted, the user pressed Fire, the web process died, or the app exited during the freeze and the next launch reported it",
                "enum": ["recovered", "closed", "fire", "terminated", "app-ended"]
            },
            {
                "key": "duration",
                "description": "Seconds from the user getting stuck (their reload or navigation, else WebKit's report) to the freeze ending",
                "enum": ["0-2", "2-5", "5-15", "15-30", "30-60", "60-plus", "unknown"]
            },
            {
                "key": "attempts",
                "description": "Reloads and navigations the user tried while the page was frozen",
                "enum": ["0", "1", "2", "3-5", "6-plus"]
            },
            {
                "key": "app_state",
                "description": "App state when the freeze ended",
                "enum": ["foreground", "background"]
            },
            {
                "key": "left_tab",
                "description": "Whether the user left the frozen tab or the app during the freeze: WebKit stopped waiting on the page without the page answering, well before the freeze ended",
                "type": "boolean"
            },
            {
                "key": "surface",
                "description": "search: DuckDuckGo search results. duckai: Duck.ai. other: any other page",
                "enum": ["search", "duckai", "other"]
            },
            {
                "key": "loading",
                "description": "Whether the page was still loading",
                "type": "boolean"
            },
            {
                "key": "desktop_mode",
                "description": "Whether the tab requested the desktop site",
                "type": "boolean"
            },
            {
                "key": "protections",
                "description": "Whether privacy protections were enabled for the site",
                "type": "boolean"
            },
            {
                "key": "web_extension",
                "description": "Whether a web extension was loaded (iOS 18.4 and later)",
                "type": "boolean"
            }
        ]
    }
}

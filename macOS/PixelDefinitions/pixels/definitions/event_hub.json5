    // Captcha pixels use an immediate trigger, so they carry neither a bucketed `count` nor an
    // `attributionPeriod` — EventHub fires one pixel per detection with no aggregation or deduplication.
    "webTelemetry_captcha_recaptcha_macos": {
        "description": "Fired once per detection of a Google reCAPTCHA challenge on a page. Fired immediately by the eventHub feature, without aggregation.",
        "owners": ["miasma13"],
        "triggers": ["other"],
        "parameters": ["appVersion"]
    },
    "webTelemetry_captcha_hcaptcha_macos": {
        "description": "Fired once per detection of an hCaptcha challenge on a page. Fired immediately by the eventHub feature, without aggregation.",
        "owners": ["miasma13"],
        "triggers": ["other"],
        "parameters": ["appVersion"]
    },
    "webTelemetry_captcha_turnstile_macos": {
        "description": "Fired once per detection of a Cloudflare Turnstile challenge on a page. Fired immediately by the eventHub feature, without aggregation.",
        "owners": ["miasma13"],
        "triggers": ["other"],
        "parameters": ["appVersion"]
    },
    "webTelemetry_captcha_cloudflare_macos": {
        "description": "Fired once per detection of a Cloudflare interstitial challenge on a page. Fired immediately by the eventHub feature, without aggregation.",
        "owners": ["miasma13"],
        "triggers": ["other"],
        "parameters": ["appVersion"]
    },
    "webTelemetry_captcha_other_macos": {
        "description": "Fired once per detection of a captcha challenge that matches no known provider. Fired immediately by the eventHub feature, without aggregation.",
        "owners": ["miasma13"],
        "triggers": ["other"],
        "parameters": ["appVersion"]
    },
    // Entries below come from the shared base `event-hub` feature config rather than the Apple override,
    // so they arrive on every platform once the feature is enabled.
    "eventHub_baseline_day_macos": {
        "description": "Daily bucketed count of periods in which EventHub ran at all. Serves as the denominator for the other eventHub telemetry — it counts nothing beyond the period itself. Fired by the eventHub feature at the end of each 1-day period.",
        "owners": ["miasma13"],
        "triggers": ["other"],
        "parameters": [
            "appVersion",
            {
                "key": "baseline",
                "type": "string",
                "description": "Bucketed count for the period (\"0+\")",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "key": "attributionPeriod",
                "type": "integer",
                "description": "Unix timestamp (UTC) denoting the start of the measurement period"
            }
        ]
    },
    "eventHub_baseline_week_macos": {
        "description": "Weekly bucketed count of periods in which EventHub ran at all. Serves as the denominator for the other eventHub telemetry — it counts nothing beyond the period itself. Fired by the eventHub feature at the end of each 7-day period.",
        "owners": ["miasma13"],
        "triggers": ["other"],
        "parameters": [
            "appVersion",
            {
                "key": "baseline",
                "type": "string",
                "description": "Bucketed count for the period (\"0+\")",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "key": "attributionPeriod",
                "type": "integer",
                "description": "Unix timestamp (UTC) denoting the start of the measurement period"
            }
        ]
    },
    "webTelemetry_adwalls_day_macos": {
        "description": "Daily bucketed count of adwall detections across all sites. Fired by the eventHub feature at the end of each 1-day period.",

    "debug_web_extension_reload_failed": {
        "description": "Fires when unloading or loading a web extension context fails during a reload. Parameters distinguish the reload trigger, failed phase, extension type, and original/underlying error domains and codes.",
        "owners": ["mallexxx"],
        "triggers": ["exception"],
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            "web_extension_type",
            "web_extension_reload_trigger",
            "web_extension_reload_phase",
            "errorDomain",
            "errorCode",
            "underlyingErrorDomain",
            "underlyingErrorCode"
        ]
    },
    "web_extension_enabled_macos": {
        "description": "Fires when a disabled extension is turned back on, from Settings → Extensions or the debug menu. Bundled extensions never fire it.",
        "owners": ["ayoy"],
        "triggers": ["user_interaction"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "web_extension_disabled_macos": {
        "description": "Fires when an enabled extension is turned off: by the user in Settings → Extensions or the debug menu, or by remote configuration, which also fires web_extension_remotely_disabled_macos. Bundled extensions never fire it.",
        "owners": ["ayoy"],
        "triggers": ["user_interaction", "feature_lifecycle"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "web_extension_details_opened_macos": {
        "description": "Fires when the user opens an installed extension's details from its menu in Settings → Extensions.",
        "owners": ["ayoy"],
        "triggers": ["user_interaction"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "web_extension_get_clicked_macos": {
        "description": "Fires when the user clicks Get on a catalog extension in Settings → Extensions, which opens its Chrome Web Store page.",
        "owners": ["ayoy"],
        "triggers": ["user_interaction"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "web_extension_publisher_link_clicked_macos": {
        "description": "Fires when the user clicks an extension's publisher in Settings → Extensions, which opens the publisher's site.",
        "owners": ["jleandroperez"],
        "triggers": ["user_interaction"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "web_extension_retained_14d_macos": {
        "description": "Fires once per Chrome Web Store installation, on the first tab switch or page navigation at least 14 days after it was installed, when the extension is still installed and enabled. Together with web_extension_churned_14d_macos it covers every installation made while the store catalog was available, so retained / (retained + churned) is the 14-day retention rate. Updates keep the original install date.",
        "owners": ["ayoy"],
        "triggers": ["user_interaction", "page_load"],
        "suffixes": [],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "web_extension_churned_14d_macos": {
        "description": "Fires once per Chrome Web Store installation, on the first tab switch or page navigation at least 14 days after it was installed, when the extension was removed or is turned off, including by remote configuration. See web_extension_retained_14d_macos.",
        "owners": ["ayoy"],
        "triggers": ["user_interaction", "page_load"],
        "suffixes": [],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "web_extension_remotely_disabled_macos": {
        "description": "Fires when remote configuration (extensionManagement disabledExtensionIds, or a catalog extension's feature flag) turns off an installed, enabled extension. The user can't turn it back on while it stays listed.",
        "owners": ["ayoy"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "web_extension_installed_count_macos": {
        "description": "Fires once a day, on the first tab switch or page navigation, while the Chrome Web Store catalog is available, with how many Chrome Web Store extensions are installed and how many of those are enabled. Bundled extensions are not counted. Every device that can install from the store reports, zero included, so it is the denominator for adoption.",
        "owners": ["ayoy"],
        "triggers": ["user_interaction", "page_load"],
        "suffixes": ["daily"],
        "parameters": ["appVersion", "pixelSource", "web_extension_count", "web_extension_enabled_count", "channel"]
    },
    "web_extension_toolbar_clicked_macos": {
        "description": "Fires when the user clicks an extension's toolbar button and the click performs its action, such as opening its popup. A click that closes the open popup, or on a disabled action, doesn't fire it.",
        "owners": ["ayoy"],
        "triggers": ["user_interaction"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "web_extension", "channel"]
    },
    "web_extension_cpm_breakage": {
        "description": "A tab stayed silent: after an http(s) page committed with the extension loaded, the extension sent no dashboard refresh from that tab for 30 seconds of app time (the app being suspended does not count). A refresh that arrives later still counts as an answer, so slow answers are not reported; a refresh saying the extension cannot answer (no configuration or settings) does not count as one. Evaluated when a tab event or an extension refresh arrives, so a tab left idle until the app exits is not reported. Pages that cannot run the extension (browser error pages, history restores from cache, restored sessions, non-HTML documents such as PDFs and images, non-http(s) pages) are not measured. Uses dailyAndCount: the first report of the day sends daily and count requests, later ones send count only. Daily estimates affected installations per day; count measures silent tabs. No URL, tab or document identifier is sent.",
        "owners": ["mallexxx"],
        "triggers": ["feature_lifecycle", "exception"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "tabs",
                "type": "string",
                "enum": ["one", "many"],
                "description": "Whether this was the only tab silent since the extension last answered (one), or another tab was silent too, before or in the same check (many)."
            }
        ],
        "suffixes": ["daily_count"]
    },
    "web_extension_cpm_breakage_persistent": {
        "description": "A second tab stayed silent (see web_extension_cpm_breakage) with no answering dashboard refresh from the extension in any tab since the first silent tab was reported. Sent once per such series; any answering refresh or an embedded extension reload ends the series, and a relaunch resets it. Uses dailyAndCount: the first report of the day sends daily and count requests, later ones send count only. Daily estimates installations with persistent breakage per day, the success metric; count measures series. No parameters beyond the standard ones; no URL, tab or document identifier is sent.",
        "owners": ["mallexxx"],
        "triggers": ["feature_lifecycle", "exception"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    }
}

// Voice entry point pixels for Duck.ai voice chat
{
    "m_aichat_voice_entry_point_tapped": {
        "description": "Fires when user taps a voice entry point button to open Duck.ai voice mode",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "source",
                "type": "string",
                "description": "The entry point source where the user tapped the voice button. address_bar covers the iPad address bar and Unified Input; duck_ai is New voice chat on a Duck.ai page; menu_bar is New Voice Chat in the iPad menu bar; duck_ai_chat is the chat input's voice button in a Duck.ai chat with messages, continuing that chat. Before duck_ai existed, both reported ntp.",
                "enum": [
                    "ntp",
                    "toolbar",
                    "address_bar",
                    "widget.controlcenter",
                    "widget.lockscreen.complication",
                    "widget.quickactions",
                    "widget.quickactions.medium",
                    "siri",
                    "duck_ai",
                    "menu_bar",
                    "duck_ai_chat"
                ]
            }
        ]
    },
    "m_aichat_voice_session_started": {
        "description": "Fires when the native layer receives a voiceSessionStarted bridge message from the Duck.ai frontend, indicating a voice session has actually begun",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "in_current_chat",
                "type": "boolean",
                "description": "true when the session continues the chat open in the tab, after the chat input's voice button asked Duck.ai to (startVoiceSession with inCurrentChat); false for a new voice chat"
            }
        ]
    },
    "aichat_voice_in_chat_unavailable_tapped": {
        "description": "Fires when the user taps the voice button in a Duck.ai chat with messages while Duck.ai says voice can't continue that chat. Nothing starts; the app shows Duck.ai's reason",
        "owners": ["aataraxiaa"],
        "triggers": ["user_interaction"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "reason",
                "type": "string",
                "description": "Why Duck.ai says voice can't continue the chat: it has files, it's on an encrypted model, or it has content voice can't use (such as an attached page)",
                "enum": ["files", "encryptedModel", "unsupportedContent"]
            }
        ]
    }
}

// See https://app.asana.com/1/137249556945/project/1209825025475019/task/1211054087327709
{
    m_ios_debug_user_script_load_js_failed: {
        description: 'Fired when BrowserServicesKit fails to load the contents of a Javascript file, to help investigate the cause of the failure.',
        owners: ['rachelmcr'],
        triggers: ['other'],
        suffixes: ['platform', 'form_factor'],
        parameters: [
            'appVersion',
            'pixelSource',
            'errorCode',
            'errorDomain',
            'underlyingErrorCode',
            'underlyingErrorDomain',
            {
                key: 'jsFile',
                description: 'Name of the JS file that failed to load.',
                type: 'string',
            },
            {
                key: 'path',
                description: 'Path to the JS file that failed to load.',
                type: 'string',
            },
        ],
    },
}

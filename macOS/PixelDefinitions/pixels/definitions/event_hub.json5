        "triggers": ["other"],
        "parameters": [
            "appVersion",
            {
                "key": "adwallCount",
                "type": "string",
                "description": "Bucketed count for the period (\"0\", \"1\", \"2-3\", \"4-7\", \"8-14\", \"15-20\", \"21-39\", \"40+\")",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "key": "attributionPeriod",
                "type": "integer",
                "description": "Unix timestamp (UTC) denoting the start of the measurement period"
            }
        ]
    },

// Fire Window configuration pixels
{
    "m_mac_daily_active_user_d": {
        "description": "Daily pixel indicating active user",
        "owners": ["jotaemepereira"],
        "triggers": ["scheduled"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_default-browser": {
        "description": "Daily pixel fired when DuckDuckGo is set as the default browser",
        "owners": ["miasma13"],
        "triggers": ["scheduled"],
        "suffixes": ["daily"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_non-default-browser": {
        "description": "Daily pixel fired when DuckDuckGo is not set as the default browser",
        "owners": ["miasma13"],
        "triggers": ["scheduled"],
        "suffixes": ["daily"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_added-to-dock": {
        "description": "Daily pixel fired when DuckDuckGo is added to the dock",
        "owners": ["miasma13"],
        "triggers": ["scheduled"],
        "suffixes": ["daily"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_not-added-to-dock": {
        "description": "Daily pixel fired when DuckDuckGo is not added to the dock",
        "owners": ["miasma13"],
        "triggers": ["scheduled"],
        "suffixes": ["daily"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "other_distribution_installed_macos": {
        "description": "Daily pixel reporting whether the other distribution of the browser (App Store for DMG builds, DMG for App Store builds) is installed in /Applications",
        "owners": ["jotaemepereira"],
        "privacyReview": ["https://app.asana.com/0/0/1220490277131209/f"],
        "triggers": ["startup"],
        "suffixes": ["daily"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "installed",
                "description": "Whether LaunchServices has an app in /Applications with the other distribution's bundle ID or its .debug, .review or .alpha variant",
                "type": "boolean"
            }
        ]
    }
}

// This file defines commonly used params - this does NOT mean they are added by default
// In your pixel definitions, you can reference these params by their key
// See TEMPLATE.json for an example
{
    "promptDaysSinceInstall": {
        "key": "days_since_install",
        "type": "string",
        "description": "Rolling 24-hour periods since install, grouped into install-week buckets.",
        "enum": ["d0_6", "d7_13", "d14_20", "d21_27", "d28_plus"]
    },
    "promptExposureVersion": {
        "key": "version",
        "type": "string",
        "description": "Version of the prompt exposure parameter meanings and session sampling rate.",
        "enum": ["1"]
    },
    "petal": {
        "key": "petal",
        "type": "string",
        "description": "Randomizes the timestamp used when processing the pixel.",
        "enum": ["randomize"]
    },
    "appVersion": {
        "key": "appVersion",
        "type": "string",
        "description": "",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
        "examples": ["7.175.1"]
    },
    "crashAppVersion": {
        "key": "appVersion",
        "type": "string",
        "description": "Version the crash happened on, with the build number from MetricKit appended.",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
        "examples": ["7.240.1.0", "7.240.1"]
    },
    "crashFirst": {
        "key": "first",
        "type": "string",
        "description": "Set to '1' when this is the first crash ever reported for this install",
        "enum": ["1"]
    },
    "crashCode": {
        "key": "code",
        "type": "string",
        "description": "MXCrashDiagnostic exception code; '-1' when unavailable"
    },
    "crashType": {
        "key": "type",
        "type": "string",
        "description": "MXCrashDiagnostic Mach exception type; '-1' when unavailable"
    },
    "crashSignal": {
        "key": "signal",
        "type": "string",
        "description": "MXCrashDiagnostic POSIX signal number; '-1' when unavailable"
    },
    "crashTerminationReason": {
        "key": "terminationReason",
        "type": "string",
        "description": "MXCrashDiagnostic termination reason reduced to '<namespace>_<code>', e.g. 'springboard_0x8badf00d' for a watchdog kill; '-1' when the crash has none, 'unknown' when it can't be parsed"
    },
    "ui_version": {
        "key": "ui_version",
        "type": "string",
        "description": "The version of the Sync settings and setup user interface.",
        "enum": ["v1", "v2"]
    },
    "unified_input_surface": {
        "key": "surface",
        "type": "string",
        "description": "The Unified Toggle Input surface the pixel was fired from, distinguishing the contextual chat sheet from the Duck.ai tab and the address bar.",
        "enum": ["address_bar", "duck_ai", "contextual_chat"]
    },
    "aichat_tab_picker_source": {
        "key": "source",
        "type": "string",
        "description": "Selector that was presented.",
        "enum": ["tab_picker", "mention"]
    },
    "aichat_tab_attachment_source": {
        "key": "source",
        "type": "string",
        "description": "Where the tab was originally selected, including when it is later removed through another control.",
        "enum": ["recent_tabs", "tab_picker", "mention"]
    },
    "usage_layout": {
        "key": "layout",
        "type": "string",
        "description": "Layout when the pixel fired: regular is the iPad tabs-bar layout (window 678pt or wider); compact is the phone layout, on every iPhone and on narrower iPad windows.",
        "enum": ["regular", "compact"]
    },
    "usage_hardware_keyboard": {
        "key": "hardware_keyboard",
        "type": "boolean",
        "description": "Whether a hardware keyboard was connected when the pixel fired."
    },
    "usage_window_mode": {
        "key": "window_mode",
        "type": "string",
        "description": "full_screen when the app window spans the screen width; partial for Split View, Slide Over or a narrower Stage Manager window. Always full_screen on iPhone.",
        "enum": ["full_screen", "partial"]
    },
    "aichat_prompt_source": {
        "key": "source",
        "type": "string",
        "description": "The door that opened the Duck.ai page the prompt was sent from, as an m_aichat_entry_point source value, set once when the page loads. A reload, back/forward or any other load without a door reports unattributed; Duck.ai's in-page New chat keeps the door.",
        "enum": [
            "address_bar_prompt",
            "address_bar_icon",
            "address_bar_shortcut_chip",
            "address_bar_editing_state",
            "suggestion_ask_ai",
            "ipad_toggle_prompt",
            "browsing_menu_ntp",
            "browsing_menu_webpage",
            "browsing_menu_duckai",
            "duck_ai_new_chat",
            "tab_switcher",
            "tabs_bar_button",
            "new_tab_long_press_menu",
            "chat_history_new_chat",
            "chat_history_open_chat",
            "chat_history_view_all",
            "voice",
            "onboarding",
            "subscription_onboarding",
            "paid_settings",
            "direct_url",
            "serp",
            "icon_shortcut",
            "contextual_chat",
            "widget_quick_actions",
            "widget_quick_actions_medium",
            "widget_favorite",
            "widget_lock_screen",
            "widget_control_center",
            "siri",
            "deep_link_other",
            "return_to_chat_card",
            "tab_switcher_existing_chat",
            "ddg_homepage",
            "tabs_bar_existing_chat",
            "unattributed"
        ]
    },
    "aichat_prompt_surface": {
        "key": "surface",
        "type": "string",
        "description": "Where the chat is shown: address_bar when the address bar handed the prompt to the Duck.ai page, contextual_chat for any prompt in the Ask about page sheet, otherwise duck_ai.",
        "enum": ["address_bar", "duck_ai", "contextual_chat"]
    },
    "aichat_menu_source": {
        "key": "source",
        "type": "string",
        "description": "Which button opened the Duck.ai menu: address_bar or the iPad tabs_bar_button. Absent before the tabs-bar button was told apart.",
        "enum": ["address_bar", "tabs_bar_button"]
    },
    "aichat_first_prompt_new_install": {
        "key": "first_prompt_new_install",
        "type": "boolean",
        "description": "Present (true) only when this submission is the first Duck.ai prompt ever submitted on a brand-new install. Omitted on every later submission. Installs that predate this parameter are excluded at launch (their existing install statistics pre-mark the flag), so updating users never report it."
    },
    "unified_input_page_type": {
        "key": "page_type",
        "type": "string",
        "description": "The page the user was on when submitting through the Unified Toggle Input, one value per case of the UnifiedToggleInputPromptPageType Swift enum. `contextual` is the contextual chat sheet; `unknown` is a submission whose page could not be resolved, e.g. no current tab.",
        "enum": ["ntp", "serp", "website", "duck_ai", "contextual", "unknown"]
    },
    "cookie_popup_preference": {
        "key": "cookie_popup_preference",
        "type": "string",
        "description": "The resulting Cookie Pop-up Protection preference after the user confirms the opt-in dialog",
        "enum": ["max", "default", "off"]
    },
    "autoconsent_enabled": {
        "key": "autoconsent_enabled",
        "type": "boolean",
        "description": "Whether Cookie Pop-up Protection (autoconsent) was enabled at the moment the pixel fired"
    },
    "time_since_shown": {
        "key": "time_since_shown",
        "type": "string",
        "description": "Bucketed time elapsed from when the opt-in dialog was first shown to when it was confirmed",
        "enum": ["0-1min", "1-5min", "5-60min", "1h-1d", "1d+"]
    },
    "atb": {
        "key": "atb",
        "type": "string",
        "pattern": "v[0-9]{1,3}-[0-7]([a-z]{2})?",
        "description": "Add to browser value, corresponding to the users install week and day"
    },
    "pixelSource": {
        "key": "pixelSource",
        "type": "string",
        "description": "The channel the user is on",
        "enum": ["phone", "tablet"]
    },
    "subscriptionAuthSource": {
        "key": "source",
        "type": "string",
        "description": "The legacy app component identifier for the process that encountered the subscription authentication event",
        "enum": ["MainApp", "SysExt"]
    },
    "subscriptionAuthTokenCachePolicy": {
        "key": "policycache",
        "type": "string",
        "description": "The token cache policy used by the failed token request",
        "enum": ["Local", "Local valid", "Local force refresh", "Create if needed"]
    },
    "errorDomain": {
        "key": "d",
        "type": "string",
        "description": "NSError code domain",
        "examples": ["NSURLErrorDomain"]
    },
    "errorCode": {
        "key": "e",
        "type": "integer",
        "description": "NSError code",
        "examples": [-1009, 42]
    },
    "fromExtension": {
        "key": "fromExtension",
        "description": "0 when fired from UserScript (web extensions available but autoconsent extension not loaded), 1 when fired from the web extension",
        "type": "integer",
        "enum": [0, 1]
    },
    "consentHeuristicEnabled": {
        "key": "consentHeuristicEnabled",
        "description": "The mode of the consent heuristic feature: '', off, reject, tier1, tier2",
        "type": "string",
        "enum": ["", "off", "reject", "tier1", "tier2"]
    },
    "isInternalUser": {
        "key": "is_internal_user",
        "description": "Whether the user is flagged as internal.  Should ONLY be sent with \"true\" value",
        "type": "boolean",
        "enum": [true]
    },
    "underlyingErrorCode": {
        "keyPattern": "^ue[0-9]?$",
        "type": "integer",
        "description": "Underlying NSError code",
        "examples": [-1009, 42]
    },
    "underlyingErrorDomain": {
        "keyPattern": "^ud[0-9]?$",
        "type": "string",
        "description": "Underlying NSError code domain",
        "examples": ["NSURLErrorDomain"]
    },
    "wideEventAppName": {
        "key": "app.name",
        "type": "string",
        "description": "The name of the app sending the pixel",
        "enum": ["DuckDuckGo", "PacketTunnelProvider"]
    },
    "wideEventAppVersion": {
        "key": "app.version",
        "type": "string",
        "description": "The version of the app sending the pixel"
    },
    "wideEventPlatform": {
        "key": "global.platform",
        "type": "string",
        "description": "The name of the platform that the app is running on",
        "enum": ["iOS"]
    },
    "wideEventType": {
        "key": "global.type",
        "type": "string",
        "description": "The type of software sending the wide pixel",
        "enum": ["app"]
    },
    "wideEventFormFactor": {
        "key": "app.form_factor",
        "type": "string",
        "description": "The form factor of the current device",
        "enum": ["phone", "tablet"]
    },
    "wideEventSampleRate": {
        "key": "global.sample_rate",
        "type": "number",
        "description": "Sample rate for this pixel, between 0 and 1"
    },
    "wideEventMetaVersion": {
        "key": "meta.version",
        "type": "string",
        "description": "Schema version of the wide event (MAJOR.MINOR.PATCH format)",
        "pattern": "^[1-9]\\d*\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "wideEventIsFirstDailyOccurrence": {
        "key": "global.is_first_daily_occurrence",
        "type": "boolean",
        "description": "Whether this is the first occurrence of this wide event today. Only included when true."
    },
    "wideEventFeatureStatus": {
        "key": "feature.status",
        "type": "string",
        "description": "Final status of the wide event flow",
        "enum": ["SUCCESS", "FAILURE", "CANCELLED", "UNKNOWN"]
    },
    "wideEventFeatureStatusReason": {
        "key": "feature.data.ext.status_reason",
        "type": "string",
        "description": "Optional reason accompanying the feature status"
    },
    "wideEventErrorDomain": {
        "key": "feature.data.ext.error.domain",
        "type": "string",
        "description": "Error domain for the failure, when applicable, e.g. SKErrorDomain"
    },
    "wideEventErrorCode": {
        "key": "feature.data.ext.error.code",
        "type": "integer",
        "description": "Error code for the failure, when applicable"
    },
    "wideEventUnderlyingErrorDomain": {
        "keyPattern": "^feature\\.data\\.ext\\.error\\.underlying_domain[0-9]?$",
        "type": "string",
        "description": "Underlying error domain (supports optional numeric index for nested errors)"
    },
    "duration": {
        "key": "duration",
        "type": "integer",
        "description": "Duration in milliseconds",
        "examples": [1500, 3200]
    },
    "navigation_type": {
        "key": "navigation_type",
        "type": "string",
        "description": "Type of navigation that triggered the loading",
        "enum": [
            "linkActivated",
            "formSubmitted",
            "formResubmitted",
            "backForward",
            "reload",
            "redirect",
            "sessionRestoration",
            "alternateHtmlLoad",
            "sameDocumentNavigation",
            "other",
            "custom.userEnteredUrl",
            "custom.loadedByStateRestoration",
            "custom.appOpenUrl",
            "custom.historyEntry",
            "custom.bookmark",
            "custom.ui",
            "custom.link",
            "custom.webViewUpdated",
            "custom.userRequestedPageDownload",
            "custom.unknown"
        ]
    },
    "wideEventUnderlyingErrorCode": {
        "keyPattern": "^feature\\.data\\.ext\\.error\\.underlying_code[0-9]?$",
        "type": "integer",
        "description": "Underlying error code (supports optional numeric index for nested errors)"
    },
    "dbpDataBroker": {
        "key": "data_broker",
        "type": "string",
        "description": "Name of the data broker involved in the opt-out attempt or action"
    },
    "dbpParentBroker": {
        "key": "parent",
        "type": "string",
        "description": "Parent data broker of the entity targeted by the opt-out attempt"
    },
    "dbpAttemptId": {
        "key": "attempt_id",
        "type": "string",
        "description": "Client-generated identifier of the opt-out attempt"
    },
    "dbpBrokerVersion": {
        "key": "broker_version",
        "type": "string",
        "description": "Version of the broker JSON file used for the flow"
    },
    "dbpIsAuthenticated": {
        "key": "isAuthenticated",
        "type": "boolean",
        "description": "Whether the user is authenticated"
    },
    "dbpIsFreeScan": {
        "key": "free_scan",
        "type": "boolean",
        "description": "Whether this is a free (unauthenticated) scan"
    },
    "dbpStageDuration": {
        "key": "duration",
        "type": "integer",
        "description": "Stage duration in milliseconds"
    },
    "dbpStageTries": {
        "key": "tries",
        "type": "string",
        "description": "Number of tries it took to complete the stage"
    },
    "dbpActionId": {
        "key": "action_id",
        "type": "string",
        "description": "Identifier of the broker action executed during the broker flow"
    },
    "dbpActionType": {
        "key": "action_type",
        "type": "string",
        "description": "Type of action executed during the broker flow",
        "enum": [
            "extract",
            "navigate",
            "fillForm",
            "click",
            "expectation",
            "emailConfirmation",
            "generateEmail",
            "getEmailData",
            "getCaptchaInfo",
            "solveCaptcha",
            "condition",
            "executeScript",
            "unknown"
        ]
    },
    "dbpActionDuration": {
        "key": "duration",
        "type": "integer",
        "description": "Duration of the broker action execution in milliseconds"
    },
    "dbpActionTries": {
        "key": "tries",
        "type": "integer",
        "description": "Number of tries it took for the broker action to complete"
    },
    "dbpAttemptDuration": {
        "key": "duration",
        "type": "number",
        "description": "Total duration of the opt-out attempt in milliseconds"
    },
    "dbpAwakeDuration": {
        "key": "awake_duration",
        "type": "number",
        "description": "Total duration excluding machine sleep in milliseconds"
    },
    "dbpConfirmationAttemptNumber": {
        "key": "attempt_number",
        "type": "integer",
        "description": "Confirmation attempt ordinal (1..3)"
    },
    "dbpFeatureDataBrokerVersion": {
        "key": "feature.data.ext.data_broker_version",
        "type": "string",
        "description": "Version of the broker JSON file reported via wide pixels"
    },
    "vpnSubscriptionActive": {
        "key": "vpnSubscriptionActive",
        "type": "string",
        "description": "Whether the VPN subscription is active",
        "enum": ["true", "false", "no_subscription"]
    },
    "vpnNotificationObjectClass": {
        "key": "notificationObjectClass",
        "type": "string",
        "description": "Class name of the object that originated the subscription notification"
    },
    "vpnLatencyLocation": {
        "key": "location",
        "type": "string",
        "description": "Location selection for the VPN latency test",
        "enum": ["nearest", "custom"]
    },
    "connectionAttemptSource": {
        "key": "source",
        "type": "string",
        "description": "The origin of a VPN connection attempt",
        "enum": ["start", "rekey", "serverChange", "locationChange", "adapterRestart", "failureRecovery", "serverMigration"]
    },
    "burnSource": {
        "key": "source",
        "type": "string",
        "description": "Source of the burn action",
        "enum": ["browsing", "tabSwitcher", "settings", "quickFire", "deeplink", "autoClear", "escapeHatch"]
    },
    "aiChatSelectionCount": {
        "key": "selection_count",
        "type": "string",
        "description": "Bucketed number of text selections attached to a submitted Duck.ai prompt. Bounded by the 5-selection cap",
        "enum": ["1", "2", "3-5"]
    },
    "aiChatPageContextOfferReason": {
        "key": "offer_reason",
        "type": "string",
        "description": "Why Duck.ai offered to attach the current page: navigation means the user moved to another page while a contextual chat was active; detached means the user had just removed the page from the input",
        "enum": ["navigation", "detached"]
    },
    "aiChatPromptDepthBucket": {
        "key": "depth_bucket",
        "type": "string",
        "description": "Bucketed position of a prompt within its Duck.ai contextual chat: 1 is the chat's first prompt, 2 its second, and so on",
        "enum": ["1", "2", "3-5", "6-10", "11+"]
    },
    "aiChatHadUnsubmittedSelections": {
        "key": "had_unsubmitted_selections",
        "type": "boolean",
        "description": "Whether text selections were still attached, and so never asked about, when the Duck.ai contextual sheet was dismissed"
    },
    "tabType": {
        "key": "tabType",
        "type": "string",
        "description": "Type of tab when burn was initiated",
        "enum": ["web", "ai", "unknown"]
    },
    "is_enabled": {
        "key": "is_enabled",
        "type": "boolean",
        "description": "Whether the feature or setting is enabled"
    },
    "returningUser": {
        "key": "ru",
        "type": "boolean",
        "description": "Whether the user is a returning user (reinstall)"
    },
    "freeTrial": {
        "key": "free_trial",
        "type": "boolean",
        "description": "Whether the user is eligible for a free trial"
    },
    "subscriptionFunnelOrigin": {
        "key": "origin",
        "type": "string",
        "description": "Funnel that led the user to a subscription pixel — encodes the entry-point and platform. Must match a case's raw value in `SubscriptionFunnelOrigin` (iOS/DuckDuckGo/Subscription/SubscriptionFunnelOrigin.swift); never an ad-campaign or marketing-attribution origin.",
        "enum": [
            "funnel_onboarding_ios",
            "funnel_modal_ios__skippedonboardingupsell",
            "funnel_modal_ios__subscriptionnudge",
            "funnel_appsettings_ios",
            "funnel_appmenu_ios",
            "funnel_addressbar_ios__modelpicker",
            "funnel_addressbar_ios__reasoningdropdown",
            "funnel_duckai_ios__modelpicker",
            "funnel_duckai_ios__reasoningdropdown",
            "funnel_duckai_ios__freelabel",
            "funnel_addressbar_ios__usagelimit",
            "funnel_duckai_ios__usagelimit",
            "funnel_duckai_ios__aisidebar",
            "funnel_duckai_ios__activatesubscription",
            "funnel_duckai_ios__freelimit",
            "funnel_duckai_ios__imagegenerationlimit",
            "funnel_duckai_ios__pluslimit",
            "funnel_duckai_ios__promotioncard",
            "funnel_duckai_ios__settings",
            "funnel_duckai_ios__disclaimerbanner",
            "funnel_duckai_ios__voicechatlimit",
            "funnel_duckai_ios__voicechatdurationlimit",
            "funnel_applaunch_ios_winback",
            "funnel_appsettings_ios_winback",
            "funnel_alert_ios__subscriptionvpnrevoked",
            "funnel_toolbar_ios__subscriptionvpn",
            "funnel_addressbar_ios__subscriptionvpn",
            "funnel_widget_ios__subscriptionvpn",
            "funnel_integration_ios_shortcut_subscriptionvpn",
            "funnel_notification_ios__subscriptionvpn"
        ]
    },
    "subscriptionPageOrigin": {
        "key": "origin",
        "type": "string",
        "description": "Origin from the subscription page URL, sent as-is. Can include web-defined origins in addition to the `subscriptionFunnelOrigin` values.",
        "pattern": "^funnel_",
        "examples": ["funnel_appmenu_ios", "funnel_appsettings_ios", "funnel_onboarding_ios", "funnel_appsettings_ios_winback"]
    },
    "locale": {
        "key": "locale",
        "type": "string",
        "description": "User locale",
        "examples": ["en-US", "hu-HU"]
    },
    "browsingMode": {
        "key": "browsing_mode",
        "type": "string",
        "description": "The current browsing mode: fire (Fire Tabs) or normal",
        "enum": ["fire", "normal"]
    },
    "durationSeconds": {
        "key": "dur",
        "type": "string",
        "description": "Duration in seconds (as a floating-point string)"
    },
    "onboardingEventType": {
        "key": "event",
        "type": "string",
        "description": "Event type to classify what happened at each onboarding step",
        "enum": ["shown", "clicked", "confirmed"]
    },
    "onboardingClickedValue": {
        "key": "value",
        "type": "string",
        "description": "Whether the user clicked the primary CTA or skipped/closed the onboarding step",
        "enum": ["engage", "dismiss"]
    },
    "onboardingInstallType": {
        "key": "installType",
        "type": "string",
        "description": "Install type to distinguish between first-time installs and reinstalls during onboarding",
        "enum": ["new", "reinstall"]
    },
    "onboardingDaysSinceInstall": {
        "key": "daysSinceInstall",
        "type": "string",
        "description": "Bucketed days since install during onboarding",
        "enum": ["0", "1-3", "4-10", "11-28", "28+"]
    },
    "onboardingSource": {
        "key": "source",
        "type": "string",
        "description": "User's entry point into the onboarding flow",
        "enum": ["default", "duckai_cpp"]
    },
    "onboardingFlow": {
        "key": "flow",
        "type": "string",
        "description": "Version of the onboarding flow the user entered",
        "enum": ["default", "duckai", "tailored_by_download_reason"]
    },
    "onboardingFlowVariant": {
        "key": "variant",
        "type": "string",
        "description": "Variant of the onboarding flow the user selected after branching (the 'Try a search or AI chat' step, or the download-reason screen)",
        "enum": [
            "search_plus_duckai-search",
            "search_plus_duckai-chat",
            "download_reason_search",
            "download_reason_ai-chat",
            "download_reason_no-ai",
            "download_reason_ad-blocking"
        ]
    },
    "tabCount": {
        "key": "tab_count",
        "type": "string",
        "description": "Bucketed total tab count.",
        "enum": ["1", "2-5", "6-10", "11-20", "21-40", "41-60", "61-80", "81+"]
    },
    "newTabCount": {
        "key": "new_tab_count",
        "type": "string",
        "description": "Bucketed count of tabs with no link (blank/new tab pages).",
        "enum": ["0-1", "2-10", "11+"]
    },
    "tabActive7d": {
        "key": "tab_active_7d",
        "type": "string",
        "description": "Bucketed count of tabs last viewed within the past 7 days.",
        "enum": ["0", "1-5", "6-10", "11-20", "21+"]
    },
    "tabInactive1w": {
        "key": "tab_inactive_1w",
        "type": "string",
        "description": "Bucketed count of tabs last viewed 8-14 days ago.",
        "enum": ["0", "1-5", "6-10", "11-20", "21+"]
    },
    "tabInactive2w": {
        "key": "tab_inactive_2w",
        "type": "string",
        "description": "Bucketed count of tabs last viewed 15-21 days ago.",
        "enum": ["0", "1-5", "6-10", "11-20", "21+"]
    },
    "tabInactive3w": {
        "key": "tab_inactive_3w",
        "type": "string",
        "description": "Bucketed count of tabs last viewed 22+ days ago.",
        "enum": ["0", "1-5", "6-10", "11-20", "21+"]
    },
    "extension_context_loaded": {
        "key": "context_loaded",
        "type": "boolean",
        "description": "Whether the CPM extension context was loaded when the failure was measured."
    },
    "background_view_alive": {
        "key": "bg_view_alive",
        "type": "boolean",
        "description": "Whether the current CPM background web view was alive."
    },
    "background_web_process_alive": {
        "key": "bg_process_alive",
        "type": "boolean",
        "description": "Whether the CPM background web process was alive."
    },
    "tab_known_to_webkit": {
        "key": "tab_in_context",
        "type": "boolean",
        "description": "Whether WebKit's extension context contained the failing tab."
    },
    "native_handler_registered": {
        "key": "handler_registered",
        "type": "boolean",
        "description": "Whether the CPM native-message handler was registered."
    },
    "tab_controller_matches_context": {
        "key": "tab_controller_match",
        "type": "boolean",
        "description": "Whether the tab and CPM context used the same web-extension controller."
    },
    "tab_has_extension_user_scripts": {
        "key": "tab_has_ext_scripts",
        "type": "boolean",
        "description": "Whether CPM extension user scripts remained registered on the tab."
    },
    "background_web_process_responsive": {
        "key": "bg_process_responsive",
        "type": "boolean",
        "description": "Whether WebKit reported the CPM background web process as responsive."
    },
    "background_events": {
        "key": "bg_events",
        "type": "string",
        "description": "Bounded, sanitized CPM lifecycle timeline, oldest first, including extension_updated (successful replacement of an installed CPM version, not first install or reload; latest update survives context reloads), base_url_changed (local comparison between context loads; no URL or identifier is sent), process death, graveyard hold/release, context unload and extension file removal failures with error descriptors, and interruption (the app resumed from background or system sleep; one event for both). Each token@age entry uses the first matching age bucket relative to the snapshot: 30s (<30s), 1m (<60s), 2m (<120s), 5m (<300s), 15m (<900s), over_15 (>=900s). Order and repeated events within a bucket are preserved; exact ages are not sent."
    },
    "background_load_error_app_state": {
        "key": "bg_load_error_app_state",
        "type": "string",
        "enum": ["active", "inactive", "background"],
        "description": "App state captured when the first newly observed WebKit error 6 was attributed to the affected background-load attempt. Only sent when that error is in the first-failure snapshot and state is known; macOS reports active/inactive. Errors observed after the first failure are not included in this episode. Not a generic app-state dimension."
    },
    "background_load_error_after": {
        "key": "bg_load_error_after",
        "type": "string",
        "enum": ["under_5s", "5s_to_25s", "25s_to_35s", "over_35s"],
        "description": "Time from the affected background view's creation to the first newly observed WebKit error 6 for that load attempt: <5 s, 5-<25 s, 25-<35 s, >=35 s. Only sent when the first-failure snapshot contains an attributed error 6 with known timing; cleared for a replacement view/context. Historical error-list entries and errors observed after the first failure do not qualify for the episode report."
    },
    "background_view_age": {
        "key": "bg_view_age",
        "type": "string",
        "enum": ["under_4s", "4s_to_8s", "8s_to_30s", "30s_to_2m", "over_2m"],
        "description": "Age of the current background view at the first failure: <4 s, 4-<8 s, 8-<30 s, 30-<120 s, >=120 s. Omitted when no current view exists."
    },
    "background_ready_after": {
        "key": "bg_ready_after",
        "type": "string",
        "enum": ["none", "pending", "failed", "under_1s", "1s_to_4s", "4s_to_10s", "10s_to_30s", "over_30s"],
        "description": "Background-load evidence frozen at the first failure. none means no current view and no attributed error 6 for the latest attempt. failed includes an attributed error 6 after its view disappears, until a new view/context resets attribution. pending means loading had not completed at the snapshot; it may complete or fail later. Load fields are not refreshed when the episode is reported, so later errors are omitted. Completion buckets: <1 s, 1-<4 s, 4-<10 s, 10-<30 s, >=30 s. Omitted when observation is disabled or unavailable; readiness does not prove initResp delivery."
    },
    "web_extension_type": {
        "key": "extension_type",
        "type": "string",
        "description": "Web extension type whose reload failed.",
        "enum": ["embedded", "darkMode", "adBlocking", "searchToken", "unknown"]
    },
    "web_extension_reload_trigger": {
        "key": "reload_trigger",
        "type": "string",
        "description": "Operation that initiated the failed web extension reload.",
        "enum": ["data_clearing", "scriptlet_update", "explicit", "cpm_messaging_hung"]
    },
    "web_extension_reload_phase": {
        "key": "reload_phase",
        "type": "string",
        "description": "Reload operation that failed.",
        "enum": ["unload", "load", "light_load", "full_load", "fallback_load"]
    },
    "eventHubAttributionPeriod": {
        "key": "attributionPeriod",
        "type": "integer",
        "description": "Unix timestamp (UTC seconds) denoting the start of the measurement period"
    },
    "eventHubBucketedCount": {
        "key": "count",
        "type": "string",
        "description": "Bucketed count for the period. Bucket boundaries are set by the eventHub remote config",
        "pattern": "^\\d+(-\\d+|\\+)?$"
    },
    "eventHubYouTubeLoginState": {
        "key": "loginState",
        "type": "string",
        "description": "The user's YouTube login state, as percent-encoded JSON, recorded as the last value seen during the period",
        "enum": ["%22unknown%22", "%22logged-in%22", "%22logged-out%22", "%22premium%22"]
    },
    "eventHubBaseline": {
        "key": "baseline",
        "type": "string",
        "description": "Bucketed count of periods in which EventHub ran. Bucket boundaries are set by the eventHub remote config",
        "pattern": "^\\d+(-\\d+|\\+)?$"
    },
    "eventHubAdwallCount": {
        "key": "adwallCount",
        "type": "string",
        "description": "Bucketed adwall detection count for the period. Bucket boundaries are set by the eventHub remote config",
        "pattern": "^\\d+(-\\d+|\\+)?$"
    },
    "eventHubAdmiralAdwallCount": {
        "key": "admiralAdwallCount",
        "type": "string",
        "description": "Bucketed Admiral-served adwall detection count for the period. Bucket boundaries are set by the eventHub remote config",
        "pattern": "^\\d+(-\\d+|\\+)?$"
    },
    "appLifecycleState": {
        "key": "state",
        "type": "string",
        "description": "iOS app state machine state (AppState.name)",
        "enum": ["initializing", "launching", "connected", "foreground", "background", "terminating", "simulated"]
    },
    "appLifecycleLaunchStep": {
        "key": "step",
        "type": "string",
        "description": "Last launch step reached, in launch order. ui-attached: never started entering the foreground (usually a background launch). entering-foreground: never became active. none: launch had not started",
        "enum": [
            "none",
            "launching-started",
            "key-value-store",
            "persistent-stores",
            "sync",
            "content-blocking",
            "main-coordinator",
            "launched",
            "window-connected",
            "ui-attached",
            "entering-foreground",
            "terminating"
        ]
    }
}

{
    "dataimport_directory-permission_prompt-screen_shown_macos": {
        "description": "Fired when the browser data directory read permission screen is shown to the user before importing (macOS 27+).",
        "owners": ["jleandroperez"],
        "triggers": ["other"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "source",
                "description": "The browser the user is importing data from",
                "type": "string",
                "enum": [
                    "brave",
                    "chrome",
                    "edge",
                    "firefox",
                    "opera",
                    "safari",
                    "fileImport",
                    "csv",
                    "bookmarksHTML",
                    "onePassword8",
                    "onePassword7",
                    "bitwarden",
                    "lastPass",
                    "other"
                ]
            }
        ]
    },
    "dataimport_directory-permission_granted_macos": {

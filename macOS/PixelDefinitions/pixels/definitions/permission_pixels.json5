// Permission management pixels
{
    "m_mac_permission_authorization": {
        "description": "Fired when user selects an option (Allow/Deny) in the permission authorization dialog",
        "owners": ["tomasstrba"],
        "triggers": ["other"],
        "suffixes": [
            {
                "description": "Permission type being requested",
                "enum": ["camera", "microphone", "geolocation", "popups", "notification", "external-scheme"]
            },
            {
                "description": "User's decision",
                "enum": ["allow", "deny"]
            }
        ],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_permission_center_changed": {
        "description": "Fired when user changes a permission decision in the Permission Center dropdown",
        "owners": ["tomasstrba"],
        "triggers": ["other"],
        "suffixes": [
            {
                "description": "Permission type being changed",
                "enum": ["camera", "microphone", "geolocation", "popups", "notification", "external-scheme", "autoplay-policy"]
            },
            {
                "description": "Literal 'to' separator",
                "enum": ["to"]
            },
            {
                "description": "New decision value",
                "enum": ["ask", "allow", "deny"]
            }
        ],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "from",
                "type": "string",
                "enum": ["ask", "allow", "deny"],
                "description": "Previous decision value before the change"
            }
        ]
    },
    "m_mac_permission_center_reset": {
        "description": "Fired when user clicks the remove (X) button to reset a permission in the Permission Center",
        "owners": ["tomasstrba"],
        "triggers": ["other"],
        "suffixes": [
            {
                "description": "Permission type being reset",
                "enum": ["camera", "microphone", "geolocation", "popups", "notification", "external-scheme", "autoplay-policy"]
            }
        ],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "m_mac_permission_system_preferences": {
        "description": "Fired when user clicks the link to open System Preferences/Settings for a permission",
        "owners": ["tomasstrba"],
        "triggers": ["other"],
        "suffixes": [
            {
                "description": "Permission type for which System Preferences is opened",
                "enum": ["camera", "microphone", "geolocation", "notification"]
            }
        ],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "permission_settings_detail": {
        "description": "Fired when user opens a permission category's detail page in Settings > Website Permissions, from the overview or a deep link",
        "owners": ["andremartingo"],
        "triggers": ["other"],
        "suffixes": [
            {
                "description": "Permission category whose detail page is opened",
                "enum": ["camera", "microphone", "geolocation", "popups", "notification", "external-scheme", "autoplay-policy"]
            },
            {
                "description": "Platform marker",
                "enum": ["macos"]
            }
        ],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "permission_settings_default": {
        "description": "Fired when user changes a permission category's default decision in Settings > Website Permissions",
        "owners": ["andremartingo"],
        "triggers": ["other"],
        "suffixes": [
            {
                "description": "Permission category whose default is changed",
                "enum": ["camera", "microphone", "geolocation", "popups", "notification", "external-scheme", "autoplay-policy"]
            },
            {
                "description": "New default decision. Only autoplay offers 'allow'",
                "enum": ["ask", "allow", "deny"]
            },
            {
                "description": "Platform marker",
                "enum": ["macos"]
            }
        ],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "permission_settings_site_changed": {
        "description": "Fired when user changes a site's decision in Settings > Website Permissions, from Recents or a detail page",
        "owners": ["andremartingo"],
        "triggers": ["other"],
        "suffixes": [
            {
                "description": "Permission type being changed",
                "enum": ["camera", "microphone", "geolocation", "popups", "notification", "external-scheme", "autoplay-policy"]
            },
            {
                "description": "Literal 'to' separator",
                "enum": ["to"]
            },
            {
                "description": "New decision value",
                "enum": ["ask", "allow", "deny"]
            },
            {
                "description": "Platform marker",
                "enum": ["macos"]
            }
        ],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "permission_settings_removed": {
        "description": "Fired when user removes a site's decision in Settings > Website Permissions, from Recents or a detail page",
        "owners": ["andremartingo"],
        "triggers": ["other"],
        "suffixes": [
            {
                "description": "Permission type being removed",
                "enum": ["camera", "microphone", "geolocation", "popups", "notification", "external-scheme", "autoplay-policy"]
            },
            {
                "description": "Platform marker",
                "enum": ["macos"]
            }
        ],
        "parameters": ["appVersion", "pixelSource", "channel"]
    }
}

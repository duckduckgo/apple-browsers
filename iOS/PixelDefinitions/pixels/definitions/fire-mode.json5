{
    // MARK: - Promotion Pixels

    "m_fire-mode_ntp-promotion_shown": {
        "description": "Fired when the Fire Mode NTP promotion card is displayed to the user",
        "owners": ["hassaanelgarem"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },

    "m_fire-mode_ntp-promotion_dismissed": {
        "description": "Fired when the user dismisses the Fire Mode NTP promotion card",
        "owners": ["hassaanelgarem"],
        "triggers": ["user_submitted"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },

    "m_fire-mode_ntp-promotion_engaged": {
        "description": "Fired when the user taps the CTA on the Fire Mode NTP promotion card",
        "owners": ["hassaanelgarem"],
        "triggers": ["user_submitted"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },

    "m_fire-mode_menu-promotion_shown": {
        "description": "Fired when the Fire Mode promotion row is displayed in the browsing menu",
        "owners": ["hassaanelgarem"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },

    "m_fire-mode_menu-promotion_engaged": {
        "description": "Fired when the user taps the Fire Mode promotion row in the browsing menu",
        "owners": ["hassaanelgarem"],
        "triggers": ["user_submitted"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },

    // MARK: - Mode Switching

    "m_fire-mode_switched": {
        "description": "Fired when the user switches between fire and normal browsing modes",
        "owners": ["hassaanelgarem"],
        "triggers": ["user_submitted"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            "browsingMode",
            {
                "key": "source",
                "description": "The UI element used to switch modes",
                "type": "string",
                "enum": [
                    "tab_switcher_toggle",
                    "tab_switcher_swipe",
                    "long_press_tabs_icon",
                    "menu_promotion",
                    "ntp_promotion",
                    "long_press_link",
                    "browsing_menu"
                ]
            }
        ]
    },

    // MARK: - Empty State

    "m_fire-mode_empty-state_new-tab": {
        "description": "Fired when the user taps 'New Fire Tab' from the Fire Mode empty state in the tab switcher",
        "owners": ["hassaanelgarem"],
        "triggers": ["user_submitted"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    }
}

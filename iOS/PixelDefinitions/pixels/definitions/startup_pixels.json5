{
    "m_debug_app-did-show-ui-time-2-": {
        "description": "Fires on app launch with the duration it took for the UI to become visible.",
        "owners": ["jaceklyp", "bwaresiak"],
        "triggers": ["startup"],
        "suffixes": ["time_bucket", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "time",
                "description": "Duration time",
                "type": "number"
            }
        ]
    },
    "m_keyboard_settings_on_new_tab_enabled": {
        "description": "Fires daily to measure the status of the \"Show keyboard on new tab\" setting",
        "owners": ["Bunn"],
        "triggers": ["startup"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "is_enabled",
                "description": "Whether the keyboard on new tab setting is enabled",
                "type": "boolean"
            }
        ]
    },
    "m_keyboard_settings_on_app_launch_enabled": {
        "description": "Fires daily to measure the status of the \"Show keyboard on app launch\" setting",
        "owners": ["Bunn"],
        "triggers": ["startup"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "is_enabled",
                "description": "Whether the keyboard on app launch setting is enabled",
                "type": "boolean"
            }
        ]
    },
    "m_keyboard_on_app_launch_used": {
        "description": "Fires daily and count when the app is launched and the keyboard is shown due to the \"Show keyboard on app launch\" setting being enabled",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_debug_content-blocking-compilation-failed-missing-tmp-dir": {
        "description": "Fires when content blocking compilation is aborted due to missing temp directory",
        "owners": ["jaceklyp"],
        "triggers": ["startup"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"],
        "expires": "2025-11-08"
    },
    "m_debug_tmp-dir-still-missing-after-recreation": {
        "description": "Fires when temp directory is still missing after recreation during app startup",
        "owners": ["jaceklyp"],
        "triggers": ["startup"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "isBackground",
                "description": "Whether the app was in background state when the check was performed",
                "type": "boolean"
            }
        ],
        "expires": "2025-11-08"
    },
    "m_d_app_delegate_init_to_launch_time": {
        "description": "Time between AppDelegate init and didFinishLaunching to detect iOS prewarming",
        "owners": ["jaceklyp"],
        "triggers": ["startup"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "time_diff",
                "description": "Time difference between AppDelegate init and didFinishLaunching",
                "type": "number"
            }
        ],
        "expires": "2025-12-08"
    },
    "m_debug_shared_secure_vault_init_failed": {
        "description": "Fires when shared SecureVault failed to initialize at app startup",
        "owners": ["jaceklyp"],
        "triggers": ["startup"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion", "errorCode", "errorDomain", "underlyingErrorCode", "underlyingErrorDomain"]
    },
    "m_debug_scene-will-connect-to-window-called-in-connected-state": {
        "description": "Fires when willConnectToWindow is called while already in the Connected state, indicating an unexpected consecutive scene connection. The windowChanged parameter indicates whether the window instance changed between calls.",
        "owners": ["jaceklyp"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "windowChanged",
                "description": "Whether the window instance changed between consecutive willConnectToWindow calls",
                "type": "boolean"
            }
        ]
    },
    "app-lifecycle_active-without-main-ui": {
        "description": "Fires when a scene becomes active but none of its visible windows shows app UI (the MainViewController, or the authentication or blank snapshot overlay shown over it), meaning the user sees a black screen. Measures user impact of a scene reconnecting while the app is still in the Connected state during launch.",
        "owners": ["hassaanelgarem"],
        "triggers": ["other"],
        "suffixes": ["daily", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "app-lifecycle_scene-did-disconnect": {
        "description": "Fires when iOS disconnects the app's scene (sceneDidDisconnect). The state parameter tells which app state machine state the app was in, to find what triggers scene reconnects during launch.",
        "owners": ["hassaanelgarem"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "state",
                "description": "App state machine state when the scene disconnected",
                "enum": ["initializing", "launching", "connected", "foreground", "background", "terminating", "simulated"]
            }
        ]
    },
    "app-lifecycle_previous-launch-incomplete": {
        "description": "Fires at launch when the previous launch never reached the Foreground or Background state, e.g. a black screen the user had to force quit, a hang, or a kill or crash during launch. step tells the last launch step that launch reached.",
        "owners": ["hassaanelgarem"],
        "triggers": ["startup"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "step",
                "description": "Last launch step the previous launch reached, in launch order",
                "enum": [
                    "launching-started",
                    "key-value-store",
                    "persistent-stores",
                    "sync",
                    "content-blocking",
                    "main-coordinator",
                    "launched",
                    "window-connected",
                    "ui-attached",
                    "terminating"
                ]
            }
        ]
    },
    "app-lifecycle_critical-alert-shown": {
        "description": "Fires when the app shows a critical alert before terminating because a store could not be loaded at launch.",
        "owners": ["hassaanelgarem"],
        "triggers": ["startup"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "reason",
                "description": "Why the alert was shown",
                "enum": ["insufficient-disk-space", "unrecoverable-state"]
            }
        ]
    }
}

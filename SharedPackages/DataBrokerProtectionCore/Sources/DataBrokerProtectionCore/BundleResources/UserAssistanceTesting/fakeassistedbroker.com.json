{
  "name": "DDG Fake Assisted Broker",
  "url": "fakeassistedbroker.com",
  "version": "0.1.0",
  "steps": [
    {
      "stepType": "scan",
      "scanType": "templatedUrl",
      "actions": [
        {
          "actionType": "navigate",
          "url": "http://localhost:3001/search.html?fname=${firstName}&lname=${lastName}&city=${city}&state=${state|upcase}&age=${age}",
          "id": "fab-scan-navigate"
        },
        {
          "actionType": "extract",
          "selector": ".profile-card",
          "noResultsSelector": "//p[contains(text(), 'No Results Found')]",
          "profile": {
            "name": {
              "selector": ".profile-card__name",
              "beforeText": ", "
            },
            "age": {
              "selector": ".profile-card__name",
              "afterText": ", "
            },
            "addressCityState": {
              "selector": ".profile-card__address"
            },
            "profileUrl": {
              "identifierType": "hash"
            }
          },
          "id": "fab-scan-extract"
        }
      ]
    },
    {
      "stepType": "optOut",
      "optOutType": "formOptOut",
      "actions": [
        {
          "actionType": "navigate",
          "step": "Entering your name",
          "url": "http://localhost:3001/optout.html",
          "id": "fab-optout-navigate"
        },
        {
          "actionType": "expectation",
          "step": "Entering your name",
          "expectations": [{ "type": "element", "selector": "#optout-form" }],
          "id": "fab-optout-form"
        },
        {
          "actionType": "fillForm",
          "step": "Entering your name",
          "selector": "#optout-form",
          "dataSource": "userProfile",
          "elements": [
            { "type": "firstName", "selector": "//input[@name='fname']" },
            { "type": "lastName", "selector": "//input[@name='ln']" }
          ],
          "id": "fab-optout-fill"
        },
        {
          "actionType": "userAssist",
          "step": "Searching for your record",
          "handOffAfterMs": 3000,
          "highlight": "#captcha-widget",
          "completeWhen": [
            { "type": "element", "selector": "//form[@id='optout-form']//input[@name='cf-turnstile-response' and @value != '']" }
          ],
          "id": "fab-optout-turnstile"
        },
        {
          "actionType": "click",
          "step": "Searching for your record",
          "elements": [
            { "type": "button", "selector": "//button[@aria-label='search-optout-button' and @type='submit']" }
          ],
          "id": "fab-optout-search"
        },
        {
          "actionType": "expectation",
          "step": "Selecting your record",
          "expectations": [{ "type": "element", "selector": "#result-filter" }],
          "id": "fab-optout-results"
        },
        {
          "actionType": "click",
          "step": "Selecting your record",
          "elements": [{ "type": "button", "selector": "//button[contains(text(), 'Opt Out')]" }],
          "id": "fab-optout-select"
        },
        {
          "actionType": "expectation",
          "step": "Selecting your record",
          "expectations": [{ "type": "element", "selector": "#additional-fields-form" }],
          "id": "fab-optout-additional-form"
        },
        {
          "actionType": "userAssist",
          "step": "Prove you’re human",
          "highlight": "#captcha-widget",
          "completeWhen": [{ "type": "element", "selector": "//iframe[@data-hcaptcha-response != '']" }],
          "id": "fab-optout-hcaptcha"
        },
        {
          "actionType": "click",
          "step": "Review and submit",
          "elements": [{ "type": "button", "selector": "input[type='checkbox']" }],
          "id": "fab-optout-agree"
        },
        {
          "actionType": "userAssist",
          "step": "Review and submit",
          "highlight": "#additional-fields-form .additional-footer",
          "completeWhen": [{ "type": "element", "selector": "//h1[contains(@class, 'comprehensive-confirm-title')]" }],
          "id": "fab-optout-review"
        },
        {
          "actionType": "expectation",
          "step": "Review and submit",
          "expectations": [{ "type": "text", "selector": "body", "expect": "Your optout request was submitted." }],
          "id": "fab-optout-submitted"
        }
      ]
    }
  ],
  "schedulingConfig": {
    "retryError": 48,
    "confirmOptOutScan": 72,
    "maintenanceScan": 120,
    "maxAttempts": -1
  },
  "addedDatetime": 1725632531153
}

// Privacy Pro AuthV2 diagnostic pixels
{
    "m_mac_store_privacy-pro_auth_account_automatically_signed_out": {
        "description": "Fired after Privacy Pro automatically signs a user out because the backend reported an unknown account or an invalid refresh token that could not be recovered (App Store distribution). Low-cardinality local state captured before deletion helps distinguish expected backend invalidation from client token races or inconsistent account state.",
        "owners": ["samsymons"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            "subscriptionAuthSource",
            "subscriptionAuthTokenCachePolicy",
            "errorDomain",
            "errorCode",
            "underlyingErrorDomain",
            "underlyingErrorCode",
            "subscriptionAutoSignOutRecoveryOutcome",
            "subscriptionAutoSignOutBackupOutcome",
            "subscriptionAutoSignOutHadSubscriptionEntitlementsBefore",
            "subscriptionAutoSignOutAccessTokenTimeRemainingBucketBefore",
            "subscriptionAutoSignOutRefreshTokenTimeRemainingBucketBefore",
            "subscriptionAutoSignOutRefreshTokenAgeBucketBefore",
            "subscriptionAutoSignOutCachedSubscriptionStatusBefore",
            "subscriptionAutoSignOutCachedSubscriptionTrialStatusBefore",
            "subscriptionAutoSignOutCachedSubscriptionPurchasePlatformBefore",
            "subscriptionAutoSignOutCachedSubscriptionTimeRemainingBucketBefore",
            "subscriptionAutoSignOutStoredRefreshTokenStateDuringAttempt",
            "subscriptionAutoSignOutLocalTokenStateAfterSignOut"
        ]
    },
    "m_mac_direct_privacy-pro_auth_account_automatically_signed_out": {
        "description": "Fired after Privacy Pro automatically signs a user out because the backend reported an unknown account or an invalid refresh token that could not be recovered (direct distribution). Low-cardinality local state captured before deletion helps distinguish expected backend invalidation from client token races or inconsistent account state.",
        "owners": ["samsymons"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            "subscriptionAuthSource",
            "subscriptionAuthTokenCachePolicy",
            "errorDomain",
            "errorCode",
            "underlyingErrorDomain",
            "underlyingErrorCode",
            "subscriptionAutoSignOutRecoveryOutcome",
            "subscriptionAutoSignOutBackupOutcome",
            "subscriptionAutoSignOutHadSubscriptionEntitlementsBefore",
            "subscriptionAutoSignOutAccessTokenTimeRemainingBucketBefore",
            "subscriptionAutoSignOutRefreshTokenTimeRemainingBucketBefore",
            "subscriptionAutoSignOutRefreshTokenAgeBucketBefore",
            "subscriptionAutoSignOutCachedSubscriptionStatusBefore",
            "subscriptionAutoSignOutCachedSubscriptionTrialStatusBefore",
            "subscriptionAutoSignOutCachedSubscriptionPurchasePlatformBefore",
            "subscriptionAutoSignOutCachedSubscriptionTimeRemainingBucketBefore",
            "subscriptionAutoSignOutStoredRefreshTokenStateDuringAttempt",
            "subscriptionAutoSignOutLocalTokenStateAfterSignOut"
        ]
    },
    // Already shipped without a definition; recovery_method is new
    "m_mac_store_privacy-pro_auth_invalid_refresh_token_recovered": {
        "description": "Fired when the main app recovers the session after the auth server rejected the refresh token, so the user stays signed in (App Store distribution)",
        "owners": ["federicocappelli"],
        "triggers": ["other"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel", "subscriptionTokenRecoveryMethod"]
    },
    // Already shipped without a definition; recovery_method is new
    "m_mac_direct_privacy-pro_auth_invalid_refresh_token_recovered": {
        "description": "Fired when the main app recovers the session after the auth server rejected the refresh token, so the user stays signed in (direct distribution)",
        "owners": ["federicocappelli"],
        "triggers": ["other"],
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel", "subscriptionTokenRecoveryMethod"]
    }
}

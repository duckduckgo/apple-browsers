{
    "fire_animation-completed": {
        "description": "Fires when an animation finishes naturally for an accepted manual burn, whether clearing finished before it or is still running. Excludes disabled or unavailable animations, interrupted playback and dropped burns. The count leg is the denominator for the fraction of burns outlasting their animation; the daily leg counts devices with an animated burn. Daily parameters describe the first occurrence that day, so use count events for parameter breakdowns.",
        "owners": ["brindy"],
        "expires": "2027-01-20",
        "triggers": ["feature_lifecycle"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "scope",
                "description": "Scope of the accepted manual burn",
                "type": "string",
                "enum": ["tab", "fire_mode", "normal_mode", "all"]
            },
            {
                "key": "source",
                "description": "Where the accepted manual burn was requested",
                "type": "string",
                "enum": ["browsing", "escapeHatch", "tabSwitcher", "settings", "quickFire", "deeplink", "autoClear", "chatSuggestions"]
            },
            {
                "key": "animation",
                "description": "The animation that finished playing",
                "type": "string",
                "enum": ["fireRising", "fireRisingLegacy", "waterSwirl", "airstream"]
            },
            {
                "key": "burn_in_progress",
                "description": "Whether this burn is still running when its animation finishes",
                "type": "boolean"
            }
        ]
    },
    "fire_burn-outlasted-animation": {
        "description": "Fires immediately when an accepted manual burn is still running after its animation finishes naturally, including burns that never complete. The daily leg counts affected devices; the count leg counts occurrences. Compare with fire_animation-completed on matching app versions and form factors. Daily parameters describe the first occurrence that day.",
        "owners": ["brindy"],
        "expires": "2027-01-20",
        "triggers": ["feature_lifecycle"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "scope",
                "description": "Scope of the accepted manual burn",
                "type": "string",
                "enum": ["tab", "fire_mode", "normal_mode", "all"]
            },
            {
                "key": "source",
                "description": "Where the accepted manual burn was requested",
                "type": "string",
                "enum": ["browsing", "escapeHatch", "tabSwitcher", "settings", "quickFire", "deeplink", "autoClear", "chatSuggestions"]
            },
            {
                "key": "animation",
                "description": "The animation that finished playing",
                "type": "string",
                "enum": ["fireRising", "fireRisingLegacy", "waterSwirl", "airstream"]
            }
        ]
    },
    "fire_post-animation-burn-completed": {
        "description": "Fires when a manual burn that outlasted its naturally completed animation eventually returns. Reports bucketed wall time from animation completion to burn return, including any time spent in the background. Does not fire for burns that never return; use fire_burn-outlasted-animation to include those.",
        "owners": ["brindy"],
        "expires": "2027-01-20",
        "triggers": ["feature_lifecycle"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "scope",
                "description": "Scope of the accepted manual burn",
                "type": "string",
                "enum": ["tab", "fire_mode", "normal_mode", "all"]
            },
            {
                "key": "source",
                "description": "Where the accepted manual burn was requested",
                "type": "string",
                "enum": ["browsing", "escapeHatch", "tabSwitcher", "settings", "quickFire", "deeplink", "autoClear", "chatSuggestions"]
            },
            {
                "key": "animation",
                "description": "The animation that finished playing",
                "type": "string",
                "enum": ["fireRising", "fireRisingLegacy", "waterSwirl", "airstream"]
            },
            {
                "key": "elapsed",
                "description": "Upper-inclusive bucketed seconds from animation completion until the burn returned; more means over 300 seconds",
                "type": "string",
                "enum": ["1", "5", "10", "30", "60", "120", "300", "more"]
            }
        ]
    },

    "m_fire_retrigger_in_20s": {
        "description": "Fired when the fire button is triggered again within 20 seconds of a previous fire",
        "owners": ["hanyutang-sandra"],
        "triggers": ["user_submitted"],
        "suffixes": ["daily_standard", "platform", "form_factor"],
        "parameters": ["appVersion", "pixelSource"]
    },

    "fire_burn-dropped": {
        "description": "Fires when the user triggers a burn while another burn is still in progress, so the request is dropped.",
        "owners": ["hassaanelgarem"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "trigger",
                "description": "What asked for the dropped burn",
                "type": "string",
                "enum": ["manual_fire", "auto_clear_on_launch", "auto_clear_on_foreground", "fire_mode_auto_clear"]
            },
            {
                "key": "scope",
                "description": "What the dropped burn would have cleared",
                "type": "string",
                "enum": ["tab", "fire_mode", "normal_mode", "all"]
            },
            {
                "key": "elapsed",
                "description": "Bucketed seconds the in-progress burn had been running when this request was dropped",
                "type": "string",
                "enum": ["1", "5", "10", "30", "60", "120", "300", "more"]
            }
        ]
    },

    "m_fire_user_action_before_completion": {
        "description": "Fired when user performs an action before the clearing operation completes",
        "owners": ["hanyutang-sandra"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion", "pixelSource"]
    },

    "app-switcher_snapshot_clearing_failed": {
        "description": "Fired once per cleanup attempt when app-switcher snapshot clearing fails for a reason other than a missing directory or item. Error parameters describe the first failure",
        "owners": ["bkunat"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": ["appVersion", "pixelSource", "errorCode", "errorDomain", "underlyingErrorCode", "underlyingErrorDomain"]
    },

    "m_fire_clear_website_data_remove_all_containers_after_delay_success": {
        "description": "Fired when website data container cleanup after delay completes successfully",
        "owners": ["hanyutang-sandra"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion"]
    },

    "m_fire_clear_website_data_remove_all_containers_after_delay_failure": {
        "description": "Fired when website data container cleanup after delay fails",
        "owners": ["hanyutang-sandra"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion", "errorCode", "errorDomain", "underlyingErrorCode", "underlyingErrorDomain"]
    },

    "m_settings_fire_button_selector_pressed": {
        "description": "Fires when the user selects a fire animation type in settings",
        "owners": ["brindy", "alessandroboron"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "fireAnimationType",
                "description": "The fire animation type selected by the user",
                "type": "string",
                "enum": ["fireRising", "fireRisingLegacy", "waterSwirl", "airstream", "none"]
            }
        ]
    },

    "data-clearing_all-tabs-time-": {
        "description": "Fires when website data clearing completes for an all-tabs (full scope) burn, reporting how long the operation took. Tracked separately from the single-tab timing.",
        "owners": ["hassaanelgarem"],
        "triggers": ["other"],
        "suffixes": ["time_bucket", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },

    "fire_warmup-navigation_timed-out": {
        "description": "Fired when the hidden WebKit warm-up page loaded at the start of a data clearing operation does not report back before its deadline. The burn stops waiting and continues, rather than hanging indefinitely and blocking every later Fire button press until the app is relaunched",
        "owners": ["hassaanelgarem"],
        "triggers": ["other"],
        "suffixes": ["daily_standard", "platform", "form_factor"],
        "parameters": ["appVersion", "pixelSource"]
    },

    "data-clearing_single-tab-time-": {
        "description": "Fires when website data clearing completes for a single-tab (limited scope) burn, reporting how long the operation took. Tracked separately from the all-tabs timing because clearing a single tab must enumerate and selectively delete per-domain, making it inherently slower.",
        "owners": ["hassaanelgarem"],
        "triggers": ["other"],
        "suffixes": ["time_bucket", "platform", "form_factor"],
        "parameters": ["appVersion"]
    }
}

{
    "startup_failure_macos": {
        "description": "A known startup failure prevents the app from becoming usable. Sent once per failure episode; further failures are suppressed until a successful startup.",
        "owners": ["diegoreymendez"],
        "triggers": ["exception"],
        "parameters": [
            "appVersion",
            "channel",
            {
                "key": "originalPixelTimestamp",
                "type": "string",
                "description": "ISO 8601 timestamp of the original failed send. Present only when PixelKit replays a persisted pixel.",
                "examples": ["2026-10-31T13:00:00Z"]
            },
            {
                "key": "retriedPixel",
                "type": "string",
                "description": "Marks a replay from PixelKit's persistent retry queue. Absent on the original send.",
                "enum": ["1"]
            }
        ]
    },
    "startup_failure_returned_macos": {
        "description": "The first launch attempt after a recorded startup failure. The attempt can still fail; it does not close the failure episode.",
        "owners": ["diegoreymendez"],
        "triggers": ["startup"],
        "parameters": [
            "appVersion",
            "channel",
            {
                "key": "days_since_first_failure",
                "type": "string",
                "description": "Whole elapsed 24-hour periods since the episode's first failure. 7+ caps all later returns; unknown covers a clock moving backwards. The bucket contains no exact failure time.",
                "enum": ["0", "1", "2", "3", "4", "5", "6", "7+", "unknown"]
            },
            {
                "key": "originalPixelTimestamp",
                "type": "string",
                "description": "ISO 8601 timestamp of the original failed send. Present only when PixelKit replays a persisted pixel.",
                "examples": ["2026-10-31T13:00:00Z"]
            },
            {
                "key": "retriedPixel",
                "type": "string",
                "description": "Marks a replay from PixelKit's persistent retry queue. Absent on the original send.",
                "enum": ["1"]
            }
        ]
    },
    "startup_failure_recovered_macos": {
        "description": "Launch completes and an active, visible browser window is available after a recorded startup failure. Sent once, closing the episode and allowing a subsequent failure to start a new one.",
        "owners": ["diegoreymendez"],
        "triggers": ["startup"],
        "parameters": [
            "appVersion",
            "channel",
            {
                "key": "days_count",
                "type": "integer",
                "description": "Lower bound of the bucket for whole days from the first startup failure to recovery. 21 covers 21 days or more. Omitted if elapsed time cannot be calculated.",
                "enum": [0, 1, 3, 5, 8, 13, 21]
            },
            {
                "key": "originalPixelTimestamp",
                "type": "string",
                "description": "ISO 8601 timestamp of the original failed send. Present only when PixelKit replays a persisted pixel.",
                "examples": ["2026-10-31T13:00:00Z"]
            },
            {
                "key": "retriedPixel",
                "type": "string",
                "description": "Marks a replay from PixelKit's persistent retry queue. Absent on the original send.",
                "enum": ["1"]
            }
        ]
    }
}

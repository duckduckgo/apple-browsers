{
    "manifest_version": 3,
    "name": "DuckDuckGo Search Token",
    "description": "Attaches the DuckDuckGo search experiment token to search navigations.",
    "version": "1.0.0",
    "minimum_chrome_version": "122.0",
    "browser_specific_settings": {
        "duckduckgo": {
            "id": "com.duckduckgo.web-extension.search-token",
            "appleRequiresExtraction": true
        }
    },
    "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess", "nativeMessaging"],
    "host_permissions": ["https://duckduckgo.com/*"],
    "commands": {
        "refresh-token": { "description": "Refresh the search token DNR rule" }
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    }
}

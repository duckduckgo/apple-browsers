{
    "m_aichat_settings_auto_context_enabled": {
        "description": "Fired when the user enables automatic page context attachment in AI Chat settings",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_settings_auto_context_disabled": {
        "description": "Fired when the user disables automatic page context attachment in AI Chat settings",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_sheet_opened": {
        "description": "Fired when the AI Chat contextual sheet is presented to the user",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_sheet_dismissed": {
        "description": "Fired when the user dismisses the AI Chat contextual sheet",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_expand_button_tapped": {
        "description": "Fired when the user taps the expand button to open full AI Chat mode from the contextual sheet",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_new_chat_button_tapped": {
        "description": "Fired when the user taps the new chat button in the contextual sheet",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_quick_action_summarize_selected": {
        "description": "Fired when the user selects the summarize quick action chip in the contextual sheet",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_page_context_auto_attached": {
        "description": "Fired when page context is automatically attached to an AI Chat prompt (auto-context setting enabled)",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_page_context_updated_on_navigation": {
        "description": "Fired when page context is updated after navigating to a different page while contextual sheet is open",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_page_context_manually_attached_native": {
        "description": "Fired when the user manually attaches page context via the native attach button",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_page_context_manually_attached_frontend": {
        "description": "Fired when the user manually attaches page context via the frontend attach button",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_page_context_removed_native": {
        "description": "Fired when the user removes page context via the native context chip remove button",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_page_context_removed_frontend": {
        "description": "Fired when the user removes page context via the frontend UI",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_prompt_submitted_with_context_native": {
        "description": "Fired when the user submits a prompt with page context attached via the native input",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_prompt_submitted_without_context_native": {
        "description": "Fired when the user submits a prompt without page context via the native input",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_session_restored": {
        "description": "Fired when an AI Chat contextual session is restored after a cold start",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_fire_button_tapped": {
        "description": "Fired when the user taps the fire button in the AI Chat contextual sheet",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_fire_button_confirmed": {
        "description": "Fired when the user confirms chat deletion from the fire button confirmation in the AI Chat contextual sheet",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_page_context_collection_empty": {
        "description": "Fired when page context collection runs but returns no usable content (empty title, content, favicon, and fullContentLength)",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_page_context_collection_unavailable": {
        "description": "Fired when page context collection cannot proceed because the user script is not available",
        "owners": ["aataraxiaa"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_auto_attach_dau": {
        "description": "Daily pixel fired on foreground to record the state of the contextual auto-attach setting",
        "owners": ["aataraxiaa"],
        "triggers": ["startup"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion", "is_enabled"]
    },
    "m_aichat_contextual_quick_action_ask_about_page_shown": {
        "description": "Fired when the Ask about page quick action chip is shown to the user in the contextual sheet",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_quick_action_ask_about_page_selected": {
        "description": "Fired when the user selects the Ask about page quick action chip in the contextual sheet",
        "owners": ["SabrinaTardio"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_recent_chats_popup_displayed": {
        "description": "Fired when the recent chats popup is displayed in the contextual sheet",
        "owners": ["SabrinaTardio"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_recent_chat_selected": {
        "description": "Fired when the user selects a chat from the recent chats popup in the contextual sheet",
        "owners": ["SabrinaTardio"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_view_all_chats_tapped": {
        "description": "Fired when the user taps View all chats in the recent chats popup to open duck.ai in a new tab",
        "owners": ["SabrinaTardio"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "aichat_contextual_suggestion_selected": {
        "description": "Fired when the user taps a suggested-prompt chip on the contextual sheet start surface. Under contextualSuggestedPrompts this also represents the Ask about page quick action, which additionally fires the legacy m_aichat_contextual_quick_action_ask_about_page_selected pixel.",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "suggestionId",
                "description": "Catalog key of the selected suggestion (e.g. summarize-page, translate-page, ask-about-page).",
                "type": "string"
            },
            {
                "key": "pageType",
                "description": "Coarse page-type bucket computed natively from page-type signals. Never a URL, domain or page content.",
                "type": "string",
                "enum": [
                    "recipe",
                    "product",
                    "article",
                    "video",
                    "job",
                    "book",
                    "event",
                    "place",
                    "forum",
                    "code",
                    "course",
                    "review",
                    "person",
                    "howto",
                    "faq",
                    "none"
                ]
            }
        ]
    },
    "aichat_contextual_suggestions_viewed": {
        "description": "Fired when the contextual sheet start surface renders suggested-prompt chips to the user; every render (sheet presentation or navigation re-resolve) counts as an impression",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "isSmart",
                "description": "Whether the shown suggestions were smart (page-tailored) rather than generic defaults.",
                "type": "boolean"
            },
            {
                "key": "pageType",
                "description": "Coarse page-type bucket computed natively from page-type signals. Never a URL, domain or page content.",
                "type": "string",
                "enum": [
                    "recipe",
                    "product",
                    "article",
                    "video",
                    "job",
                    "book",
                    "event",
                    "place",
                    "forum",
                    "code",
                    "course",
                    "review",
                    "person",
                    "howto",
                    "faq",
                    "none"
                ]
            }
        ]
    },
    "aichat_contextual_header_title_tapped": {
        "description": "Fired when the user taps the Duck.ai title in the contextual sheet header to expand into full AI Chat",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "debug_aichat_contextual_suggestions_catalog_load_failed": {
        "description": "Fired when the bundled PageSuggestionsCatalog.json is missing or fails to decode and the suggested-prompts matcher falls back to the single Summarize this page floor",
        "owners": ["pikorddg"],
        "triggers": ["exception"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "debug_aichat_contextual_suggestions_context_collection_timed_out": {
        "description": "Fired when page-type signal collection times out and contextual suggested prompts fall back to generic defaults",
        "owners": ["pikorddg"],
        "triggers": ["exception"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_selection_action": {
        "description": "Fired when the user picks one of the Duck.ai actions from the text-selection edit menu. The source parameter says which one",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion", "aiChatSelectionSource"]
    },
    "m_aichat_contextual_selection_limit_reached": {
        "description": "Fired when the user asks Duck.ai about selected text but the maximum number of selections is already attached, so the new one is refused",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_contextual_prompt_submitted_with_selections": {
        "description": "Fired when the user submits a Duck.ai prompt with at least one text selection attached. The selection_count parameter says how many. Distinct from the with/without-context pixels, which describe page context only",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion", "aiChatSelectionCount"]
    },
    "m_aichat_contextual_selection_removed": {
        "description": "Fired when the user removes an attached text selection via its chip's remove button",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    }
}

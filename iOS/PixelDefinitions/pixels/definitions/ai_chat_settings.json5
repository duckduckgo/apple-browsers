{
    "m_aichat_history_delete_successful": {
        "description": "Fired when Duck.ai chat history is deleted successfully via fire button",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "source",
                "description": "Where the delete came from.",
                "enum": ["fire_button", "auto_clear", "multi_select", "delete_all"]
            },
            {
                "key": "retried",
                "description": "Whether the Duck.ai web data clear was retried once after a transient failure.",
                "enum": ["true", "false"]
            },
            {
                "key": "first_attempt_error_code",
                "type": "integer",
                "minimum": 2,
                "maximum": 7,
                "description": "Sent only when the clear was retried: why the first attempt failed. 2-6 as the com.duckduckgo.aiChatDataClearing codes in m_aichat_history_delete_failed, 7 page failed to load (WebKit or URL loading error)."
            }
        ]
    },
    "m_aichat_history_delete_failed": {
        "description": "Fired when Duck.ai chat history fails to be deleted (single chat, multi-select, or delete-all). The error parameters identify the failure cause (e.g. no storage space). When the Duck.ai web data clear fails, errorDomain is com.duckduckgo.aiChatDataClearing and errorCode is: 1 clearing script unavailable, 2 script listening but no reply, 3 script reported a failure (underlyingErrorDomain com.duckduckgo.aiChatDataClearing.script, underlyingErrorCode = stage 100 localStorage / 200 IndexedDB / 300 unexpected + error name 1 UnknownError, 2 QuotaExceededError, 3 InvalidStateError, 4 AbortError, 5 NotFoundError, 6 VersionError, 7 DataError, 8 TransactionInactiveError, 9 SecurityError, 10 TypeError, 11 SyntaxError; 0 when the script sends no reason), 4 script never became ready, 5 page never finished loading, 6 web content process terminated. The clear is retried once before failing.",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "source",
                "description": "Where the delete came from.",
                "enum": ["fire_button", "auto_clear", "multi_select", "delete_all"]
            },
            "errorDomain",
            "errorCode",
            "underlyingErrorDomain",
            "underlyingErrorCode",
            {
                "key": "retried",
                "description": "Whether the Duck.ai web data clear was retried once after a transient failure.",
                "enum": ["true", "false"]
            },
            {
                "key": "first_attempt_error_code",
                "type": "integer",
                "minimum": 2,
                "maximum": 7,
                "description": "Sent only when the clear was retried: why the first attempt failed. 2-6 as the com.duckduckgo.aiChatDataClearing codes in m_aichat_history_delete_failed, 7 page failed to load (WebKit or URL loading error)."
            }
        ]
    },
    "m_aichat_settings_chat_suggestions_turned_on": {
        "description": "Fired when the user enables Chat Suggestions in AI Chat settings",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_settings_chat_suggestions_turned_off": {
        "description": "Fired when the user disables Chat Suggestions in AI Chat settings",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_settings_navigation_bar_turned_on": {
        "description": "Fired when the user enables the Navigation Bar shortcut in AI Chat settings",
        "owners": ["jotaemepereira"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_settings_navigation_bar_turned_off": {
        "description": "Fired when the user disables the Navigation Bar shortcut in AI Chat settings",
        "owners": ["jotaemepereira"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "m_aichat_single_delete_successful": {
        "description": "Fired when a single AI chat is deleted successfully",
        "owners": ["hassaanelgarem"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "retried",
                "description": "Whether the Duck.ai web data clear was retried once after a transient failure.",
                "enum": ["true", "false"]
            },
            {
                "key": "first_attempt_error_code",
                "type": "integer",
                "minimum": 2,
                "maximum": 7,
                "description": "Sent only when the clear was retried: why the first attempt failed. 2-6 as the com.duckduckgo.aiChatDataClearing codes in m_aichat_history_delete_failed, 7 page failed to load (WebKit or URL loading error)."
            }
        ]
    },
    "m_aichat_single_delete_failed": {
        "description": "Fired when a single AI chat deletion fails. The error parameters identify the cause (codes as in m_aichat_history_delete_failed).",
        "owners": ["hassaanelgarem"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            "errorDomain",
            "errorCode",
            "underlyingErrorDomain",
            "underlyingErrorCode",
            {
                "key": "retried",
                "description": "Whether the Duck.ai web data clear was retried once after a transient failure.",
                "enum": ["true", "false"]
            },
            {
                "key": "first_attempt_error_code",
                "type": "integer",
                "minimum": 2,
                "maximum": 7,
                "description": "Sent only when the clear was retried: why the first attempt failed. 2-6 as the com.duckduckgo.aiChatDataClearing codes in m_aichat_history_delete_failed, 7 page failed to load (WebKit or URL loading error)."
            }
        ]
    },
    "m_aichat_is_enabled_daily": {
        "description": "Daily pixel fired on foreground to record whether AI Chat is enabled or disabled for the user",
        "owners": ["aataraxiaa"],
        "triggers": ["startup"],
        "suffixes": ["platform", "form_factor"],
        "parameters": ["appVersion", "is_enabled"]
    },
    "m_aichat_settings_default_toggle_position_changed": {
        "description": "Fired when the user changes the default toggle position setting in AI Features settings",
        "owners": ["jaceklyp"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "value",
                "description": "The selected default toggle position: search, duckAI, or lastUsed",
                "type": "string"
            }
        ]
    },
    "aichat_settings_state": {
        "description": "Daily snapshot of the Duck.ai settings, mirroring macOS aichat_settings_state_macos. Fired when the app leaves the foreground rather than on launch, because the hardware keyboard only registers shortly after launch; triggers is other because no value covers moving to the background. The per-setting pixels only cover users who change a setting; this sizes each setting's base and the share of iPad users in narrow windows or with a hardware keyboard.",
        "owners": ["jaceklyp"],
        "triggers": ["other"],
        "suffixes": ["daily", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            { "key": "duckai_enabled", "description": "Whether Duck.ai is enabled in AI Features settings.", "type": "boolean" },
            {
                "key": "addressbar_toggle",
                "description": "Whether the Search/Duck.ai toggle is shown in the address bar.",
                "type": "boolean"
            },
            {
                "key": "tabbar_button",
                "description": "Whether the iPad tabs bar offers a Duck.ai button: the shortcut is available on this device, the Tab Bar setting is on and the user hasn't hidden the button. The tabs bar only shows in the regular layout. Always false on iPhone.",
                "type": "boolean"
            },
            {
                "key": "default_mode",
                "description": "Which address-bar mode the app starts in: search, duckAI, or the last used one. Same values as default_mode on m_aichat_unified_input_*.",
                "type": "string",
                "enum": ["search", "duckAI", "lastUsed"]
            },
            {
                "key": "duckai_tabs_open",
                "description": "How many Duck.ai tabs are open, bucketed.",
                "type": "string",
                "enum": ["0", "1", "2+"]
            },
            "usage_layout",
            "usage_window_mode",
            "usage_hardware_keyboard"
        ]
    }
}

{
  "name": "Clustal",
  "url": "clustal.org",
  "version": "0.4.1",
  "addedDatetime": 1790913600000,
  "optOutUrl": "https://www.clustal.org/privacy-control/",
  "steps": [
    {
      "stepType": "scan",
      "scanType": "templatedUrl",
      "actions": [
        {
          "_comment": "robots.txt, not a site page: the site's pages send a CSP without 'unsafe-eval', which stops executeScript on Windows. robots.txt sends none and is same-origin, so the script's relative link still works.",
          "actionType": "navigate",
          "url": "https://www.clustal.org/robots.txt",
          "id": "bdfd96e9-72f4-4a89-a377-d304f2bcdade"
        },
        {
          "_comment": "Fails on Cloudflare's block page, so the wall is labelled in telemetry. Keyed on body, since robots.txt has no title.",
          "actionType": "expectation",
          "expectations": [
            {
              "type": "element",
              "selector": "//body[not(//title[contains(., 'Attention Required')])]"
            }
          ],
          "id": "26e1fae5-ca2d-4665-9497-77854ad2eb06"
        },
        {
          "actionType": "executeScript",
          "script": "// Adds a link to clustal.org's results page for the profile, for the next\n// click action to follow. The site's own search builds\n// /people-search/<surname initial>/<first>-<last>/<state>/, and no URL\n// template transform can take the surname's first letter.\n//\n// Called as function (userProfile, root) with the default dataSource,\n// userProfile, and root as robots.txt.\n\n// Slugs a name the way the site's name suggestions do: lowercase, accents\n// stripped, a-z only. \"O'Brien\" becomes \"obrien\", \"García\" becomes \"garcia\".\nfunction slug(name) {\n  return (name || \"\")\n    .normalize(\"NFD\")\n    .replace(/[̀-ͯ]/g, \"\")\n    .toLowerCase()\n    .replace(/[^a-z]/g, \"\");\n}\n\nconst first = slug(userProfile.firstName);\nconst last = slug(userProfile.lastName);\nconst state = (userProfile.state || \"\").toLowerCase();\n\n// Without all three there is no valid URL. Adding no link makes the click\n// fail and name this script's link, rather than searching the wrong page.\nif (first && last && state) {\n  const link = root.createElement(\"a\");\n  link.id = \"ddg-pir-results\";\n  link.textContent = \"results\";\n  link.href = `/people-search/${last[0]}/${first}-${last}/${state}/`;\n  (root.body || root.documentElement).appendChild(link);\n}\n",
          "id": "72ee67ee-bd6a-4a93-ba42-fa766909a948"
        },
        {
          "actionType": "click",
          "elements": [
            {
              "type": "button",
              "selector": "#ddg-pir-results"
            }
          ],
          "id": "971a2f92-b989-4161-847b-e1029b6bb942"
        },
        {
          "_comment": "A state with no listings for the name returns the site's 404 page, which extract reads as no results.",
          "actionType": "expectation",
          "expectations": [
            {
              "type": "element",
              "selector": "//*[@id='search-results-list'] | //h1[contains(text(), 'Page Not Found')]"
            }
          ],
          "id": "25f4a2bd-adf0-4e41-b4c2-c744479b78b3"
        },
        {
          "actionType": "extract",
          "selector": "#search-results-list .name-card",
          "noResultsSelector": "//h1[contains(text(), 'Page Not Found')]",
          "profile": {
            "name": {
              "selector": ".//h2/a[contains(@class, 'like-h2')]",
              "beforeText": ","
            },
            "age": {
              "selector": ".//h2/a[contains(@class, 'like-h2')]",
              "afterText": ","
            },
            "addressCityState": {
              "selector": ".//span[contains(@class, 'person-location')]"
            },
            "addressFull": {
              "selector": ".//div[contains(@class, 'section-title') and contains(@class, 'home-icon')]/following-sibling::div[contains(@class, 'section-flex')]//p"
            },
            "phoneList": {
              "selector": ".//div[contains(@class, 'section-title') and contains(@class, 'phone-icon')]/following-sibling::div[contains(@class, 'section-flex')]//p",
              "separator": ","
            },
            "email": {
              "selector": ".//div[contains(@class, 'section-title') and contains(@class, 'email-icon')]/following-sibling::div[contains(@class, 'section-flex')]//p"
            },
            "relativesList": {
              "selector": ".//div[contains(@class, 'section-title') and contains(@class, 'relative-icon')]/following-sibling::div[contains(@class, 'section-flex')]//a",
              "findElements": true
            },
            "profileUrl": {
              "selector": ".//h2/a[contains(@class, 'like-h2')]"
            }
          },
          "id": "b21fb757-d690-45f8-83b2-62dfdde4e725"
        }
      ]
    },
    {

            "underlyingErrorCode"
        ]
    },
    "web_extension_cpm_install_readiness": {
        "description": "CPM install readiness fix observation. Background-ready means a successful public WebKit callback after a slow load (or any error-6 retry), not a document ACK. Reload-started counts one accepted GET document reload after a known unfinished startup and missing dashboard response; response-received counts an unambiguously attributed dashboard response after that reload, not an initResp ACK. No URLs, tab IDs, field values or raw errors are sent.",
        "owners": ["mallexxx"],
        "triggers": ["feature_lifecycle"],
        "expires": "2027-01-15",
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "outcome",
                "type": "string",
                "enum": ["background_ready"],
                "description": "Observed stage; background readiness and reload acceptance do not imply response delivery."
            }
        ]
    },
    "web_extension_cpm_upgrade_readiness": {
        "description": "CPM upgrade readiness fix observation. Background-ready means a successful public WebKit callback after a slow load (or any error-6 retry), not a document ACK. Reload-started counts one accepted GET document reload after a known unfinished startup and missing dashboard response; response-received counts an unambiguously attributed dashboard response after that reload, not an initResp ACK. No URLs, tab IDs, field values or raw errors are sent.",
        "owners": ["mallexxx"],
        "triggers": ["feature_lifecycle"],
        "expires": "2027-01-15",
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "outcome",
                "type": "string",
                "enum": ["background_ready"],
                "description": "Observed stage; background readiness and reload acceptance do not imply response delivery."
            }
        ]
    },
    "web_extension_cpm_background_wake": {
        "description": "CPM background wake fix observation. Background-ready means a successful public WebKit callback after a slow load (or any error-6 retry), not a document ACK. Reload-started counts one accepted GET document reload after a known unfinished startup and missing dashboard response; response-received counts an unambiguously attributed dashboard response after that reload, not an initResp ACK. No URLs, tab IDs, field values or raw errors are sent.",
        "owners": ["mallexxx"],
        "triggers": ["feature_lifecycle"],
        "expires": "2027-01-15",
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "outcome",
                "type": "string",
                "enum": ["background_ready"],
                "description": "Observed stage; background readiness and reload acceptance do not imply response delivery."
            }
        ]
    },
    "web_extension_cpm_background_load_restart": {
        "description": "Observes a CPM context restart applied after error 6 with the same failed background view still retained. restart_started counts applying the fix; background_ready is only a successful background-load callback, not a page response. Exactly one terminal outcome is observed per attempt: response_received is an unambiguously attributed dashboard response from the replacement context; no_response_before_deadline means at least one post-restart navigation timed out and no qualifying response was observed within five active minutes, not proof of permanent breakage; unobserved means no timed-out navigation or attributable response was seen; superseded means another reload or embedded upgrade ended attribution; reload_failed means context replacement threw; reload_timed_out means replacement did not complete before the observation deadline. restart_limit_reached is reported once when another restart is blocked after three attempts without a confirmed page response from the current extension context; that response resets the budget even after the restart observation has expired or another reload has superseded it, while background readiness, suspension and context replacement alone do not. This blocked-attempt outcome is separate from the last applied restart's terminal observation. The in-memory budget also resets on process restart. Suspension time is excluded and resume grants at least 30 seconds. Process termination can lose unfinished observations: missing terminal rows are not failures. Count rows measure stages/outcomes; daily deduplication is by name, so daily usually contains restart_started and must not estimate outcome rates. No URLs, tab IDs, raw errors or document values are sent.",
        "owners": ["mallexxx"],
        "triggers": ["feature_lifecycle", "exception"],
        "expires": "2027-01-15",
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "outcome",
                "type": "string",
                "enum": [
                    "restart_started",
                    "background_ready",
                    "response_received",
                    "no_response_before_deadline",
                    "unobserved",
                    "superseded",
                    "reload_failed",
                    "reload_timed_out",
                    "restart_limit_reached"
                ],
                "description": "Applied/ready stages, a single terminal observation per applied restart, or a once-per-budget blocked-restart report. Use count rows for outcome rates; readiness is not page recovery and missing observations are not failures."
            }
        ]
    },
    "web_extension_cpm_background_load_retry": {
        "description": "CPM background load retry fix observation. Background-ready means a successful public WebKit callback after a slow load (or any error-6 retry), not a document ACK. Reload-started counts one accepted GET document reload after a known unfinished startup and missing dashboard response; response-received counts an unambiguously attributed dashboard response after that reload, not an initResp ACK. No URLs, tab IDs, field values or raw errors are sent.",
        "owners": ["mallexxx"],
        "triggers": ["feature_lifecycle"],
        "expires": "2027-01-15",
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "outcome",
                "type": "string",
                "enum": ["background_ready"],
                "description": "Observed stage; background readiness and reload acceptance do not imply response delivery."
            }
        ]
    },
    "web_extension_cpm_startup_response_missing": {
        "description": "A document committed during the first monitored background startup for its embedded extension context timed out waiting for a CPM dashboard response, despite that startup succeeding within 30 seconds. Recorded once per document, independently of the late-document recovery flag and GET/form reload eligibility. Ordinary idle wakes and failed background startups are excluded. This is a P4 candidate signature, not proof of a lost initResp or its root cause. Daily estimates affected installations per day; count measures detected documents. No URL, tab ID, field value or raw error is sent.",
        "owners": ["mallexxx"],
        "triggers": ["exception"],
        "expires": "2027-01-15",
        "suffixes": ["daily_count"],
        "parameters": ["appVersion", "pixelSource", "channel"]
    },
    "web_extension_cpm_late_document_reload": {
        "description": "CPM late document reload fix observation. Background-ready means a successful public WebKit callback after a slow load (or any error-6 retry), not a document ACK. Reload-started counts one accepted GET document reload after a known unfinished startup and missing dashboard response; response-received counts an unambiguously attributed dashboard response after that reload, not an initResp ACK. No URLs, tab IDs, field values or raw errors are sent.",
        "owners": ["mallexxx"],
        "triggers": ["feature_lifecycle"],
        "expires": "2027-01-15",
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "outcome",
                "type": "string",
                "enum": ["reload_started", "response_received"],
                "description": "Observed stage; background readiness and reload acceptance do not imply response delivery."
            }
        ]
    },
    "web_extension_cpm_episode": {
        "description": "One terminal CPM failure-episode report: a qualifying dashboard response or the five-minute observation deadline. Time while the app is suspended (iOS background, macOS sleep) does not count: waits and the deadline stop, pending waits restart in full on resume (8 s for a response wait, 30 s for an extension-load wait), and the deadline keeps at least 30 s after resume. First failure and later stuck/reload transitions emit nothing. Response attribution does not prove initResp delivery or recovery of every failed tab. No response by the deadline is not proof of permanent failure. Unfinished in-memory episodes may be lost on process termination. Includes allowlisted first-failure facts, background readiness/view age and conditional attributed error-6 timing/app state, and the existing bounded bg_events timeline, which may contain error descriptors; no tab/document identifiers, diagnostic counts or app/memory ages. Load facts are frozen at the first failure: pending can later fail, and errors observed later are not included. One logical report uses dailyAndCount: the first completed episode of the day sends the same summary in daily and count requests; subsequent episodes send count only. Daily estimates affected installations per day; count measures completed episodes.",
        "owners": ["mallexxx"],
        "triggers": ["feature_lifecycle", "exception"],
        "expires": "2027-01-15",
        "suffixes": ["daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            "channel",
            {
                "key": "reason",
                "type": "string",
                "enum": ["session_restoration", "tab_crash", "extension_reload", "other"],
                "description": "Navigation context of the first timeout in this episode."
            },
            {
                "key": "was_stuck",
                "type": "boolean",
                "description": "Whether, after the first failure, a regular (non-restoration) navigation also timed out in a different tab than the one that opened the episode. Repeated timeouts in the same tab do not set it, although they still trigger the recovery reload. False does not distinguish a transient or page-specific failure from a persistent one in a single-tab session; reload_state helps to tell them apart. True does not prove all tabs failed."
            },
            {
                "key": "tabs_affected",
                "type": "string",
                "enum": ["1", "2", "3+"],
                "description": "Distinct tabs that timed out during the episode, including concurrent and restoration timeouts. One does not prove other tabs healthy. No tab identifiers are sent."
            },
            {
                "key": "repeat_failures",
                "type": "string",
                "enum": ["0", "1", "2+"],
                "description": "Timeouts beyond the first in tabs that had already timed out during the episode. Repeats in one tab confirm the hang and start the recovery reload without making was_stuck true."
            },
            {
                "key": "interrupted",
                "type": "boolean",
                "description": "Whether the measurement that opened the episode waited across an app suspension (iOS background, macOS sleep), so its wait was restarted on resume."
            },
            {
                "key": "outcome",
                "type": "string",
                "enum": [
                    "failed_measurement_response",
                    "failed_tab_response",
                    "other_tab_response",
                    "unattributed_response",
                    "no_response_before_deadline"
                ],
                "description": "Dashboard response on the timed-out measurement, a later measurement on a failed tab, another tab, an ambiguous current-document match, or no qualifying response by the deadline. No document-level ACK is implied."
            },
            {
                "key": "reload_state",
                "type": "string",
                "enum": ["none", "pending", "failed", "loaded", "response_timed_out"],
                "description": "Latest embedded-extension reload evidence during the episode: no reload observed, replacement in progress, context replacement failed, replacement loaded, or its first eligible CPM measurement timed out. Loaded alone does not mean messaging recovered."
            },
            {
                "key": "response_after",
                "type": "string",
                "enum": ["under_30s", "30s_to_1m", "1m_to_deadline"],
                "description": "Elapsed time from first failure to qualifying dashboard response: under 30 seconds, 30 to under 60 seconds, or at least 60 seconds before the deadline. Measured on the monitor's own time, which excludes time the app was suspended. Omitted when no response was observed."
            },
            "extension_context_loaded",
            "background_view_alive",
            "background_web_process_alive",
            "background_web_process_responsive",
            "tab_known_to_webkit",
            "native_handler_registered",
            "tab_controller_matches_context",
            "tab_has_extension_user_scripts",
            "background_events",
            "background_ready_after",
            "background_view_age",
            "background_load_error_after",
            "background_load_error_app_state"
        ]
    }
}

// Privacy Pro subscription-related pixel definitions for macOS
{
    'm_mac_direct_privacy-pro_keychainmanager_data_added_to_backlog': {
        description: 'Fired when Privacy Pro keychain manager adds data to the backlog because keychain is unavailable (direct distribution)',
        owners: ['fcappelli'],
        triggers: ['other'],
        suffixes: ['form_factor', 'first_daily_count'],
        parameters: [
            'appVersion',
            'pixelSource',
            {
                key: 'source',
                description: 'The source component that triggered the keychain operation',
                type: 'string',
            },
        ],
    },
    'm_mac_store_privacy-pro_keychainmanager_data_added_to_backlog': {

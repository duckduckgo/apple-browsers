    // Entries below come from the shared base `event-hub` feature config rather than the Apple override.
    "eventHub_baseline_day_macos": {
        "description": "Daily bucketed count of periods in which EventHub ran at all. Serves as the denominator for the other eventHub telemetry — it counts nothing beyond the period itself. Fired by the eventHub feature at the end of each 1-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "parameters": ["appVersion", "channel", "eventHubBaseline", "eventHubAttributionPeriod"]
    },
    "eventHub_baseline_week_macos": {
        "description": "Weekly bucketed count of periods in which EventHub ran at all. Serves as the denominator for the other eventHub telemetry — it counts nothing beyond the period itself. Fired by the eventHub feature at the end of each 7-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "parameters": ["appVersion", "channel", "eventHubBaseline", "eventHubAttributionPeriod"]
    },

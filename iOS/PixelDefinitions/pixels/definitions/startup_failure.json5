{
    "startup_failure": {
        "description": "A known startup failure prevents the app from becoming usable. Sent once per failure episode; further failures are suppressed until a successful startup.",
        "owners": ["diegoreymendez"],
        "triggers": ["exception"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "originalPixelTimestamp",
                "type": "string",
                "description": "ISO 8601 timestamp of the original failed send. Present only when PixelKit replays a persisted pixel.",
                "examples": ["2026-10-31T13:00:00Z"]
            },
            {
                "key": "retriedPixel",
                "type": "string",
                "description": "Marks a replay from PixelKit's persistent retry queue. Absent on the original send.",
                "enum": ["1"]
            }
        ]
    },
    "startup_failure_returned": {
        "description": "The app reaches the foreground for the first time after a recorded startup failure. Recovery is recorded separately when the browser becomes usable.",
        "owners": ["diegoreymendez"],
        "triggers": ["startup"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "days_since_first_failure",
                "type": "string",
                "description": "Whole elapsed 24-hour periods since the episode's first failure. 7+ caps all later returns; unknown covers a clock moving backwards. The bucket contains no exact failure time.",
                "enum": ["0", "1", "2", "3", "4", "5", "6", "7+", "unknown"]
            },
            {
                "key": "originalPixelTimestamp",
                "type": "string",
                "description": "ISO 8601 timestamp of the original failed send. Present only when PixelKit replays a persisted pixel.",
                "examples": ["2026-10-31T13:00:00Z"]
            },
            {
                "key": "retriedPixel",
                "type": "string",
                "description": "Marks a replay from PixelKit's persistent retry queue. Absent on the original send.",
                "enum": ["1"]
            }
        ]
    },
    "startup_failure_recovered": {
        "description": "The app becomes ready for user interaction after a recorded startup failure. Sent once, closing the episode and allowing a subsequent failure to start a new one.",
        "owners": ["diegoreymendez"],
        "triggers": ["startup"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "days_count",
                "type": "string",
                "description": "Bucket for whole days from the first startup failure to recovery. Each bucket starts at the listed day and ends before the next bucket. 21+ covers 21 days or more. Omitted if elapsed time cannot be calculated.",
                "enum": ["0", "1+", "3+", "5+", "8+", "13+", "21+"]
            },
            {
                "key": "originalPixelTimestamp",
                "type": "string",
                "description": "ISO 8601 timestamp of the original failed send. Present only when PixelKit replays a persisted pixel.",
                "examples": ["2026-10-31T13:00:00Z"]
            },
            {
                "key": "retriedPixel",
                "type": "string",
                "description": "Marks a replay from PixelKit's persistent retry queue. Absent on the original send.",
                "enum": ["1"]
            }
        ]
    }
}

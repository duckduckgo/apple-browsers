// Duck.ai entry-point attribution: one pixel with a source param covering every path into Duck.ai.
{
    "m_aichat_entry_point": {
        "description": "Fires when the user enters Duck.ai, with the entry path as a source param. Threaded through openAIChat(source:) with no default so the compiler enumerates every call site; the per-surface legacy pixels remain as a rollout cross-check.",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor", "first_daily_count"],
        "parameters": [
            "appVersion",
            {
                "key": "source",
                "description": "The entry path into Duck.ai. direct_url: a duck.ai address loaded directly, e.g. typed. deep_link_other: a duck.ai link from another app. app_open: the app opens onto a Duck.ai tab. tab_swipe: swiping onto a Duck.ai tab. voice: older versions only; voice entries now set voice=true.",
                "type": "string",
                "enum": [
                    "address_bar_prompt",
                    "address_bar_icon",
                    "address_bar_shortcut_chip",
                    "address_bar_editing_state",
                    "suggestion_ask_ai",
                    "ipad_toggle_prompt",
                    "browsing_menu_ntp",
                    "browsing_menu_webpage",
                    "browsing_menu_duckai",
                    "duck_ai_new_chat",
                    "tab_switcher",
                    "tabs_bar_button",
                    "new_tab_long_press_menu",
                    "chat_history_new_chat",
                    "chat_history_open_chat",
                    "chat_history_view_all",
                    "voice",
                    "onboarding",
                    "subscription_onboarding",
                    "paid_settings",
                    "direct_url",
                    "serp",
                    "icon_shortcut",
                    "contextual_chat",
                    "widget_quick_actions",
                    "widget_quick_actions_medium",
                    "widget_favorite",
                    "widget_lock_screen",
                    "widget_control_center",
                    "address_bar_custom_button",
                    "toolbar_custom_button",
                    "onboarding_completion_promo",
                    "app_open",
                    "tab_swipe",
                    "siri",
                    "deep_link_other",
                    "return_to_chat_card",
                    "tab_switcher_existing_chat",
                    "ddg_homepage",
                    "tabs_bar_existing_chat"
                ]
            },
            {
                "key": "duckai_enabled",
                "description": "Whether Duck.ai is enabled under AI Features settings: true or false",
                "type": "boolean"
            },
            {
                "key": "toggle_enabled",
                "description": "Whether the Search/Duck.ai toggle user setting is enabled: true or false",
                "type": "boolean"
            },
            {
                "key": "opens_new_tab",
                "description": "Whether this entry opened Duck.ai in a new tab (vs in place or as a sheet): true or false",
                "type": "boolean"
            },
            {
                "key": "has_prompt",
                "description": "Whether the entry carried a prompt: true or false",
                "type": "boolean"
            },
            {
                "key": "voice",
                "description": "Whether the user started by speaking: a voice chat, or voice search sent to Duck.ai. Absent before it existed.",
                "type": "boolean"
            }
        ]
    },
    "m_aichat_duck_ai_direct_navigation": {
        "description": "Fires when the user loads a duck.ai address without using a Duck.ai entry point (via says how), for all users rather than only those who turned Duck.ai off. duckai_enabled=false isolates residual demand among users who disabled it, which is the population the superseded m_aichat_unified_input_duck_ai_direct_navigation reports on; that pixel keeps firing unchanged so its series stays comparable. Does not fire for the in-input Duck.ai shortcut button, other Duck.ai entry points or Duck.ai deep links. Before via existed, only a typed address fired it.",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "duckai_enabled",
                "description": "Whether Duck.ai is enabled under AI Features settings: true or false",
                "type": "boolean"
            },
            {
                "key": "toggle_enabled",
                "description": "Whether the Search/Duck.ai toggle user setting is enabled: true or false",
                "type": "boolean"
            },
            {
                "key": "via",
                "description": "How the user reached the address: typed into the address bar, picked from suggestion, bookmark, favorite or history, external when another app opened the link, link when the user followed a link on a page, or drop for a drag and drop.",
                "type": "string",
                "enum": ["typed", "suggestion", "bookmark", "favorite", "history", "external", "link", "drop"]
            }
        ]
    }
}

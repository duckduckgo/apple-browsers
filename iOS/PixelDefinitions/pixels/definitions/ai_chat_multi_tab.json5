{
    "aichat_unified_input_tab_picker_shown": {
        "description": "Fires when the \"add tabs to DuckAI chat\" menu is shown",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": ["appVersion", "unified_input_surface", "unified_input_page_type", "aichat_tab_picker_source"]
    },
    "aichat_unified_input_tab_picker_canceled": {
        "description": "Fires when the \"add tabs to DuckAI chat\" menu is closed without a selection.",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": ["appVersion", "unified_input_surface", "unified_input_page_type", "aichat_tab_picker_source"]
    },
    "aichat_unified_input_tab_attached": {
        "description": "Fires when a tab is added to the draft through recent tabs, Add tabs picker, or a mention. On the address bar, this can be the current tab; in contextual chat, the current page uses separate page-context pixels. Excludes duplicate choices, failed choices, and restored drafts. Attachment does not imply successful content extraction.",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": ["appVersion", "unified_input_surface", "unified_input_page_type", "aichat_tab_attachment_source"]
    },
    "aichat_unified_input_tab_removed": {
        "description": "Fires when the user removes a tab via its chip, recent tabs, or Add tabs picker.",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": ["appVersion", "unified_input_surface", "unified_input_page_type", "aichat_tab_attachment_source"]
    },
    "aichat_unified_input_tabs_sent": {
        "description": "Fires on chat submission if it contains page context.",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            "unified_input_surface",
            "unified_input_page_type",
            {
                "key": "payload_tab_count",
                "description": "Number of tab contexts in the dispatched payload: one is 1, some is 2–3, many is 4 or more.",
                "type": "string",
                "enum": ["one", "some", "many"]
            }
        ]
    },
    "aichat_contextual_tab_attachment_collection_wait_timeout": {
        "description": "Fires once per failed additional-tab collection attempt when its timeout budget expires before extraction can start because the page handler is busy. Reason describes blockers at the last wait. Also includes budget exhaustion immediately after that wait finishes. Excludes page-loading, document-reading and extraction timeouts, and cancellation.",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "reason",
                "description": "Pending source-page collection, another cross-tab collection, or both blocking the last wait.",
                "type": "string",
                "enum": ["source_collection", "cross_tab_collection", "both", "timed_out"]
            }
        ]
    },
    "aichat_unified_input_tabs_submission_incomplete": {
        "description": "Fires when chat submission is missing at least one tab that was captured in the submission request",
        "owners": ["pikorddg"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            "unified_input_surface",
            "unified_input_page_type",
            {
                "key": "outcome",
                "description": "Whether some (partial) or all requested tab attachment contexts are missing. Contextual current page context does not affect this classification.",
                "type": "string",
                "enum": ["partial", "all"]
            }
        ]
    }
}

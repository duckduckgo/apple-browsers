// See https://app.asana.com/0/72649045549333/1208001118995887/f.
{
    "m_mac_vpn_access_revoked": {
        "description": "The VPN has learnt access to PPro has been revoked for the account",
        "owners": ["diegoreymendez"],
        "triggers": ["other"],
        "suffixes": ["legacy_daily_count"],
        "parameters": [
            {
                "key": "e",
                "type": "number",
                "description": "Error code"
            },
            {
                "key": "d",
                "type": "string",
                "description": "String constant representing an Apple-defined error domain (e.g., WebKitErrorDomain, NSURLErrorDomain) or VPN-specific error domain. Not free-form strings, but too large and frequently changing a set to enumerate",
                "examples": ["WebKitErrorDomain", "NSURLErrorDomain", "SKErrorDomain"]
            },
            {
                "keyPattern": "^ue[0-9]$",
                "type": "number",
                "description": "Underlying error code"
            },
            {
                "keyPattern": "^ud[0-9]$",
                "type": "string",
                "description": "String constant representing an Apple-defined underlying error domain (e.g., WebKitErrorDomain, NSURLErrorDomain) or VPN-specific underlying error domain. Not free-form strings, but too large and frequently changing a set to enumerate",
                "examples": ["WebKitErrorDomain", "NSURLErrorDomain", "SKErrorDomain"]
            },
            "appVersion",
            "pixelSource"
        ]
    },
    "m_mac_vpn_access_unmanaged_error": {
        "description": "The subscription library has communicated to the VPN there has been a recoverable error when trying to retrieve the token.",
        "owners": ["diegoreymendez"],
        "triggers": ["other"],
        "suffixes": ["legacy_daily_count"],
        "parameters": [
            "appVersion",
            "pixelSource",
            {
                "key": "d",
                "type": "string",
                "description": "String constant representing an Apple-defined error domain (e.g., WebKitErrorDomain, NSURLErrorDomain) or VPN-specific error domain. Not free-form strings, but too large and frequently changing a set to enumerate",
                "examples": ["WebKitErrorDomain", "NSURLErrorDomain", "SKErrorDomain"]
            },
            {
                "key": "e",
                "type": "number",
                "description": "Error code"
            },
            {
                "keyPattern": "^ud[0-9]$",
                "type": "string",
                "description": "String constant representing an Apple-defined underlying error domain (e.g., WebKitErrorDomain, NSURLErrorDomain) or VPN-specific underlying error domain. Not free-form strings, but too large and frequently changing a set to enumerate",
                "examples": ["WebKitErrorDomain", "NSURLErrorDomain", "SKErrorDomain"]
            },
            {
                "keyPattern": "^ue[0-9]$",
                "type": "integer",
                "description": "Underlying error code"
            }
        ]
    }
}

{
    "content-blocking_rules-compilation-timeout": {
        "description": "Fires when a main-frame navigation has waited 10 seconds in the foreground for the content blocking assets that rules compilation produces. Measures how often a compilation stall could block page loads indefinitely. With site permissions enabled, this includes SERP and content-blocking-off loads, which wait for the geolocation script shipped in the same assets. Background time does not count: the 10 seconds restart when the app returns to the foreground. At most once per navigation; not sent for subframes or for navigations stopped, replaced, closed or cleared before the 10 seconds pass. The navigation keeps waiting, or shows the timeout error page when site permissions is enabled.",
        "owners": ["bkunat"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": ["appVersion"]
    },
    "navigation_setup_wait": {
        "description": "Reports once per process how long the first foreground main-frame HTTP(S) navigation waited for setup before it could proceed, and how much of that each setup stage added. Replaces the m_compilation_result_* pixels, which measured only the content-blocking rules wait and, once navigation also waited for web extensions, no longer covered the whole delay. The Web Extension gate and the content-blocking gate are waited at in sequence, so wait_time covers both; rules and extensions prepare in parallel, so preparation time is not summed. Each time is bucketed independently to the first inclusive upper bound, so the stage buckets need not add up to the wait_time bucket. A navigation with no asynchronous wait reports 0. Subframes and non-HTTP(S) navigations do not consume the sample. Compare app versions separately across the change from m_compilation_result_*. No URLs or extension identifiers are sent.",
        "owners": ["mallexxx"],
        "triggers": ["feature_lifecycle", "user_interaction", "exception"],
        "suffixes": ["platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "outcome",
                "type": "string",
                "enum": ["success", "cancelled", "timeout", "tab_closed", "app_quit", "app_backgrounded"],
                "description": "success: the setup gates released navigation, including a bounded extension-gate deadline, which does not prove extension readiness, CPM delivery or page load. cancelled: the navigation was stopped, replaced or intercepted by policy before release. timeout: the content-blocking readiness deadline expired before assets were ready; reported before the error page cancels navigation. tab_closed, app_quit: the tab or app closed first. app_backgrounded: the app entered the background first; the wait ends there so suspended time is never counted."
            },
            {
                "key": "state",
                "type": "string",
                "enum": ["onboarding", "regular"],
                "description": "Whether onboarding had not been seen when the process-wide monitor was created."
            },
            {
                "key": "wait_time",
                "type": "string",
                "enum": ["0", "0.1", "0.5", "1", "5", "10", "20", "40", "more"],
                "description": "Seconds from the start of the navigation's setup wait to release, interruption or cancellation, including both gates. Bucketed."
            },
            {
                "key": "web_extensions_wait_time",
                "type": "string",
                "enum": ["0", "0.1", "0.5", "1", "5", "10", "20", "40", "more"],
                "description": "Seconds spent waiting at the Web Extension startup gate, including its bounded deadline. 0 when the navigation did not wait there. Bucketed."
            },
            {
                "key": "content_blocking_wait_time",
                "type": "string",
                "enum": ["0", "0.1", "0.5", "1", "5", "10", "20", "40", "more"],
                "description": "Seconds spent waiting for installed content-blocking assets, including geolocation when required and accumulated across readiness retries. 0 when the navigation did not wait there. Bucketed."
            }
        ]
    }
}

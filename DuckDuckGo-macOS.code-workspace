{
    // macOS browser in VSCode/Cursor: File > Open Workspace from File… and pick this file.
    // Requires Xcode 27 (`xcode-select -p`) and the Swift extension. The browser package is macOS/DuckDuckGo;
    // personal tasks, launch configurations and settings go in .vscode/, which isn't committed.
    "folders": [
        { "path": "." }
    ],
    "settings": {
        // The Xcode toolchain (`xcode-select`), also when swiftly is installed: the extension recognizes the
        // xcrun shim in /usr/bin and finds swift, sourcekit-lsp and lldb-dap through xcrun.
        "swift.path": "/usr/bin",
        // Relative to the package folder: build output lives in macOS/.build, outside the package folder.
        "swift.buildPath": "../.build/DuckDuckGo",
        // Asset catalogs and Core Data models in this package are only processed by the swiftbuild backend.
        "swift.buildArguments": ["--build-system", "swiftbuild"],
        // Only load the browser package (macOS/DuckDuckGo), not the packages it depends on.
        // The entries are folder names, matched at every level of the search.
        "swift.searchSubfoldersForPackages": true,
        "swift.ignoreSearchingForPackagesInSubfolders": [".", ".build", "node_modules", "DerivedData", "SourcePackages", "iOS", "SharedPackages", "LocalPackages"],
        "files.exclude": {
            "**/.build": true
        }
    },
    "extensions": {
        "recommendations": ["swiftlang.swift-vscode"]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Build browser library",
                "detail": "swift build --build-system swiftbuild --scratch-path ../.build/DuckDuckGo --product DuckDuckGoBrowserDynamic",
                "type": "shell",
                "command": "xcrun",
                "args": ["swift", "build", "--build-system", "swiftbuild", "--scratch-path", "../.build/DuckDuckGo", "--product", "DuckDuckGoBrowserDynamic"],
                "options": { "cwd": "${workspaceFolder}/macOS/DuckDuckGo" },
                "group": "build",
                "problemMatcher": "$swiftc"
            },
            {
                "label": "Build host app",
                "detail": "App bundle with the launcher executable; rebuilt only when its inputs change",
                "type": "shell",
                "command": "${workspaceFolder}/macOS/scripts/vscode/make-host-app.sh",
                "options": { "cwd": "${workspaceFolder}/macOS/DuckDuckGo" },
                "group": "build",
                "problemMatcher": []
            },
            {
                "label": "Sign browser library",
                "detail": "Signs the swift build output with the host app's identity (library validation)",
                "type": "shell",
                "command": "${workspaceFolder}/macOS/scripts/vscode/sign-dylib.sh",
                "options": { "cwd": "${workspaceFolder}/macOS/DuckDuckGo" },
                "problemMatcher": []
            },
            {
                "label": "Build DuckDuckGo",
                "dependsOrder": "sequence",
                "dependsOn": ["Build host app", "Build browser library", "Sign browser library"],
                "group": { "kind": "build", "isDefault": true },
                "problemMatcher": []
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "DuckDuckGo",
                "type": "swift",
                "request": "launch",
                "program": "${workspaceFolder}/macOS/.build/vscode-host/DuckDuckGo.app/Contents/MacOS/DuckDuckGo",
                "cwd": "${workspaceFolder}/macOS/DuckDuckGo",
                "preLaunchTask": "Build DuckDuckGo"
            }
        ]
    }
}

          "elements": [
            {
              "type": "profileUrl",
              "selector": "input[name=\"url\"]"
            }
          ]
        },
        {
          "actionType": "getCaptchaInfo",
          "id": "442e6845-03f7-41d9-8a83-33b0133b882d",

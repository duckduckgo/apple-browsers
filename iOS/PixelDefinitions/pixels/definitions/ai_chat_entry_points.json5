// Duck.ai entry-point attribution: one pixel with a source param covering every path into Duck.ai.
{
    "m_aichat_entry_point": {
        "description": "Fires when the user enters Duck.ai, with the entry path as a source param. Threaded through openAIChat(source:) with no default so the compiler enumerates every call site; the per-surface legacy pixels remain as a rollout cross-check.",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["platform", "form_factor", "first_daily_count"],
        "parameters": [
            "appVersion",
            {
                "key": "source",
                "description": "The entry path into Duck.ai, one value per case of the AIChatEntryPointSource Swift enum. serp is any Duck.ai open the search results page asks native for, e.g. Search Assist, and covers every such SERP affordance because the request does not say which one it was. direct_url is a duck.ai address the user loaded without a Duck.ai entry point: typed, picked from suggestions, bookmarks, favorites or history, dropped, or a link the user followed from a page other than the search results (m_aichat_duck_ai_direct_navigation's via says which); a followed link from the search results page reports serp, and a duck.ai link another app opens reports deep_link_other. ddg_homepage is a navigation into Duck.ai that the duckduckgo.com homepage started itself, whether by link, form, script or by asking native to open Duck.ai; other page-started navigations that are not a followed link are not attributed. Returning to an already-open Duck.ai tab fires from the tab switcher (tab_switcher_existing_chat, distinct from the switcher's Duck.ai button, which creates a new chat and reports tab_switcher), from the iPad tabs bar or a tab-selection keyboard shortcut (tabs_bar_existing_chat) and from the new tab page's return-to-tab card (return_to_chat_card); the Ask about page sheet reports contextual_chat when it opens Duck.ai in a tab, and chat_history_open_chat when the tab opens one of its recent chats; restoring a Duck.ai tab at launch is not an entry and does not fire. browsing_menu_ntp, browsing_menu_duckai and browsing_menu_webpage name the page the browsing menu was opened over: the new tab page, a Duck.ai page, or any other page; before browsing_menu_duckai existed, Duck.ai pages reported browsing_menu_webpage. duck_ai_new_chat is New Chat, New Image or New Voice Chat in a Duck.ai tab's + menu; before New Image reported it, New Image sent no entry. chat_history_view_all is All chats in the iPad address bar's Duck.ai menu, and View all in the Ask about page sheet wherever it opens the duck.ai chat list. paid_settings is Settings → Subscription → Duck.ai or Duck.ai from the subscription welcome page, and subscription_onboarding is the subscription onboarding's Duck.ai step; before they existed, these reported deep_link_other and onboarding. Both open the chat in a new tab whose prompts keep the source of the Duck.ai tab it was opened from, so neither appears as a prompt origin. new_tab_long_press_menu is New Chat in the long-press menu of a new-tab button (toolbar tab switcher button, iPad tabs bar or tab switcher plus button); it opens a new tab, and that tab's prompts report it as their origin. voice is no longer sent: a voice chat or a spoken prompt reports where the user started, with voice=true; older versions sent voice for in-app voice chats and voice search sent to Duck.ai. onboarding_completion_promo is a prompt sent from the address bar that the Try Duck.ai button at the end of onboarding opened; before it existed, that prompt reported address_bar_prompt (iPad: ipad_toggle_prompt).",
                "type": "string",
                "enum": [
                    "address_bar_prompt",
                    "address_bar_icon",
                    "address_bar_shortcut_chip",
                    "address_bar_editing_state",
                    "suggestion_ask_ai",
                    "ipad_toggle_prompt",
                    "browsing_menu_ntp",
                    "browsing_menu_webpage",
                    "browsing_menu_duckai",
                    "duck_ai_new_chat",
                    "tab_switcher",
                    "tabs_bar_button",
                    "new_tab_long_press_menu",
                    "chat_history_new_chat",
                    "chat_history_open_chat",
                    "chat_history_view_all",
                    "voice",
                    "onboarding",
                    "subscription_onboarding",
                    "paid_settings",
                    "direct_url",
                    "serp",
                    "icon_shortcut",
                    "contextual_chat",
                    "widget_quick_actions",
                    "widget_quick_actions_medium",
                    "widget_favorite",
                    "widget_lock_screen",
                    "widget_control_center",
                    "address_bar_custom_button",
                    "toolbar_custom_button",
                    "onboarding_completion_promo",
                    "siri",
                    "deep_link_other",
                    "return_to_chat_card",
                    "tab_switcher_existing_chat",
                    "ddg_homepage",
                    "tabs_bar_existing_chat"
                ]
            },
            {
                "key": "duckai_enabled",
                "description": "Whether Duck.ai is enabled under AI Features settings: true or false",
                "type": "boolean"
            },
            {
                "key": "toggle_enabled",
                "description": "Whether the Search/Duck.ai toggle user setting is enabled: true or false",
                "type": "boolean"
            },
            {
                "key": "opens_new_tab",
                "description": "Whether this entry opened Duck.ai in a new tab (vs in place or as a sheet): true or false",
                "type": "boolean"
            },
            {
                "key": "has_prompt",
                "description": "Whether the entry carried a prompt: true or false",
                "type": "boolean"
            },
            {
                "key": "voice",
                "description": "Whether the user started by speaking: a voice chat, or voice search sent to Duck.ai. Absent before it existed.",
                "type": "boolean"
            }
        ]
    },
    "m_aichat_duck_ai_direct_navigation": {
        "description": "Fires when the user loads a duck.ai address without using a Duck.ai entry point (via says how), for all users rather than only those who turned Duck.ai off. duckai_enabled=false isolates residual demand among users who disabled it, which is the population the superseded m_aichat_unified_input_duck_ai_direct_navigation reports on; that pixel keeps firing unchanged so its series stays comparable. Does not fire for the in-input Duck.ai shortcut button, other Duck.ai entry points or Duck.ai deep links. Before via existed, only a typed address fired it.",
        "owners": ["Bunn"],
        "triggers": ["other"],
        "suffixes": ["daily_count", "platform", "form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "duckai_enabled",
                "description": "Whether Duck.ai is enabled under AI Features settings: true or false",
                "type": "boolean"
            },
            {
                "key": "toggle_enabled",
                "description": "Whether the Search/Duck.ai toggle user setting is enabled: true or false",
                "type": "boolean"
            },
            {
                "key": "via",
                "description": "How the user reached the address: typed into the address bar, picked from suggestion, bookmark, favorite or history, external when another app opened the link, link when the user followed a link on a page, or drop for a drag and drop.",
                "type": "string",
                "enum": ["typed", "suggestion", "bookmark", "favorite", "history", "external", "link", "drop"]
            }
        ]
    }
}

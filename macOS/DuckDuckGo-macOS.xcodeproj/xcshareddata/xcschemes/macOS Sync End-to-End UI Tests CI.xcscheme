            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Script"
               scriptText = "&quot;${PROJECT_DIR}/UITests/Helpers/ui-tests/post-run.sh&quot;&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "565E46DC2B2725DC0013AC2A"
                     BuildableName = "SyncE2EUITests.xctest"
                     BlueprintName = "SyncE2EUITests"

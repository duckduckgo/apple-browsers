// Passkey request cancellation pixels (see WebKitPasskeyRequestCanceller.swift)
{
    "passkey_request_cancellation_install_failed_macos": {
        "description": "At launch, the WebKit passkey request canceller couldn't install because WebKit's private passkey delegate class is missing, so pending passkey requests aren't cancelled.",
